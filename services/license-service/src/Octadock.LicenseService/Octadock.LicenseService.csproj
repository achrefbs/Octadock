<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Octadock License Service — the commercial backend (WS3/WS4). A completed
    Stripe Checkout produces exactly one entitlement, reliably and visibly:
    the /webhooks/stripe endpoint verifies the Stripe-Signature BEFORE any side
    effect, dedupes by event id (replay-safe), issues one license per verified
    paid event, and revokes on refund/dispute. Runs on Linux/Windows; NOT part
    of Octadock.sln.
  -->

  <PropertyGroup>
    <RootNamespace>Octadock.LicenseService</RootNamespace>
    <AssemblyName>Octadock.LicenseService</AssemblyName>
    <UserSecretsId>octadock-license-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- Pure-managed Ed25519 for the entitlement envelope signer/verifier (WS4).
         No native asset, so it builds/tests identically on Windows and Linux. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Octadock.LicenseService.Tests" />
  </ItemGroup>

</Project>
