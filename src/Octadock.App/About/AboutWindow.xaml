<Window x:Class="Octadock.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Octadock"
        Width="440"
        Height="360"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Width="48" Height="48"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Title}" Text="Octadock" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Octadock.Text.Muted}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource Octadock.Text.Body}"
                       Text="A Windows screenshot and recording utility centered on a Capture Shelf. Capture, keep it visible, annotate, pin, and recover recent captures — all locally." />
            <TextBlock Style="{StaticResource Octadock.Text.Muted}" Margin="0,14,0,0"
                       Text="Octadock is an original work. It is not affiliated with, endorsed by, or derived from any other product. All visual identity, iconography, and file formats are its own." />
            <TextBlock Style="{StaticResource Octadock.Text.Muted}" Margin="0,14,0,0"
                       Text="Local dictation uses the NVIDIA Parakeet TDT 0.6B v3 model (CC-BY-4.0, © NVIDIA Corporation) running on sherpa-onnx, and optionally OpenAI Whisper models via Whisper.net." />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="CopyrightText" Style="{StaticResource Octadock.Text.Muted}" />
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="100"
                    Margin="0,12,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{StaticResource Octadock.Style.ToolButton}"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
