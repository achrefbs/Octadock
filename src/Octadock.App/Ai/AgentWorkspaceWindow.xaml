<Window x:Class="Octadock.App.Ai.AgentWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Octadock · Local export" Width="860" Height="680" MinWidth="480" MinHeight="360"
 Background="{DynamicResource Octadock.Brush.Canvas}" Foreground="{DynamicResource Octadock.Brush.Text}"
 FontFamily="{DynamicResource Octadock.Font}" UseLayoutRounding="True"
 AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="Local export" Style="{StaticResource Octadock.Text.Title}"/>
   <TextBlock Text="Collect captures, notes and files. Review the packet, then save it on this PC." Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource Octadock.Text.Caption}"/>
  </StackPanel>
  <TabControl Grid.Row="1" Background="Transparent" Foreground="{DynamicResource Octadock.Brush.Text}" BorderThickness="0">
   <TabItem Style="{StaticResource Octadock.Style.SettingsTabItem}" Header="Compose" Padding="14,7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,12,12,8">
      <TextBlock Text="Attachments" Margin="0,20,0,8" Style="{StaticResource Octadock.Text.Subtitle}"/>
      <WrapPanel>
       <Button x:Name="AddFilesButton" Content="Add files…" Command="{Binding AddFilesCommand}" Margin="0,0,6,6" Style="{StaticResource Octadock.Style.ToolButton}"/>
       <Button Content="Use clipboard" Command="{Binding AddClipboardCommand}" Margin="0,0,6,6" Style="{StaticResource Octadock.Style.ToolButton}"/>
       <Button Content="Compare images…" Command="{Binding CompareImagesCommand}" Margin="0,0,6,6" Style="{StaticResource Octadock.Style.ToolButton}"/>
      </WrapPanel>
      <Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding RecentCaptures}" SelectedItem="{Binding SelectedRecentCapture}" DisplayMemberPath="Label" AutomationProperties.Name="Recent capture"/>
       <Button Grid.Column="1" Content="Add capture" Margin="8,0,0,0" Command="{Binding AddRecentCaptureCommand}" Style="{StaticResource Octadock.Style.ToolButton}"/>
      </Grid>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding ContextPackages}" SelectedItem="{Binding SelectedContext}" DisplayMemberPath="Label" AutomationProperties.Name="Context package"/>
       <Button Grid.Column="1" Content="Add Context" Margin="8,0,0,0" Command="{Binding AddContextCommand}" Style="{StaticResource Octadock.Style.ToolButton}"/>
      </Grid>
      <ListBox ItemsSource="{Binding Evidence}" SelectedItem="{Binding SelectedEvidence}" MinHeight="64" MaxHeight="190"
       BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}" Background="{DynamicResource Octadock.Brush.SurfaceRaised}" Foreground="{DynamicResource Octadock.Brush.Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Packet attachments">
       <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding Label}" Foreground="{DynamicResource Octadock.Brush.Text}" Margin="4"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,6,0,0">
       <Button Content="Extract text" Command="{Binding RunOcrCommand}" Style="{StaticResource Octadock.Style.ToolButton}" Margin="0,0,6,0"/>
       <Button Content="Remove selected" Command="{Binding RemoveSelectedEvidenceCommand}" Style="{StaticResource Octadock.Style.ToolButton}"/>
      </WrapPanel>
      <TextBlock Text="What is this packet for?" Style="{StaticResource Octadock.Text.Subtitle}"/>
      <ItemsControl ItemsSource="{Binding Workflows}" Margin="0,8,0,8">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding Title}" Margin="0,0,6,6" Padding="12,7" Style="{StaticResource Octadock.Style.ToolButton}"
         Command="{Binding DataContext.ChooseWorkflowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding WorkflowHeading}" Foreground="{DynamicResource Octadock.Brush.Accent}" Margin="0,0,0,6"/>
      <TextBox x:Name="GoalBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
       Text="{Binding AdditionalIntent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Notes and instructions"/>
      <CheckBox Content="Redact common text secrets" IsChecked="{Binding RedactSecrets}" Margin="0,18,0,8" Foreground="{DynamicResource Octadock.Brush.Text}"/>
      <TextBlock Text="{Binding PrivacyLabel}" TextWrapping="Wrap" Style="{StaticResource Octadock.Text.Caption}"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Style="{StaticResource Octadock.Style.SettingsTabItem}" Header="Preview packet" Padding="14,7">
    <TextBox Margin="0,12,0,0" Text="{Binding PacketPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Exact local packet preview"/>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource Octadock.Text.Caption}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource Octadock.Brush.Danger}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
   <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
    <Button Content="Copy packet" Command="{Binding CopyPacketCommand}" Click="OnCommitDraftInput" Style="{StaticResource Octadock.Style.ToolButton}" Margin="0,0,6,6"/>
    <Button Content="Open folder" Command="{Binding OpenExportCommand}" Style="{StaticResource Octadock.Style.ToolButton}" Margin="0,0,6,6" Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}"/>
    <Button Content="Save bundle…" Command="{Binding ExportPacketCommand}" Click="OnCommitDraftInput" Style="{StaticResource Octadock.Style.AccentButton}" Margin="0,0,0,6"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
