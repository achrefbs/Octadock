<Window x:Class="Octadock.App.Ai.AgentWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="{Binding ReviewWindowTitle}"
        Width="980"
        Height="640"
        MinWidth="780"
        MinHeight="500"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        Foreground="{DynamicResource Octadock.Brush.Text}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="WorkspaceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="CompactLabel" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Caption}">
            <Setter Property="Margin" Value="1,0,0,5" />
        </Style>

        <Style x:Key="WorkspaceTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceExpanderHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Chevron"
                                      Width="9"
                                      Height="6"
                                      Margin="1,0,7,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,0 L 4.5,4.5 L 9,0"
                                      Stroke="{DynamicResource Octadock.Brush.TextMuted}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Data" Value="M 0,4.5 L 4.5,0 L 9,4.5" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          Style="{StaticResource WorkspaceExpanderHeader}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="ExpandSite"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    Visibility="Collapsed">
                                <ContentPresenter Margin="0,5,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  ContentSource="Content" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact product header. -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36"
                    Height="36"
                    CornerRadius="11"
                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                    BorderThickness="1">
                <icons:PackIconLucide Kind="PackageCheck"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Title}" Text="{Binding ReviewHeading}" />
                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource Octadock.Text.Micro}"
                           Text="{Binding ReviewSourceLabel}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Padding="10,5"
                    CornerRadius="12"
                    Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Octadock.Brush.Border}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="ShieldCheck"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource Octadock.Brush.Success}" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="1 Evidence  →  2 Outcome  →  3 Run" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Compose: goal, evidence sources, acceptance criteria. -->
            <Border Grid.Column="0"
                    Padding="11"
                    Style="{StaticResource WorkspaceCard}"
                    IsEnabled="{Binding IsNotBusy}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel Visibility="{Binding NeedsOutcome, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                       Text="2 · Choose the result you want" />
                            <TextBlock Margin="0,3,0,7"
                                       Style="{StaticResource Octadock.Text.Micro}"
                                       Text="Build something, investigate a problem, verify a result, extract data, or prepare a handoff."
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Workflows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="148"
                                            MinHeight="54"
                                            Margin="0,0,5,5"
                                            Padding="9,7"
                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                            ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.ChooseWorkflowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            AutomationProperties.HelpText="{Binding Description}">
                                        <StackPanel Width="128">
                                            <TextBlock FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Margin="0,5,0,0"
                              Visibility="{Binding HasSelectedWorkflow, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                           Text="{Binding WorkflowHeading, StringFormat='3 · {0}'}" />
                                <TextBlock Margin="0,2,70,0"
                                           Style="{StaticResource Octadock.Text.Micro}"
                                           Text="Add one sentence only if the evidence does not say enough. This is optional."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                    Padding="8,4"
                                    ToolTip="Dictate missing intent into this field"
                                    Click="OnDictateGoalClick">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Mic" Width="13" Height="13" />
                                    <TextBlock Margin="5,0,0,0" FontSize="11" Text="Dictate" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <TextBox x:Name="GoalBox"
                             Grid.Row="5"
                             Height="60"
                             Margin="0,7,0,6"
                             Padding="9,6"
                             Style="{StaticResource Octadock.Style.TextBox}"
                             Text="{Binding AdditionalIntent, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasSelectedWorkflow, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Optional context missing from the evidence" />

                    <Expander Grid.Row="6"
                              Margin="0,0,0,5"
                              Header="Definition of done · auto-filled"
                              Style="{StaticResource WorkspaceExpander}"
                              Visibility="{Binding HasSelectedWorkflow, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Definition of done">
                        <TextBox Height="48"
                                 Margin="0,4,0,0"
                                 Padding="8,5"
                                 Style="{StaticResource Octadock.Style.TextBox}"
                                 Text="{Binding AcceptanceCriteriaText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Required acceptance criteria, one per line" />
                    </Expander>

                    <Expander Grid.Row="7"
                              Margin="0,0,0,6"
                              Header="More details"
                              Style="{StaticResource WorkspaceExpander}"
                              Visibility="{Binding HasSelectedWorkflow, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Task metadata">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CompactLabel}" Text="Title" />
                                     <TextBox Style="{StaticResource Octadock.Style.TextBox}"
                                              Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                              AutomationProperties.Name="Task title" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource CompactLabel}" Text="Project" />
                                    <TextBox Style="{StaticResource Octadock.Style.TextBox}"
                                              Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                              AutomationProperties.Name="Project name" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Step one: source acquisition. -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,6"
                            Padding="8"
                            Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                            CornerRadius="9"
                            Visibility="{Binding NeedsEvidence, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                       Text="1 · Add what AI should work from" />
                            <TextBlock Margin="0,3,0,7"
                                       Style="{StaticResource Octadock.Text.Micro}"
                                       Text="Opening this review from a screenshot, Context, History, or Clipboard attaches that source automatically. Or add something here."
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,5,5"
                                        Padding="8,5"
                                        Command="{Binding AddFilesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Paperclip" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="Choose file" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,5,5"
                                        Padding="8,5"
                                        Command="{Binding AddClipboardCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Clipboard" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="Use clipboard" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,0,5"
                                        Padding="8,5"
                                        Command="{Binding CompareImagesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="ScanSearch" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="Before / after" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox MinHeight="28"
                                          Style="{StaticResource Octadock.Style.ComboBox}"
                                          ItemsSource="{Binding RecentCaptures}"
                                          SelectedItem="{Binding SelectedRecentCapture}"
                                          DisplayMemberPath="Label"
                                          AutomationProperties.Name="Recent capture" />
                                <Button Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource Octadock.Style.ToolButton}"
                                        Padding="8,4"
                                        Content="Use capture"
                                        Command="{Binding AddRecentCaptureCommand}" />
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox MinHeight="28"
                                          Style="{StaticResource Octadock.Style.ComboBox}"
                                          ItemsSource="{Binding ContextPackages}"
                                          SelectedItem="{Binding SelectedContext}"
                                          DisplayMemberPath="Label"
                                          AutomationProperties.Name="Context package" />
                                <Button Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource Octadock.Style.ToolButton}"
                                        Padding="8,4"
                                        Content="Use Context"
                                        Command="{Binding AddContextCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,2"
                          Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                        <ListBox ItemsSource="{Binding Evidence}"
                                 SelectedItem="{Binding SelectedEvidence}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Evidence in the reviewed packet"
                                 AutomationProperties.HelpText="Select an image to run local OCR or remove it from this draft.">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionFrame"
                                                        Padding="1"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7,5"
                                            CornerRadius="7"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowDense}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                 Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox VerticalAlignment="Center"
                                                      IsChecked="{Binding IsIncluded}"
                                                      ToolTip="Include in reviewed packet"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='Include {0} in the reviewed packet'}" />
                                            <Border Grid.Column="1"
                                                    Margin="7,0"
                                                    Padding="6,2"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource Octadock.Brush.AccentSoft}">
                                                <TextBlock FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}"
                                                           Text="{Binding KindLabel}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Octadock.Brush.Text}"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,1,0,0"
                                                           Style="{StaticResource Octadock.Text.Micro}"
                                                           Text="{Binding DetailLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <icons:PackIconLucide Grid.Column="3"
                                                                  Kind="Image"
                                                                  Width="13"
                                                                  Height="13"
                                                                  Margin="6,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource Octadock.Brush.Warning}"
                                                                  Visibility="{Binding HasPixels, Converter={StaticResource BoolToVisibility}}"
                                                                  ToolTip="Contains pixels; text redaction does not alter the image"
                                                                  AutomationProperties.Name="Image pixels are included unchanged" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Padding="12"
                                IsHitTestVisible="False"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Evidence.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:PackIconLucide Kind="Paperclip"
                                                      Width="18"
                                                      Height="18"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{DynamicResource Octadock.Brush.TextMuted}" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource Octadock.Text.Caption}"
                                           Text="Add a capture, Context item, clipboard, or file." />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource Octadock.Text.Micro}"
                                           Text="You can also drop files anywhere in this window." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,4,0,0"
                          Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Octadock.Text.Micro}"
                                   Text="{Binding EvidenceStepSummary}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Padding="8,4"
                                    Content="OCR selected"
                                    Command="{Binding RunOcrCommand}" />
                            <Button Margin="5,0,0,0"
                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                    Padding="8,4"
                                    Content="Remove"
                                    Command="{Binding RemoveSelectedEvidenceCommand}" />
                        </StackPanel>
                    </Grid>

                    <Expander Grid.Row="3"
                              Margin="0,3,0,0"
                              Header="Add more evidence"
                              Style="{StaticResource WorkspaceExpander}"
                              Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Add more evidence">
                        <StackPanel Margin="0,2,0,0">
                            <WrapPanel>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,5,4"
                                        Padding="8,5"
                                        Command="{Binding AddFilesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Paperclip" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="File" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,5,4"
                                        Padding="8,5"
                                        Command="{Binding AddClipboardCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Clipboard" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="Clipboard" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                        Margin="0,0,0,4"
                                        Padding="8,5"
                                        Command="{Binding CompareImagesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="ScanSearch" Width="13" Height="13" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11" Text="Before / after" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Octadock.Text.Micro}"
                                       Text="You can also drop files anywhere in this window." />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- Review and ephemeral result. -->
            <Border Grid.Column="2" Style="{StaticResource WorkspaceCard}" Padding="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.RowSpan="2"
                                Margin="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReview}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="46"
                                Height="46"
                                HorizontalAlignment="Left"
                                CornerRadius="14"
                                Background="{DynamicResource Octadock.Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                                BorderThickness="1">
                            <icons:PackIconLucide Kind="MousePointerClick"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0"
                                   Style="{StaticResource Octadock.Text.Micro}"
                                   Foreground="{DynamicResource Octadock.Brush.Accent}"
                                   Text="{Binding GuideStepLabel}" />
                        <TextBlock Margin="0,7,0,0"
                                   Style="{StaticResource Octadock.Text.Title}"
                                   FontSize="24"
                                   Text="{Binding GuideTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Octadock.Text.Muted}"
                                   FontSize="13"
                                   LineHeight="20"
                                   Text="{Binding GuideDescription}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,20,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Sparkles"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,1,9,0"
                                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                           Text="Best path: open the handoff review from the screenshot or item you are already working with."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="10,10,10,0"
                            Padding="9,7"
                            CornerRadius="9"
                            Background="{DynamicResource Octadock.Brush.WarningSoft}"
                            BorderBrush="{DynamicResource Octadock.Brush.Warning}"
                            BorderThickness="1"
                            Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <icons:PackIconLucide Kind="ShieldAlert"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Octadock.Brush.Warning}" />
                            <TextBlock Grid.Column="1"
                                       Margin="7,0,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Octadock.Text.Caption}"
                                       Foreground="{DynamicResource Octadock.Brush.Text}"
                                       Text="{Binding PrivacyLabel}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Agent packet privacy status" />
                            <CheckBox Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Content="Redact text secrets"
                                      IsChecked="{Binding RedactSecrets}"
                                      IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1"
                                Margin="8"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectedIndex="{Binding SelectedWorkspaceTabIndex, Mode=TwoWay}"
                                Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Exact handoff packet review">
                        <TabItem Header="Ready" Style="{StaticResource WorkspaceTab}">
                            <StackPanel Margin="8,18">
                                <icons:PackIconLucide Kind="Route"
                                                      Width="28"
                                                      Height="28"
                                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource Octadock.Text.Title}"
                                           Text="{Binding WorkflowHeading}" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="500"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource Octadock.Text.Muted}"
                                           Text="{Binding WorkflowDescription}"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,18,0,0"
                                        Padding="12,10"
                                        Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                                   Text="Evidence ready from your workflow" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource Octadock.Text.Caption}"
                                                   Text="{Binding EvidenceSummary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Octadock.Text.Micro}"
                                                   Text="Add only what is missing. Octadock keeps the original provenance and review boundary."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource Octadock.Style.ToolButton}"
                                        Command="{Binding CompareImagesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Images" Width="14" Height="14" />
                                        <TextBlock Margin="7,0,0,0" Text="Add before / after evidence" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Advanced packet" Style="{StaticResource WorkspaceTab}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,6">
                                    <TextBlock Style="{StaticResource Octadock.Text.Micro}"
                                               Text="This exact reviewed Markdown is passed to the selected CLI." />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource Octadock.Text.Mono}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                               Text="{Binding ReviewHash}" />
                                </Grid>
                                <TextBox Grid.Row="1"
                                         Padding="11,9"
                                         Style="{StaticResource Octadock.Style.TextBox}"
                                         Text="{Binding PacketPreview, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="11"
                                         AutomationProperties.Name="Exact Agent Packet preview" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Agent review" Style="{StaticResource WorkspaceTab}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="2,0,2,6">
                                    <TextBlock Style="{StaticResource Octadock.Text.Micro}"
                                               Text="Ephemeral read-only review. Copy it before closing if you want to keep it." />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding ResultIntegrityLabel}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Agent review integrity status">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Micro}">
                                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Row="1"
                                         Padding="11,9"
                                         Style="{StaticResource Octadock.Style.TextBox}"
                                         Text="{Binding ResultText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="11.5"
                                         AutomationProperties.Name="Read-only agent review" />
                                <StackPanel Grid.Row="2"
                                            Margin="0,7,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                            Content="Read aloud"
                                            Command="{Binding ReadResultCommand}" />
                                    <Button Margin="5,0,0,0"
                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                            Content="Copy result"
                                            Command="{Binding CopyResultCommand}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Verification" Style="{StaticResource WorkspaceTab}">
                            <StackPanel Margin="4,16">
                                <icons:PackIconLucide Kind="ScanSearch"
                                                      Width="28"
                                                      Height="28"
                                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource Octadock.Text.SectionHeader}"
                                           Text="Verify a visual result" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="430"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource Octadock.Text.Muted}"
                                           Text="Compare a baseline and result locally. Octadock adds both images, a heat map, changed-pixel ratio, mean/max delta, and change bounds to the same task packet."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource Octadock.Text.Body}"
                                           Foreground="{DynamicResource Octadock.Brush.Accent}"
                                           Text="{Binding VerificationSummary}" />
                                <Button Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource Octadock.Style.AccentButton}"
                                        Command="{Binding CompareImagesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconLucide Kind="Images" Width="14" Height="14" />
                                        <TextBlock Margin="7,0,0,0" Text="Choose before and after" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- One calm footer: state at left, explicit boundary actions at right. -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="9,7"
                Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="1"
                CornerRadius="11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Handoff review status"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Text="{Binding ErrorText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Handoff review error"
                               AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar Height="2"
                                 Margin="0,5,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox Width="132"
                               MinHeight="30"
                               Style="{StaticResource Octadock.Style.ComboBox}"
                               ItemsSource="{Binding Providers}"
                               SelectedItem="{Binding SelectedProvider}"
                               DisplayMemberPath="Label"
                               IsEnabled="{Binding IsNotBusy}"
                               Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="{Binding DestinationLabel}"
                               AutomationProperties.Name="Agent provider" />
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource Octadock.Style.ToolButton}"
                            Padding="8,4"
                            Content="Copy packet"
                            Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}"
                            Click="OnCommitDraftInput"
                            Command="{Binding CopyPacketCommand}" />
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource Octadock.Style.ToolButton}"
                            Padding="8,4"
                            Content="Save bundle"
                            Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}"
                            Click="OnCommitDraftInput"
                            Command="{Binding ExportPacketCommand}" />
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource Octadock.Style.ToolButton}"
                            Padding="8,4"
                            Content="Open bundle"
                            Command="{Binding OpenExportCommand}"
                            Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            MinWidth="160"
                            ToolTip="Send the exact reviewed packet to the selected CLI in read-only mode"
                            Click="OnCommitDraftInput"
                            Command="{Binding AnalyzeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="Bot" Width="14" Height="14" />
                            <TextBlock Margin="7,0,0,0" Text="{Binding AnalyzeButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource Octadock.Style.ToolButton}"
                            Padding="8,5"
                            Content="Cancel"
                            Command="{Binding CancelOperationCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
