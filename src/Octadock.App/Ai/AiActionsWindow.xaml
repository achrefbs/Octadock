<Window x:Class="Octadock.App.Ai.AiActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock · Review text handoff"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="580"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ArtifactCard"
               TargetType="Border"
               BasedOn="{StaticResource Octadock.Style.SectionCard}">
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,2,18">
            <StackPanel>
                <TextBlock Style="{StaticResource Octadock.Text.Title}"
                           Text="Review text handoff" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="One text artifact, one reviewed outbound preview, one explicit send. No sessions or passive scanning." />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Octadock.Style.CountPill}"
                    Padding="11,5">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="ShieldCheck"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Octadock.Brush.Accent}" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource Octadock.Text.Caption}"
                               Text="Explicit send only" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action and provider controls -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Style="{StaticResource ArtifactCard}"
                IsEnabled="{Binding IsNotBusy}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Octadock.Text.Caption}" Text="Action" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Handoff outcome" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="{Binding SelectedAction.Description}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Octadock.Text.Caption}" Text="Provider" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Read-only CLI destination" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="No provider fallback" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                               Text="Outbound route" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Octadock.Text.Body}"
                               Text="{Binding ProviderDisclosure}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Octadock uses your installed CLI. It stores no API key." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Artifact workflow: local input → exact outbound → ephemeral result -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.08*" MinWidth="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- Local input -->
            <Border Grid.Column="0" Style="{StaticResource ArtifactCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid IsEnabled="{Binding IsNotBusy}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                       Text="1  Local input" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Octadock.Text.Micro}"
                                       Text="{Binding SourceName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Paste"
                                    Command="{Binding PasteInputCommand}"
                                    AutomationProperties.Name="Paste clipboard text" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Open file…"
                                    Command="{Binding OpenFileCommand}" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Clear"
                                    Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,7"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Paste, type, or open a local text artifact. Nothing is scanned in the background." />

                    <TextBox Grid.Row="2"
                             Style="{StaticResource Octadock.Style.TextBox}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             IsEnabled="{Binding IsNotBusy}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="{StaticResource Octadock.FontSize.Caption}"
                             SpellCheck.IsEnabled="False"
                             AutomationProperties.Name="Local input text" />
                </Grid>
            </Border>

            <!-- Exact outbound review -->
            <Border Grid.Column="2" Style="{StaticResource ArtifactCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                       Text="2  Exact outbound preview" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Octadock.Text.Micro}"
                                       Text="This is the exact text passed to the selected CLI." />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="10,7"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Background="{DynamicResource Octadock.Brush.SurfaceOverlay}">
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding SecretSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Success}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RedactSecrets}" Value="False" />
                                                    <Condition Binding="{Binding HasDetectedSecrets}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Warning}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <CheckBox HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Content="Redact detected secrets"
                                      IsChecked="{Binding RedactSecrets}"
                                      IsEnabled="{Binding IsNotBusy}"
                                      AutomationProperties.Name="Redact detected secrets" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Margin="0,7,0,7"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="{Binding ReviewEstimate}" />

                    <TextBox Grid.Row="3"
                             Style="{StaticResource Octadock.Style.TextBox}"
                             Text="{Binding OutboundPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="{StaticResource Octadock.FontSize.Caption}"
                             AutomationProperties.Name="Exact outbound preview" />

                    <TextBlock Grid.Row="3"
                               Margin="12"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Text="Redaction is off. Detected secrets remain visible in the exact outbound preview."
                               TextWrapping="Wrap"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RedactSecrets}" Value="False" />
                                            <Condition Binding="{Binding HasDetectedSecrets}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Ephemeral result -->
            <Border Grid.Column="4" Style="{StaticResource ArtifactCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}"
                                       Text="3  Result" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Octadock.Text.Micro}"
                                       Text="Kept only in this window" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Copy"
                                    Command="{Binding CopyResultCommand}" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Read aloud"
                                    Command="{Binding ReadAloudResultCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,7"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Copy it or read it aloud. Closing this window discards it." />

                    <TextBox Grid.Row="2"
                             Style="{StaticResource Octadock.Style.TextBox}"
                             Text="{Binding ResultText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="{StaticResource Octadock.FontSize.Caption}"
                             AutomationProperties.Name="Handoff review result" />
                </Grid>
            </Border>
        </Grid>

        <!-- Explicit send footer -->
        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="16,13"
                Style="{StaticResource Octadock.Style.SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Octadock.Text.Body}"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="No source, preview, or result is written to history or logs." />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Text="{Binding ErrorText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ProgressBar Height="3"
                                 Margin="0,8,16,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button MinWidth="92"
                            Style="{StaticResource Octadock.Style.Button}"
                            Content="Cancel send"
                            Command="{Binding CancelSendCommand}" />
                    <Button MinWidth="150"
                            Margin="8,0,0,0"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            Command="{Binding SendCommand}"
                            AutomationProperties.Name="{Binding SendButtonText}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="Send"
                                                  Width="{StaticResource Octadock.Icon.Size.16}"
                                                  Height="{StaticResource Octadock.Icon.Size.16}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding SendButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
