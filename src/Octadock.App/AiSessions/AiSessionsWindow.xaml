<Window x:Class="Octadock.App.AiSessions.AiSessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Octadock AI Sessions"
        Width="980"
        Height="660"
        MinWidth="760"
        MinHeight="500"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.Surface}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBox" BasedOn="{StaticResource Octadock.Style.TextBox}" />

        <Style x:Key="SessionListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Octadock.Text.Title}" Text="Active AI Sessions" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="{Binding Summary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="260"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Padding="9,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search title, command, folder, or branch">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource Octadock.Style.AccentButton}"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Octadock.Style.Card}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="14,12,14,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource Octadock.Text.Subtitle}"
                                   Text="Recent sessions" />
                        <TextBlock DockPanel.Dock="Right"
                                   Style="{StaticResource Octadock.Text.Muted}"
                                   Text="{Binding StatusMessage}" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,0,8,8"
                                 ItemContainerStyle="{StaticResource SessionListItem}"
                                 ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="5"
                                                Margin="0,2,10,2"
                                                CornerRadius="3"
                                                Background="{Binding StatusBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right"
                                                        Margin="10,0,0,0"
                                                        Padding="7,2"
                                                        CornerRadius="5"
                                                        Background="{Binding StatusBrush}">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}"
                                                               Text="{Binding StatusLabel}" />
                                                </Border>

                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </DockPanel>

                                            <TextBlock Margin="0,4,0,0"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                                       Text="{Binding CommandLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />

                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="{Binding ProviderLabel}" />
                                                <TextBlock Margin="8,0,8,0" Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="-" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="{Binding ProcessLabel}" />
                                                <TextBlock Margin="8,0,8,0" Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="-" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="{Binding StartedLabel}" />
                                                <TextBlock Margin="8,0,8,0" Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="-" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Muted}" FontSize="11" Text="{Binding DurationLabel}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Octadock.Text.Muted}"
                                   Text="{Binding EmptyMessage}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Octadock.Style.Card}">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource Octadock.Text.Subtitle}"
                                       Text="{Binding SelectedSession.Title}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Octadock.Text.Muted}"
                                       Text="{Binding SelectedSession.DetailLine}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource Octadock.Text.Muted}"
                                       Text="Command" />
                            <Border Grid.Row="1"
                                    Margin="0,4,0,10"
                                    Padding="9"
                                    CornerRadius="6"
                                    Background="{DynamicResource Octadock.Brush.InputBackground}"
                                    BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                    BorderThickness="1">
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource Octadock.Brush.Text}"
                                           Text="{Binding SelectedSession.CommandLabel}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Style="{StaticResource Octadock.Text.Muted}"
                                       Text="Working folder" />
                            <Border Grid.Row="3"
                                    Margin="0,4,0,0"
                                    Padding="9"
                                    CornerRadius="6"
                                    Background="{DynamicResource Octadock.Brush.InputBackground}"
                                    BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                    BorderThickness="1">
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource Octadock.Brush.Text}"
                                           Text="{Binding SelectedSession.CwdLabel}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource Octadock.Text.Subtitle}"
                                       Text="Timeline" />

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <ListBox Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ItemsSource="{Binding Events}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="7"
                                                        Height="7"
                                                        Margin="0,6,9,0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource Octadock.Brush.Accent}" />

                                                <StackPanel Grid.Column="1">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Style="{StaticResource Octadock.Text.Muted}"
                                                                   FontSize="11"
                                                                   Text="{Binding CreatedLabel}" />
                                                        <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding TypeLabel}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource Octadock.Text.Muted}"
                                                               Text="{Binding Message}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Octadock.Text.Muted}"
                                           Text="{Binding TimelineMessage}"
                                           Visibility="{Binding IsTimelineEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>

                        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Copy command"
                                    IsEnabled="{Binding CanCopySelectedCommand}"
                                    Command="{Binding CopyCommandTextCommand}" />
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Margin="6,0,0,0"
                                    Content="Copy ID"
                                    IsEnabled="{Binding HasSelection}"
                                    Command="{Binding CopySessionIdCommand}" />
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Margin="6,0,0,0"
                                    Content="Open folder"
                                    IsEnabled="{Binding CanRevealSelectedCwd}"
                                    Command="{Binding RevealCwdCommand}" />
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Margin="6,0,0,0"
                                    Content="Open stdout log"
                                    IsEnabled="{Binding CanOpenStdoutLog}"
                                    Command="{Binding OpenStdoutLogCommand}" />
                            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                                    Margin="6,0,0,0"
                                    Content="Open stderr log"
                                    IsEnabled="{Binding CanOpenStderrLog}"
                                    Command="{Binding OpenStderrLogCommand}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Octadock.Text.Muted}"
                               Text="Select a session to inspect its command, folder, and timeline."
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Right"
                   Style="{StaticResource Octadock.Text.Muted}"
                   Text="Generic run/watch tracking is live. Provider adapters, waiting detection, and dock cards are next." />
    </Grid>
</Window>
