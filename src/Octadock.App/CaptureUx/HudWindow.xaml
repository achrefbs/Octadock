<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock Capture"
        SizeToContent="WidthAndHeight"
        ShowActivated="True"
        AutomationProperties.Name="Octadock capture tools">

    <windows:ToolWindowBase.Resources>
        <Style x:Key="Hud.ModeButton" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Octadock.Corner.Tile}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="StateLayer"
                                        Background="{DynamicResource Octadock.Brush.Hover}"
                                        CornerRadius="{StaticResource Octadock.Corner.Tile}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hud.FooterToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Octadock.Corner.Row}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hud.FooterButton" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        </Style>
    </windows:ToolWindowBase.Resources>

    <Border x:Name="HudShell"
            Style="{StaticResource Octadock.Style.FloatingGlassShell}"
            Padding="0"
            Opacity="0">
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Width="386">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragBar" Grid.Row="0" Height="48" Background="Transparent" Cursor="SizeAll" Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <icons:PackIconLucide Grid.Column="0" Kind="ScanLine" Width="19" Height="19"
                                      Foreground="{DynamicResource Octadock.Brush.Accent}"
                                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Capture"
                           Style="{StaticResource Octadock.Text.Section}"
                           VerticalAlignment="Center" />
                <Border x:Name="HotkeyChip" Grid.Column="3" Margin="8,0" Padding="8,3"
                        Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                        BorderBrush="{DynamicResource Octadock.Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource Octadock.Corner}">
                    <TextBlock x:Name="HotkeyChipText" Style="{StaticResource Octadock.Text.Micro}" />
                </Border>
                <Button x:Name="CloseButton" Grid.Column="4"
                        Style="{StaticResource Octadock.Style.IconButton}"
                        ToolTip="Close capture tools"
                        AutomationProperties.Name="Close capture tools"
                        Click="OnCloseClick">
                    <icons:PackIconLucide Kind="X" Width="17" Height="17" />
                </Button>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}" BorderThickness="0,1,0,1" Padding="12">
                <UniformGrid Rows="2" Columns="3">
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture a region"
                            AutomationProperties.Name="Capture area" Click="OnAreaClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="ScanLine" Width="25" Height="25" Foreground="{DynamicResource Octadock.Brush.Accent}" HorizontalAlignment="Center" />
                            <TextBlock Text="Area" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Ready" Style="{StaticResource Octadock.Text.Micro}" Foreground="{DynamicResource Octadock.Brush.Accent}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture an application window"
                            AutomationProperties.Name="Capture window" Click="OnWindowClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="AppWindow" Width="25" Height="25" HorizontalAlignment="Center" />
                            <TextBlock Text="Window" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Ready" Style="{StaticResource Octadock.Text.Micro}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture the active monitor"
                            AutomationProperties.Name="Capture full screen" Click="OnFullscreenClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="Monitor" Width="25" Height="25" HorizontalAlignment="Center" />
                            <TextBlock Text="Full screen" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Ready" Style="{StaticResource Octadock.Text.Micro}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Manual vertical scrolling capture (Beta)"
                            AutomationProperties.Name="Scrolling capture, beta" Click="OnScrollingClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="ScrollText" Width="25" Height="25" HorizontalAlignment="Center" />
                            <TextBlock Text="Scrolling" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Beta" Style="{StaticResource Octadock.Text.Micro}" Foreground="{DynamicResource Octadock.Brush.Warning}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Extract text from a region"
                            AutomationProperties.Name="Extract text with OCR" Click="OnOcrClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="ScanText" Width="25" Height="25" HorizontalAlignment="Center" />
                            <TextBlock Text="OCR" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Local" Style="{StaticResource Octadock.Text.Micro}" Foreground="{DynamicResource Octadock.Brush.Accent}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Record MP4 video without audio (Beta)"
                            AutomationProperties.Name="Record screen, beta, video only" Click="OnRecordClick">
                        <StackPanel>
                            <icons:PackIconLucide Kind="CircleDot" Width="25" Height="25" Foreground="{DynamicResource Octadock.Brush.Danger}" HorizontalAlignment="Center" />
                            <TextBlock Text="Record" Style="{StaticResource Octadock.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="Beta · video" Style="{StaticResource Octadock.Text.Micro}" Foreground="{DynamicResource Octadock.Brush.Warning}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="4" Margin="12,8,12,10">
                <ToggleButton x:Name="LockAspectCheck" Margin="0,0,4,0"
                              Style="{StaticResource Hud.FooterToggle}"
                              AutomationProperties.Name="Lock aspect ratio">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Lock" Width="16" Height="16" Foreground="{DynamicResource Octadock.Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AspectText" Text="Aspect" Style="{StaticResource Octadock.Text.Micro}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FixedSizeCheck" Margin="4,0"
                              Style="{StaticResource Hud.FooterToggle}"
                              AutomationProperties.Name="Use a fixed capture size">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Maximize2" Width="16" Height="16" Foreground="{DynamicResource Octadock.Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="Fixed" Style="{StaticResource Octadock.Text.Micro}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Margin="4,0" Style="{StaticResource Hud.FooterButton}"
                        ToolTip="Start a delayed area capture"
                        AutomationProperties.Name="Start delayed capture"
                        Click="OnDelayClick">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Clock3" Width="16" Height="16" Foreground="{DynamicResource Octadock.Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="Delay" Style="{StaticResource Octadock.Text.Micro}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,0" Style="{StaticResource Hud.FooterButton}"
                        ToolTip="Open capture settings"
                        AutomationProperties.Name="Open capture settings"
                        Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Settings2" Width="16" Height="16" Foreground="{DynamicResource Octadock.Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Style="{StaticResource Octadock.Text.Micro}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border Grid.Row="3" Margin="12,0,12,12" Padding="10,8"
                    Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource Octadock.Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Octadock.Corner.Row}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=FixedSizeCheck}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fixed size" Style="{StaticResource Octadock.Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="WidthBox" Width="58" Margin="10,0,0,0" VerticalContentAlignment="Center" ToolTip="Width in pixels" />
                    <TextBlock Text="×" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource Octadock.Text.Caption}" />
                    <TextBox x:Name="HeightBox" Width="58" VerticalContentAlignment="Center" ToolTip="Height in pixels" />
                    <TextBlock Text="px" Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource Octadock.Text.Caption}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</windows:ToolWindowBase>
