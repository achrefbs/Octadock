<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        Title="Octadock"
        SizeToContent="WidthAndHeight"
        ShowActivated="True">

    <windows:ToolWindowBase.Resources>
        <!-- A vertical icon+label capture button: quiet glass tile that lifts on
             hover (soft state layer + accent hairline) and shows an accent focus ring. -->
        <Style x:Key="Hud.ModeButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="StateLayer"
                                        CornerRadius="10"
                                        Background="{DynamicResource Octadock.Brush.Hover}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassHighlight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </windows:ToolWindowBase.Resources>

    <Border Background="{DynamicResource Octadock.Brush.GlassSurface}"
            BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource Octadock.Corner.Window}"
            Padding="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#FF05070C" />
        </Border.Effect>

        <StackPanel>
            <!-- Drag handle + close. -->
            <Grid x:Name="DragBar" Background="Transparent" Cursor="SizeAll" Margin="2,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{DynamicResource Octadock.Brush.Accent}" />
                    <TextBlock Text="Octadock"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                               FontFamily="{DynamicResource Octadock.Font}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Width="22" Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                        Cursor="Hand"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        ToolTip="Close"
                        Click="OnCloseClick" />
            </Grid>

            <!-- Capture modes. -->
            <UniformGrid Rows="1" Columns="6">
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture a region" Click="OnAreaClick">
                    <StackPanel>
                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <TextBlock Text="Area" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture a window" Click="OnWindowClick">
                    <StackPanel>
                        <TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <TextBlock Text="Window" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Capture the full screen" Click="OnFullscreenClick">
                    <StackPanel>
                        <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <TextBlock Text="Full" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Scrolling capture" Click="OnScrollingClick">
                    <StackPanel>
                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <TextBlock Text="Scroll" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Extract text (OCR)" Click="OnOcrClick">
                    <StackPanel>
                        <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <TextBlock Text="OCR" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Hud.ModeButton}" ToolTip="Record the screen" Click="OnRecordClick">
                    <StackPanel>
                        <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.Danger}" />
                        <TextBlock Text="Record" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Fixed dimensions / locked aspect. -->
            <Border Margin="2,10,2,0"
                    Background="{DynamicResource Octadock.Brush.InputBackground}"
                    BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="FixedSizeCheck"
                                  Content="Fixed size"
                                  Foreground="{DynamicResource Octadock.Brush.Text}"
                                  VerticalAlignment="Center" />
                        <TextBox x:Name="WidthBox" Width="56" Margin="10,0,0,0"
                                 VerticalContentAlignment="Center" ToolTip="Width (px)" />
                        <TextBlock Text="&#215;" VerticalAlignment="Center" Margin="6,0"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}" />
                        <TextBox x:Name="HeightBox" Width="56"
                                 VerticalContentAlignment="Center" ToolTip="Height (px)" />
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="LockAspectCheck"
                                  Content="Lock aspect"
                                  Foreground="{DynamicResource Octadock.Brush.Text}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="AspectText"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   FontSize="12"
                                   Text="last: none" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</windows:ToolWindowBase>
