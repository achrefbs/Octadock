<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        Title="Octadock Selection"
        Cursor="Cross"
        FocusManager.IsFocusScope="True"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <!-- Root canvas: everything is positioned by absolute DIP coordinates. -->
    <Grid x:Name="Root">
        <!-- Frozen fullscreen frame (freeze-screen mode); hidden otherwise. -->
        <Image x:Name="FrozenImage"
               Stretch="Fill"
               Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Four dimming panels around the selection (drawn via a geometry mask). -->
        <Path x:Name="DimPath"
              Fill="{DynamicResource Octadock.Brush.CaptureDim}"
              IsHitTestVisible="False" />

        <Canvas x:Name="Overlay" ClipToBounds="False">
            <!-- Crosshair guide lines following the cursor (pre-drag). -->
            <Line x:Name="CrossH"
                  Stroke="{DynamicResource Octadock.Brush.Accent}"
                  StrokeThickness="1"
                  Opacity="0.7"
                  IsHitTestVisible="False" />
            <Line x:Name="CrossV"
                  Stroke="{DynamicResource Octadock.Brush.Accent}"
                  StrokeThickness="1"
                  Opacity="0.7"
                  IsHitTestVisible="False" />

            <!-- The selection rectangle outline. -->
            <Rectangle x:Name="SelectionRect"
                       Stroke="{DynamicResource Octadock.Brush.Accent}"
                       StrokeThickness="2"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- Eight resize handles (created/positioned in code-behind). -->
            <Canvas x:Name="HandleLayer" IsHitTestVisible="False" />

            <!-- Dimensions chip near the selection. -->
            <Border x:Name="DimChip"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    CornerRadius="4"
                    Padding="8,4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimText"
                           Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="0 &#215; 0" />
            </Border>

            <!-- Magnifier loupe near the cursor. -->
            <Border x:Name="Loupe"
                    Width="132"
                    Height="156"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel>
                    <Border Width="112" Height="112"
                            Margin="8,8,8,4"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource Octadock.Brush.CaptureBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Image x:Name="LoupeImage"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <!-- Center-pixel reticle. -->
                            <Rectangle Width="8" Height="8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stroke="{DynamicResource Octadock.Brush.Accent}"
                                       StrokeThickness="1" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="LoupeCoords"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="11"
                               Text="0, 0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Border x:Name="LoupeSwatch"
                                Width="12" Height="12"
                                Margin="0,0,6,0"
                                CornerRadius="2"
                                BorderBrush="{DynamicResource Octadock.Brush.CaptureBorderStrong}"
                                BorderThickness="1" />
                        <TextBlock x:Name="LoupeHex"
                                   Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   Text="#000000" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Confirm / cancel toolbar shown after a rectangle exists. -->
            <Border x:Name="Toolbar"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    CornerRadius="6"
                    Padding="6"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton"
                            Content="Capture"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            MinWidth="86"
                            Padding="12,6"
                            Margin="0,0,6,0"
                            Click="OnConfirmClick" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource Octadock.Style.Button}"
                            MinWidth="72"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                            BorderBrush="{DynamicResource Octadock.Brush.CaptureBorderStrong}"
                            Click="OnCancelClick" />
                </StackPanel>
            </Border>

            <!-- Hint shown before the first drag. -->
            <Border x:Name="Hint"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    CornerRadius="6"
                    Padding="12,8"
                    IsHitTestVisible="False">
                <TextBlock Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="13"
                           Text="Drag to select a region  &#8226;  Enter to capture  &#8226;  Esc to cancel" />
            </Border>
        </Canvas>
    </Grid>
</windows:ToolWindowBase>
