<UserControl x:Class="Octadock.App.CaptureUx.ShelfItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260"
             FontFamily="{DynamicResource Octadock.Font}">

    <UserControl.Resources>
        <!-- Local fallbacks so the card renders standalone. -->
        <SolidColorBrush x:Key="Card.Surface" Color="#FF1E2A38" />
        <SolidColorBrush x:Key="Card.Border" Color="#FF32404F" />
        <SolidColorBrush x:Key="Card.Text" Color="#FFF1F5F9" />
        <SolidColorBrush x:Key="Card.Muted" Color="#FF9AA7B4" />
        <SolidColorBrush x:Key="Card.Accent" Color="#FF2DD4BF" />
        <SolidColorBrush x:Key="Card.Danger" Color="#FFF87171" />
        <SolidColorBrush x:Key="Card.Checkerboard" Color="#22000000" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card.ActionButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Octadock.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <!-- A ContextMenu is not in the visual tree, so route its DataContext from
                 the placement target (this card's Border, whose DataContext is the item
                 view model) so the command bindings below resolve. -->
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
                <MenuItem Header="Copy" Command="{Binding CopyKeepCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Copy File" Command="{Binding CopyFileCommand}" />
                <Separator />
                <MenuItem Header="Flip Horizontal" Command="{Binding FlipHorizontalCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Flip Vertical" Command="{Binding FlipVerticalCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Rotate 90°" Command="{Binding RotateCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Scale hi-DPI to 1×" Command="{Binding ScaleToOneXCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <Separator Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Open File Location" Command="{Binding OpenFileLocationCommand}" />
                <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}" />
                <Separator />
                <MenuItem Header="Discard" Command="{Binding DiscardCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Width="{Binding DataContext.CardWidth,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                    FallbackValue=240,
                                    TargetNullValue=240}">
            <!-- Thumbnail (drag source). -->
            <Border x:Name="ThumbHost"
                    Height="{Binding DataContext.ThumbnailHeight,
                                     RelativeSource={RelativeSource AncestorType=ItemsControl},
                                     FallbackValue=140,
                                     TargetNullValue=140}"
                    Background="{StaticResource Card.Checkerboard}"
                    CornerRadius="6"
                    ClipToBounds="True"
                    Cursor="Hand"
                    ToolTip="Drag out to a folder, chat or upload"
                    MouseLeftButtonDown="OnThumbMouseDown"
                    MouseMove="OnThumbMouseMove"
                    MouseLeftButtonUp="OnThumbMouseUp">
                <Grid>
                    <Image Source="{Binding Thumbnail}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE714;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="34"
                                   Foreground="{DynamicResource Octadock.Brush.Text}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DurationLabel}"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filename + dimensions. -->
            <TextBlock Text="{Binding FileName}"
                       Margin="2,8,2,0"
                       Foreground="{DynamicResource Octadock.Brush.Text}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Dimensions}"
                       Margin="2,0,2,0"
                       Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                       FontSize="11" />

            <!-- Action bar. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE8C8;" ToolTip="Copy"
                        Command="{Binding CopyCommand}"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE8A5;" ToolTip="Copy File"
                        Command="{Binding CopyFileCommand}"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE74E;" ToolTip="Save"
                        Command="{Binding SaveCommand}" />
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE70F;" ToolTip="Annotate"
                        Command="{Binding AnnotateCommand}"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE718;" ToolTip="Pin"
                        Command="{Binding PinCommand}"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Card.ActionButton}" Content="&#xE74D;" ToolTip="Discard"
                        Foreground="{DynamicResource Octadock.Brush.Danger}"
                        Command="{Binding DiscardCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
