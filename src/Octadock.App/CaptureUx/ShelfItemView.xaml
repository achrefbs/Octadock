<UserControl x:Class="Octadock.App.CaptureUx.ShelfItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="388"
             FontFamily="{DynamicResource Octadock.Font}">

    <!--
        The shelf item is intentionally image-only. Metadata and actions stay out
        of the resting state; the screenshot itself is the card, with a compact
        overlay revealed only when the pointer is over it.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border x:Name="TileRoot"
            Width="{Binding DataContext.CardWidth,
                            RelativeSource={RelativeSource AncestorType=ItemsControl},
                            FallbackValue=224,
                            TargetNullValue=224}"
            Height="{Binding DataContext.ThumbnailHeight,
                             RelativeSource={RelativeSource AncestorType=ItemsControl},
                             FallbackValue=126,
                             TargetNullValue=126}">
        <Border.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Width="{Binding ActualWidth, ElementName=TileRoot}"
                            Height="{Binding ActualHeight, ElementName=TileRoot}"
                            Background="Black"
                            CornerRadius="{StaticResource Octadock.Corner.Well}" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.OpacityMask>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Octadock.Style.ImageOnlyTile}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRow}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassHighlight}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.ContextMenu>
            <!-- A ContextMenu is not in the visual tree, so route its DataContext from
                 the placement target (this tile's Border, whose DataContext is the item
                 view model) so the command bindings below resolve. -->
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open File Location" Command="{Binding OpenFileLocationCommand}" />
                <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}" />
                <Separator />
                <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
                <MenuItem Header="Copy" Command="{Binding CopyKeepCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Copy File" Command="{Binding CopyFileCommand}" />
                <Separator />
                <MenuItem Header="Flip Horizontal" Command="{Binding FlipHorizontalCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Flip Vertical" Command="{Binding FlipVerticalCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Rotate 90°" Command="{Binding RotateCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Scale hi-DPI to 1×" Command="{Binding ScaleToOneXCommand}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <Separator />
                <MenuItem Header="Discard" Command="{Binding DiscardCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Thumbnail / drag source / click-to-open surface. -->
            <Border x:Name="ThumbHost"
                    Style="{StaticResource Octadock.Style.ThumbnailWell}"
                    Cursor="Hand"
                    ToolTip="Click to open, or drag out to another app"
                    MouseLeftButtonDown="OnThumbMouseDown"
                    MouseMove="OnThumbMouseMove"
                    MouseLeftButtonUp="OnThumbMouseUp">
                <Grid>
                    <Image Source="{Binding Thumbnail}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE714;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{DynamicResource Octadock.Brush.Text}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DurationLabel}"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hover tools over the screenshot itself. -->
            <Grid x:Name="ActionOverlay"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Height="42"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Octadock.Brush.GlassChrome}"
                        BorderBrush="{DynamicResource Octadock.Brush.GlassHighlight}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6">
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton}" Content="&#xE890;" ToolTip="View"
                            Command="{Binding OpenCommand}" />
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton}" Content="&#xE838;" ToolTip="Open file location"
                            Command="{Binding OpenFileLocationCommand}" />
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton}" Content="&#xE8C8;" ToolTip="Copy image"
                            Command="{Binding CopyCommand}"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton}" Content="&#xE8A5;" ToolTip="Copy file"
                            Command="{Binding CopyFileCommand}"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton}" Content="&#xE74D;" ToolTip="Discard"
                            Foreground="{DynamicResource Octadock.Brush.Danger}"
                            Command="{Binding DiscardCommand}" />
                </StackPanel>
            </Grid>

            <Border BorderThickness="1"
                    CornerRadius="{StaticResource Octadock.Corner.Well}"
                    BorderBrush="{DynamicResource Octadock.Brush.GlassHighlight}"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                    IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
