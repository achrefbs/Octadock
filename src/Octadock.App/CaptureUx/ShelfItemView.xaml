<UserControl x:Class="Octadock.App.CaptureUx.ShelfItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
             mc:Ignorable="d"
             d:DesignWidth="214"
             d:DesignHeight="124"
             FontFamily="{DynamicResource Octadock.Font}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ContextMenu x:Key="ShelfItemOverflowMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
            <MenuItem Header="Annotate…"
                      Command="{Binding AnnotateCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="Copy image"
                      Command="{Binding CopyKeepCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Copy recording file"
                      Command="{Binding CopyFileCommand}"
                      Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Save" Command="{Binding SaveCommand}" />
            <MenuItem Header="Save as…" Command="{Binding SaveAsCommand}" />
            <MenuItem Header="{Binding ActiveContext.AddActionLabel}"
                      Command="{Binding AddToContextCommand}" />
            <MenuItem Header="Prepare reviewed handoff…"
                      Command="{Binding UseWithAiCommand}"
                      CommandParameter="choose" />
            <Separator />
            <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}" />
            <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}" />
            <Separator />
            <MenuItem Header="Flip horizontal"
                      Command="{Binding FlipHorizontalCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Flip vertical"
                      Command="{Binding FlipVerticalCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Rotate 90°"
                      Command="{Binding RotateCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Scale hi-DPI to 1×"
                      Command="{Binding ScaleToOneXCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="Remove from Shelf"
                      ToolTip="Keeps the capture in History and on disk"
                      Command="{Binding DiscardCommand}" />
            <MenuItem Header="Delete permanently…"
                      ToolTip="Deletes the file from disk and removes it from History. Cannot be undone."
                      Command="{Binding DeletePermanentlyCommand}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid x:Name="SwipeHost"
          Width="{Binding DisplayWidth, FallbackValue=196, TargetNullValue=196}"
          Height="{Binding DisplayHeight, FallbackValue=108, TargetNullValue=108}"
          HorizontalAlignment="Right"
          ClipToBounds="True">
        <Border x:Name="SwipeActionBackground"
                CornerRadius="9"
                Opacity="0"
                IsHitTestVisible="False"
                Background="{DynamicResource Octadock.Brush.AccentSoft}">
            <icons:PackIconLucide x:Name="SwipeActionIcon"
                                  Kind="Copy"
                                  Width="18" Height="18"
                                  Margin="16,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource Octadock.Brush.Text}" />
        </Border>

        <Border x:Name="TileRoot"
            HorizontalAlignment="Right"
            CornerRadius="9"
            ClipToBounds="True"
            Focusable="True"
            KeyboardNavigation.IsTabStop="True"
            Cursor="Hand"
            ToolTip="{Binding FileName}"
            ContextMenu="{StaticResource ShelfItemOverflowMenu}"
            PreviewKeyDown="OnRowPreviewKeyDown"
            AutomationProperties.Name="{Binding FileName}"
            AutomationProperties.HelpText="Open or drag this capture; hover for actions">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SwipeTranslate" X="0" />
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="ThumbHost"
              Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
              Focusable="True"
              KeyboardNavigation.IsTabStop="False"
              AutomationProperties.Name="Open or drag capture"
              AutomationProperties.HelpText="Press Enter or Space on the capture to open it"
              PreviewKeyDown="OnRowPreviewKeyDown"
              MouseLeftButtonDown="OnThumbMouseDown"
              MouseMove="OnThumbMouseMove"
              MouseLeftButtonUp="OnThumbMouseUp"
              LostMouseCapture="OnThumbLostMouseCapture">
            <!-- Recordings do not always have an extracted poster frame. Keep a
                 deliberate video plate behind any future thumbnail so a completed
                 recording is never an easy-to-miss transparent card. -->
            <Grid Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}"
                  IsHitTestVisible="False"
                  AutomationProperties.Name="Screen recording preview">
                <Border Margin="12"
                        CornerRadius="8"
                        Background="{DynamicResource Octadock.Brush.GlassRowDense}"
                        BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                        BorderThickness="1" />
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            CornerRadius="17"
                            Background="{DynamicResource Octadock.Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                            BorderThickness="1">
                        <Polygon Points="0,0 0,13 11,6.5"
                                 Width="11"
                                 Height="13"
                                 Margin="2,0,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Octadock.Brush.Accent}" />
                    </Border>
                    <TextBlock Margin="0,5,0,0"
                               Text="Screen recording"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                </StackPanel>
            </Grid>

            <Image Source="{Binding Thumbnail}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="7"
                    Padding="6,3"
                    CornerRadius="6"
                    Background="{DynamicResource Octadock.Brush.GlassRail}"
                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="Film"
                                              Width="13" Height="13"
                                              Foreground="{DynamicResource Octadock.Brush.Text}" />
                    <TextBlock Text="{Binding DurationLabel}"
                               Margin="5,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Octadock.Brush.Text}" />
                </StackPanel>
            </Border>

            <Button Width="26"
                    Height="26"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding DiscardCommand}"
                    ToolTip="Remove from Shelf (keeps in History)"
                    AutomationProperties.Name="Remove from Shelf; keeps capture in History">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveSurface"
                                CornerRadius="13"
                                Background="{DynamicResource Octadock.Brush.GlassRail}"
                                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                                BorderThickness="1">
                            <icons:PackIconLucide Kind="X"
                                                  Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Octadock.Brush.Text}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Octadock.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RemoveSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource Octadock.Style.HoverActionButton.Compact}">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TileRoot}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Border x:Name="ActionRail"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Height="34"
                    Padding="4,3"
                    Background="{DynamicResource Octadock.Brush.GlassRail}"
                    BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseCompactOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TileRoot}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <UniformGrid Rows="1" Columns="4">
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Command="{Binding CopyCommand}"
                            ToolTip="{Binding CopyActionLabel}"
                            AutomationProperties.Name="{Binding CopyActionLabel}">
                        <icons:PackIconLucide Kind="Copy" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Command="{Binding AnnotateCommand}"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Annotate (crop, arrows, blur)"
                            AutomationProperties.Name="Annotate this capture">
                        <icons:PackIconLucide Kind="SquarePen" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Command="{Binding AddToContextCommand}"
                            ToolTip="{Binding ActiveContext.AddActionLabel}"
                            AutomationProperties.Name="{Binding ActiveContext.AddActionLabel}">
                        <icons:PackIconLucide Kind="PackagePlus" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="MoreButton"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            ContextMenu="{StaticResource ShelfItemOverflowMenu}"
                            ToolTip="More actions"
                            AutomationProperties.Name="More capture actions"
                            Click="OnMoreClick">
                        <icons:PackIconLucide Kind="Ellipsis" Width="16" Height="16" />
                    </Button>
                </UniformGrid>
            </Border>

            <!-- Short or narrow captures cannot carry a six-action bar without the
                 chrome becoming larger than the image. Keep one native overflow
                 affordance inside the real screenshot bounds instead. -->
            <Button x:Name="CompactMoreButton"
                    Width="24" Height="24"
                    Margin="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Octadock.Brush.GlassRail}"
                    ContextMenu="{StaticResource ShelfItemOverflowMenu}"
                    ToolTip="Capture actions"
                    AutomationProperties.Name="Capture actions"
                    Click="OnMoreClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Octadock.Style.HoverActionButton.Compact}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseCompactOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UseCompactOverlay}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UseCompactOverlay}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TileRoot}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <icons:PackIconLucide Kind="Ellipsis" Width="15" Height="15" />
            </Button>
        </Grid>
        </Border>
    </Grid>
</UserControl>
