<UserControl x:Class="Octadock.App.CaptureUx.ShelfItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
             mc:Ignorable="d"
             d:DesignWidth="214"
             d:DesignHeight="124"
             FontFamily="{DynamicResource Octadock.Font}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Secondary operations live in one menu; primary controls stay on the image. -->
        <ContextMenu x:Key="ShelfItemOverflowMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
            <Separator />
            <MenuItem Header="Copy image"
                      Command="{Binding CopyKeepCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Copy recording file"
                      Command="{Binding CopyFileCommand}"
                      Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Save" Command="{Binding SaveCommand}" />
            <MenuItem Header="Save as…" Command="{Binding SaveAsCommand}" />
            <MenuItem Header="Add to Context" Command="{Binding AddToContextCommand}" />
            <MenuItem Header="Local export…"
                      Command="{Binding UseWithAiCommand}"
                      CommandParameter="choose" />
            <Separator />
            <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}" />
            <Separator />
            <MenuItem Header="Flip horizontal"
                      Command="{Binding FlipHorizontalCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Flip vertical"
                      Command="{Binding FlipVerticalCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Rotate 90°"
                      Command="{Binding RotateCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Scale hi-DPI to 1×"
                      Command="{Binding ScaleToOneXCommand}"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="Remove from Shelf"
                      ToolTip="Keeps the capture in History and on disk"
                      Command="{Binding DiscardCommand}" />
            <MenuItem Header="Delete permanently…"
                      ToolTip="Deletes the file from disk and removes it from History. Cannot be undone."
                      Foreground="{DynamicResource Octadock.Brush.Danger}"
                      Command="{Binding DeletePermanentlyCommand}" />
        </ContextMenu>
        <Style x:Key="MediaAction" TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SwipeHost" Width="{Binding DisplayWidth, FallbackValue=196, TargetNullValue=196}"
          HorizontalAlignment="Right" ClipToBounds="True"
          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
        <Border x:Name="SwipeActionBackground" CornerRadius="12" Opacity="0" IsHitTestVisible="False"
                Background="{DynamicResource Octadock.Brush.AccentSoft}">
            <icons:PackIconLucide x:Name="SwipeActionIcon" Kind="Copy" Width="20" Height="20" Margin="16,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Octadock.Brush.Accent}" />
        </Border>
        <Border x:Name="TileRoot" CornerRadius="12" ClipToBounds="True" Focusable="True"
                KeyboardNavigation.IsTabStop="True" Cursor="Hand" ToolTip="{Binding FileName}"
                ContextMenu="{StaticResource ShelfItemOverflowMenu}" PreviewKeyDown="OnRowPreviewKeyDown"
                AutomationProperties.Name="{Binding FileName}"
                AutomationProperties.HelpText="Open or drag this capture. Copy, annotate and more actions are available on the image.">
            <Border.RenderTransform><TranslateTransform x:Name="SwipeTranslate" X="0" /></Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="ThumbHost" Height="{Binding DisplayHeight}" Focusable="True"
                  Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                  KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="Open or drag capture"
                  PreviewKeyDown="OnRowPreviewKeyDown" MouseLeftButtonDown="OnThumbMouseDown"
                  MouseMove="OnThumbMouseMove" MouseLeftButtonUp="OnThumbMouseUp"
                  LostMouseCapture="OnThumbLostMouseCapture">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Grid Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
                    <icons:PackIconLucide Kind="Play" Width="26" Height="26" Margin="0,0,0,26"
                                          Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                    <TextBlock Text="{Binding DurationLabel}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="9" FontSize="11" Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                </Grid>
                <!-- A compact control capsule floats on the content; no filename panel or card footer. -->
                <Border x:Name="ActionRail" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="6" Padding="3" CornerRadius="18" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                        Background="{DynamicResource Octadock.Brush.GlassRail}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MediaAction}" Command="{Binding CopyCommand}"
                                ToolTip="{Binding CopyActionLabel}" AutomationProperties.Name="{Binding CopyActionLabel}">
                            <icons:PackIconLucide Kind="Copy" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource MediaAction}" Command="{Binding AnnotateCommand}"
                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Annotate" AutomationProperties.Name="Annotate this capture">
                            <icons:PackIconLucide Kind="SquarePen" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource MediaAction}"
                                ContextMenu="{StaticResource ShelfItemOverflowMenu}" Click="OnMoreClick"
                                ToolTip="More actions" AutomationProperties.Name="More capture actions">
                            <icons:PackIconLucide Kind="Ellipsis" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Border>
                <Button Command="{Binding DiscardCommand}" Width="24" Height="24" Margin="6" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Remove from Shelf; keep in History" AutomationProperties.Name="Remove from Shelf; keeps capture in History">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
                            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRail}" />
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                    <Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TileRoot}" Value="True">
                                    <Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <icons:PackIconLucide Kind="X" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
