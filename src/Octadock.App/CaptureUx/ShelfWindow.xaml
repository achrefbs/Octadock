<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:local="clr-namespace:Octadock.App.CaptureUx"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock Shelf"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Background="Transparent"
        AutomationProperties.Name="Capture Shelf">

    <Grid x:Name="ShelfRoot">
        <!-- The fixed-width strip is exactly the tab width. Expanded and
             collapsed layouts therefore share the same physical screen corner. -->
        <Border x:Name="ShelfChrome"
                Width="{Binding ShellWidth, FallbackValue=204, TargetNullValue=204}"
                Margin="32,0,0,0"
                Padding="6"
                CornerRadius="12"
                Background="{DynamicResource Octadock.Brush.GlassSurface}"
                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                BorderThickness="1"
                Effect="{StaticResource Octadock.Shadow.Floating}"
                Opacity="1"
                RenderTransformOrigin="0,1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ShelfScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ShelfTranslate" X="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Remove all captures from Shelf" Click="OnClearAll" />
                    <MenuItem Header="Shelf settings" Click="OnOpenSettings" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid KeyboardNavigation.TabNavigation="Continue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Height="28"
                      Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Captures"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Octadock.Brush.Text}" />
                        <Border Margin="6,0,0,0"
                                Padding="6,1"
                                CornerRadius="7"
                                Background="{DynamicResource Octadock.Brush.GlassRail}">
                            <TextBlock Text="{Binding Items.Count}"
                                       Style="{StaticResource Octadock.Text.Micro}" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="22"
                            Height="22"
                            Margin="0,0,2,0"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            ToolTip="Remove all from Shelf (keeps in History)"
                            AutomationProperties.Name="Remove all from Shelf; keeps captures in History"
                            Click="OnClearAll">
                        <icons:PackIconLucide Kind="X" Width="12" Height="12" />
                    </Button>
                    <Button Grid.Column="2"
                            Width="22"
                            Height="22"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            ToolTip="Shelf settings"
                            AutomationProperties.Name="Shelf settings"
                            Click="OnOpenSettings">
                        <icons:PackIconLucide Kind="Settings2" Width="12" Height="12" />
                    </Button>
                </Grid>

                <!-- Secondary capture modes move here from the crowded Dock. The
                     shared catalog owns labels, icons, tooltips, and automation. -->
                <Border x:Name="CaptureActionStrip"
                        Grid.Row="1"
                        Height="34"
                        Margin="0,0,0,7"
                        Padding="2"
                        CornerRadius="10"
                        Background="{DynamicResource Octadock.Brush.GlassRail}"
                        AutomationProperties.Name="Additional capture modes">
                    <ItemsControl ItemsSource="{Binding CaptureActions, RelativeSource={RelativeSource AncestorType={x:Type local:ShelfWindow}}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30"
                                        Height="30"
                                        Margin="0"
                                        Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Click="OnCaptureActionClick">
                                    <icons:PackIconLucide Kind="{Binding Icon}"
                                                          Width="14"
                                                          Height="14" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ScrollViewer Grid.Row="2"
                              MaxHeight="432"
                              Padding="0"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              AutomationProperties.Name="Recent captures">
                    <ItemsControl x:Name="CardHost" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel x:Name="CardStack" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ShelfItemView HorizontalAlignment="Right" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Small attached edge tab: one stable affordance, no drag/fade/move
             modes. It is keyboard reachable and keeps its anchored screen point. -->
        <Button x:Name="PeekButton"
                Width="32"
                Height="32"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                ToolTip="Hide capture Shelf"
                AutomationProperties.Name="Hide capture Shelf"
                Click="OnPeekClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TabGlass"
                            Width="22"
                            Height="30"
                            CornerRadius="7,0,0,7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Octadock.Brush.GlassSurface}"
                            BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                            BorderThickness="1"
                            Opacity="0.88">
                        <Grid>
                            <Border x:Name="TabStateLayer"
                                    CornerRadius="7"
                                    Background="{DynamicResource Octadock.Brush.State.Hover}"
                                    Opacity="0" />
                            <icons:PackIconLucide x:Name="PeekIcon"
                                                  Kind="ChevronRight"
                                                  Width="12"
                                                  Height="12"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                            <Ellipse x:Name="PeekIndicator"
                                     Width="4"
                                     Height="4"
                                     Margin="0,0,0,3"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Fill="{DynamicResource Octadock.Brush.Accent}"
                                     Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabGlass" Property="Opacity" Value="1" />
                            <Setter TargetName="TabStateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TabStateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.State.Pressed}" />
                            <Setter TargetName="TabStateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabGlass" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.State.Focus}" />
                            <Setter TargetName="TabGlass" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</windows:ToolWindowBase>
