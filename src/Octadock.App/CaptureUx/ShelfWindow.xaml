<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:local="clr-namespace:Octadock.App.CaptureUx"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock Shelf"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Background="Transparent"
        AutomationProperties.Name="Capture Shelf">

    <windows:ToolWindowBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </windows:ToolWindowBase.Resources>

    <Grid x:Name="ShelfRoot">
        <!-- Screen-only is the default. The optional frame is a user-controlled
             presentation mode, never a requirement for accessing Shelf actions. -->
        <Border x:Name="ShelfChrome"
            Width="{Binding CardWidth, FallbackValue=196, TargetNullValue=196}"
            Margin="32,0,0,0"
            Opacity="1"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShelfScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="ShelfTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowChrome}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassSurface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="Padding" Value="6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Clear all captures from Shelf" Click="OnClearAll" />
                <MenuItem Header="Shelf settings" Click="OnOpenSettings" />
            </ContextMenu>
        </Border.ContextMenu>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.14" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid KeyboardNavigation.TabNavigation="Continue">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="32"
                  Margin="2,0"
                  Visibility="{Binding ShowChrome, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <icons:PackIconLucide Grid.Column="0"
                                      Kind="Images"
                                      Width="15" Height="15"
                                      Margin="3,0,6,0"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
                <TextBlock Grid.Column="1"
                           Text="Shelf"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Octadock.Brush.Text}" />
                <TextBlock Grid.Column="2"
                           Margin="6,0,0,0"
                           Text="{Binding Items.Count}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Octadock.Text.Micro}" />
                <Button Grid.Column="3"
                        Width="24" Height="24"
                        Style="{StaticResource Octadock.Style.HoverActionButton}"
                        ToolTip="Remove all from Shelf (keeps in History)"
                        AutomationProperties.Name="Remove all from Shelf; keeps captures in History"
                        Click="OnClearAll">
                    <icons:PackIconLucide Kind="X" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="4"
                        Width="24" Height="24"
                        Style="{StaticResource Octadock.Style.HoverActionButton}"
                        ToolTip="Shelf settings"
                        AutomationProperties.Name="Shelf settings"
                        Click="OnOpenSettings">
                    <icons:PackIconLucide Kind="Settings2" Width="12" Height="12" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="0,0,0,5"
                    Background="{DynamicResource Octadock.Brush.GlassBorder}"
                    Visibility="{Binding ShowChrome, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer Grid.Row="2"
                          MaxHeight="440"
                          Padding="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          AutomationProperties.Name="Recent captures">
                <ItemsControl x:Name="CardHost" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="CardStack" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                 From="6" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <local:ShelfItemView HorizontalAlignment="Right" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Border>

        <!-- This edge tab shares the Shelf's configured corner, so changing the
             card visibility never moves the control to a different screen point. -->
        <Button x:Name="PeekButton"
                Width="32"
                Height="40"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                ToolTip="Hide capture Shelf"
                AutomationProperties.Name="Hide capture Shelf"
                Click="OnPeekClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TabGlass"
                            CornerRadius="10"
                            Background="{DynamicResource Octadock.Brush.GlassSurface}"
                            BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                            BorderThickness="1"
                            Opacity="0.84">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <icons:PackIconLucide x:Name="PeekIcon"
                                                  Kind="ChevronRight"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
                            <TextBlock x:Name="PeekCount"
                                       Grid.Column="1"
                                       Margin="3,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabGlass" Property="Opacity" Value="1" />
                            <Setter TargetName="TabGlass" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</windows:ToolWindowBase>
