<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:local="clr-namespace:Octadock.App.CaptureUx"
        Title="Octadock Shelf"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <!--
        The shelf stacks cards vertically: the newest (active) card is visually
        emphasized (accent ring), older cards trail behind it. Ordering is driven by
        the anchor in code — for bottom anchors the newest card sits at the bottom
        (nearest the corner), for top anchors it sits at the top. Each item is a
        ShelfItemView bound to a ShelfItemViewModel.
    -->
    <Border x:Name="ShelfChrome"
            Padding="6"
            Background="Transparent">
        <ItemsControl x:Name="CardHost" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel x:Name="CardStack" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,4" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Constant 2px border (Transparent by default) so activating a
                         card only swaps the brush and never shifts the stack layout. -->
                    <Border CornerRadius="10" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Card entrance: fade + slide-up so new captures animate in. -->
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="14" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <local:ShelfItemView />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</windows:ToolWindowBase>
