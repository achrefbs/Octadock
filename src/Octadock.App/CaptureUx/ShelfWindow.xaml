<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:local="clr-namespace:Octadock.App.CaptureUx"
        Title="Octadock Shelf"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <!--
        The shelf is a small floating tray, not a metadata browser. It stacks
        image-only tiles; actions live on each tile's hover overlay. Utility
        commands are in the context menu so the resting state is just captures.
    -->
    <Border x:Name="ShelfChrome"
            Background="Transparent"
            Padding="0">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Clear all" Click="OnClearAll" />
                <MenuItem Header="Shelf settings" Click="OnOpenSettings" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Image tiles. -->
            <ScrollViewer Grid.Row="0"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CardHost" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="CardStack" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,4" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card entrance: fade + slide-up so new captures animate in.
                                 Active-row styling lives inside ShelfItemView. -->
                            <Border SnapsToDevicePixels="True" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                 From="14" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <local:ShelfItemView />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</windows:ToolWindowBase>
