<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.WindowPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        Title="Octadock Window Picker"
        Cursor="Cross"
        FocusManager.IsFocusScope="True">

    <windows:ToolWindowBase.Resources>
        <SolidColorBrush x:Key="Picker.Dim" Color="#40000000" />
        <SolidColorBrush x:Key="Picker.Accent" Color="#FF2DD4BF" />
        <SolidColorBrush x:Key="Picker.Fill" Color="#332DD4BF" />
        <SolidColorBrush x:Key="Picker.Chip" Color="#E6151F2B" />
        <SolidColorBrush x:Key="Picker.ChipText" Color="#FFF1F5F9" />
        <SolidColorBrush x:Key="Picker.ChipMuted" Color="#FF9AA7B4" />
    </windows:ToolWindowBase.Resources>

    <Grid Background="{StaticResource Picker.Dim}">
        <Canvas x:Name="Overlay" ClipToBounds="False">
            <!-- Highlight of the candidate window under the cursor. -->
            <Rectangle x:Name="Highlight"
                       Stroke="{StaticResource Picker.Accent}"
                       StrokeThickness="3"
                       Fill="{StaticResource Picker.Fill}"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- Title / process label. -->
            <Border x:Name="Label"
                    Background="{StaticResource Picker.Chip}"
                    CornerRadius="6"
                    Padding="10,6"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource Picker.ChipText}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               Text="Window" />
                    <TextBlock x:Name="ProcessText"
                               Foreground="{StaticResource Picker.ChipMuted}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="11"
                               Text="process" />
                </StackPanel>
            </Border>

            <!-- Hint. -->
            <Border x:Name="Hint"
                    Background="{StaticResource Picker.Chip}"
                    CornerRadius="6"
                    Padding="12,8"
                    IsHitTestVisible="False">
                <TextBlock Foreground="{StaticResource Picker.ChipText}"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="13"
                           Text="Click a window to capture it  &#8226;  Esc to cancel" />
            </Border>
        </Canvas>
    </Grid>
</windows:ToolWindowBase>
