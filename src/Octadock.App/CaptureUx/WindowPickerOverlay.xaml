<windows:ToolWindowBase x:Class="Octadock.App.CaptureUx.WindowPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        Title="Octadock Window Picker"
        Cursor="Cross"
        FocusManager.IsFocusScope="True">

    <Grid Background="{DynamicResource Octadock.Brush.CapturePickerDim}">
        <Canvas x:Name="Overlay" ClipToBounds="False">
            <!-- Highlight of the candidate window under the cursor. -->
            <Rectangle x:Name="Highlight"
                       Stroke="{DynamicResource Octadock.Brush.Accent}"
                       StrokeThickness="3"
                       Fill="{DynamicResource Octadock.Brush.CaptureHighlightFill}"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- Title / process label. -->
            <Border x:Name="Label"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    CornerRadius="6"
                    Padding="10,6"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               Text="Window" />
                    <TextBlock x:Name="ProcessText"
                               Foreground="{DynamicResource Octadock.Brush.CaptureChipMuted}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="11"
                               Text="process" />
                </StackPanel>
            </Border>

            <!-- Hint. -->
            <Border x:Name="Hint"
                    Background="{DynamicResource Octadock.Brush.CaptureChip}"
                    CornerRadius="6"
                    Padding="12,8"
                    IsHitTestVisible="False">
                <TextBlock Foreground="{DynamicResource Octadock.Brush.CaptureChipText}"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="13"
                           Text="Click a window to capture it  &#8226;  Esc to cancel" />
            </Border>
        </Canvas>
    </Grid>
</windows:ToolWindowBase>
