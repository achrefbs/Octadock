<Window x:Class="Octadock.App.Clipboard.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Octadock Clipboard"
        Width="720"
        Height="640"
        MinWidth="480"
        MinHeight="380"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header: search + monitor toggle + clear ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Padding="8,6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="Search clip text, source app, or window title" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <CheckBox Content="Watch clipboard"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Octadock.Brush.Text}"
                          IsChecked="{Binding MonitorEnabled, Mode=OneWay}"
                          Command="{Binding ToggleMonitorCommand}"
                          ToolTip="Record new copies into the local history" />
                <Button Style="{StaticResource Octadock.Style.DangerButton}"
                        Margin="10,0,0,0"
                        Content="Clear all…"
                        Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============ Filter chips ============ -->
        <ListBox Grid.Row="1"
                 Margin="0,0,0,10"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chip"
                                        Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,5">
                                    <ContentPresenter Content="{Binding Label}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                        <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{DynamicResource Octadock.Brush.AccentText}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- ============ Clip list ============ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ListBox x:Name="ClipList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         MouseDoubleClick="OnItemDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="{DynamicResource Octadock.Brush.Surface}"
                                                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Kind glyph or thumbnail -->
                                <Grid Grid.Column="0" Width="56" Height="44" Margin="0,0,10,0">
                                    <Border Background="#22000000" CornerRadius="6" />
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,56,44" RadiusX="6" RadiusY="6" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>

                                <!-- Snippet + provenance -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TextSnippet}"
                                               Style="{StaticResource Octadock.Text.Body}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding SizeLabel}"
                                               Style="{StaticResource Octadock.Text.Body}"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   Style="{StaticResource Octadock.Text.Muted}"
                                                   FontSize="11"
                                                   MaxWidth="330"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="  ·  "
                                                   Style="{StaticResource Octadock.Text.Muted}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   Style="{StaticResource Octadock.Text.Muted}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Octadock.Style.IconButton}"
                                            Content="&#xE8C8;"
                                            FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Copy to clipboard"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Favorite (kept when history is trimmed)"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
                                                <Setter Property="Content" Value="&#xE734;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Content" Value="&#xE735;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource Octadock.Style.IconButton}"
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Delete permanently"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                           IsHitTestVisible="False"
                           Opacity="0.7" />
            </Grid>
        </Border>

        <!-- ============ Footer ============ -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                       Style="{StaticResource Octadock.Text.Muted}"
                       Text="{Binding StatusMessage}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           FontSize="11"
                           Text="Double-click a clip to copy it" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="Load more"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
