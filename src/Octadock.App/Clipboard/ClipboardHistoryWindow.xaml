<Window x:Class="Octadock.App.Clipboard.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock Clipboard"
        Width="476"
        Height="560"
        MinWidth="440"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource Octadock.Brush.Surface}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="Octadock clipboard history">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Clip.Filter" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Height="27"
                                Padding="10,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Octadock.Corner.Full}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Content="{Binding Label}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Clip.Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                MinHeight="64"
                                Padding="10,7"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Margin="0"
            Style="{StaticResource Octadock.Style.FloatingGlassShell}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.98" To="1" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.98" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="1" />
                <RowDefinition Height="48" />
                <RowDefinition Height="36" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Octadock.Brush.GlassChrome}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="11,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <icons:PackIconLucide Kind="Clipboard" Width="16" Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Octadock.Brush.Accent}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                               Text="Clipboard" VerticalAlignment="Center"
                               Style="{StaticResource Octadock.Text.Subtitle}" />
                    <Border Grid.Column="2" Margin="7,0,0,0" Padding="6,1"
                            VerticalAlignment="Center"
                            Style="{StaticResource Octadock.Style.CountPill}">
                        <TextBlock Text="{Binding Items.Count}"
                                   Style="{StaticResource Octadock.Text.Micro}"
                                   Foreground="{DynamicResource Octadock.Brush.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Octadock.Brush.TextDisabled}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonitorEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Octadock.Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Padding="6,3"
                                Content="Watching"
                                Style="{StaticResource Octadock.Style.GlassChromeButton}"
                                Command="{Binding ToggleMonitorCommand}"
                                ToolTip="Toggle clipboard monitoring"
                                AutomationProperties.Name="Toggle clipboard monitoring" />
                    </StackPanel>
                    <Button Grid.Column="5" Width="28" Height="28" Margin="5,0,0,0"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Click="OnClose"
                            ToolTip="Close"
                            AutomationProperties.Name="Close clipboard history">
                        <icons:PackIconLucide Kind="X" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource Octadock.Brush.GlassBorder}" />

            <Grid Grid.Row="2" Margin="10,7,10,5">
                <TextBox Padding="32,6,30,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                         Style="{StaticResource Octadock.Style.TextBox}"
                         AutomationProperties.Name="Search clipboard history" />
                <icons:PackIconLucide Kind="Search" Width="14" Height="14"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
                <Button Width="25" Height="25" Margin="0,0,3,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                        Click="OnClearSearch"
                        ToolTip="Clear search"
                        AutomationProperties.Name="Clear clipboard search">
                    <icons:PackIconLucide Kind="X" Width="12" Height="12" />
                </Button>
            </Grid>

            <ListBox Grid.Row="3"
                     Margin="10,0,10,7"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter}"
                     ItemContainerStyle="{StaticResource Clip.Filter}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Border Grid.Row="4" Background="{DynamicResource Octadock.Brush.GlassBorder}" />

            <Grid Grid.Row="5">
                <ListBox x:Name="ClipList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         ItemContainerStyle="{StaticResource Clip.Row}"
                         MouseDoubleClick="OnItemDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource Octadock.Brush.GlassRow}"
                                        CornerRadius="9" ClipToBounds="True">
                                    <Grid>
                                        <icons:PackIconLucide Kind="FileText" Width="15" Height="15"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Octadock.Brush.TextSecondaryStrong}"
                                                              Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TextSnippet}"
                                               MaxHeight="38"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Octadock.Text.Body}"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding SizeLabel}"
                                               Style="{StaticResource Octadock.Text.Body}"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   MaxWidth="190"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Octadock.Text.Micro}" />
                                        <TextBlock Text=" · " Style="{StaticResource Octadock.Text.Micro}" />
                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Octadock.Text.Micro}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="ActionRail"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Opacity="0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Copy"
                                            AutomationProperties.Name="Copy clip">
                                        <icons:PackIconLucide Kind="Copy" Width="13" Height="13" />
                                    </Button>
                                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Favorite"
                                            AutomationProperties.Name="Toggle favorite">
                                        <icons:PackIconLucide Kind="Star" Width="13" Height="13" />
                                    </Button>
                                    <Button Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                                            Foreground="{DynamicResource Octadock.Brush.Danger}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete"
                                            AutomationProperties.Name="Delete clip">
                                        <icons:PackIconLucide Kind="Trash2" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">
                    <icons:PackIconLucide Kind="ClipboardX" Width="24" Height="24"
                                          HorizontalAlignment="Center"
                                          Foreground="{DynamicResource Octadock.Brush.TextDisabled}" />
                    <TextBlock Margin="0,7,0,0" MaxWidth="260"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center"
                               Style="{StaticResource Octadock.Text.Caption}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="6"
                    Background="{DynamicResource Octadock.Brush.GlassChrome}">
                <Grid Margin="11,0,8,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Octadock.Text.Micro}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Height="26"
                                Padding="8,0"
                                Content="Clear"
                                Style="{StaticResource Octadock.Style.GlassFooterAction}"
                                Command="{Binding ClearAllCommand}"
                                ToolTip="Permanently clear clipboard history"
                                AutomationProperties.Name="Clear clipboard history" />
                        <Button Height="26"
                                Padding="8,0"
                                Margin="5,0,0,0"
                                Content="More"
                                Style="{StaticResource Octadock.Style.GlassFooterAction}"
                                Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
