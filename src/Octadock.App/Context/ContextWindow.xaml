<Window x:Class="Octadock.App.Context.ContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context"
        Width="360"
        MinWidth="340"
        MaxHeight="540"
        SizeToContent="Height"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border x:Name="StackRoot"
            Margin="8"
            Style="{StaticResource Octadock.Style.FloatingGlassShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="10,8,8,6"
                  MouseLeftButtonDown="OnDragHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE8F4;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Octadock.Brush.Accent}" />

                <Grid Grid.Column="1"
                      Margin="8,0,6,0"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Context stack"
                               Foreground="{DynamicResource Octadock.Brush.Text}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedItemCountLabel}"
                               Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasPackages, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Button Grid.Column="2"
                        Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                        Content="&#xE710;"
                        ToolTip="New stack"
                        Click="OnNewPackage" />

                <Button Grid.Column="3"
                        Margin="2,0,0,0"
                        Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                        Content="&#xE711;"
                        ToolTip="Close"
                        Click="OnClose" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="8,0,8,6"
                    Style="{StaticResource Octadock.Style.GlassRail}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Content="&#xE76B;"
                            ToolTip="Previous stack"
                            IsEnabled="{Binding CanNavigatePackages}"
                            Click="OnPreviousPackage" />

                    <TextBlock Grid.Column="1"
                               Margin="6,0"
                               Text="{Binding SelectedPackage.Name, FallbackValue='No stacks yet', TargetNullValue='No stacks yet'}"
                               Foreground="{DynamicResource Octadock.Brush.Text}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Margin="4,0"
                               Text="{Binding PackagePositionLabel}"
                               Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="3"
                            Style="{StaticResource Octadock.Style.HoverActionButton.Compact}"
                            Content="&#xE76C;"
                            ToolTip="Next stack"
                            IsEnabled="{Binding CanNavigatePackages}"
                            Click="OnNextPackage" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="8,0,8,0">
                <ScrollViewer MaxHeight="244"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemHost" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,5" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemRow"
                                        Style="{StaticResource Octadock.Style.GlassRowDense}"
                                        Cursor="Hand"
                                        ToolTip="Open"
                                        MouseLeftButtonUp="OnOpenItemRow">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE8A5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="9,0,8,0"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource Octadock.Brush.Text}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Width="26"
                                                Height="26"
                                                Style="{StaticResource Octadock.Style.HoverActionButton}"
                                                Content="&#xE74D;"
                                                ToolTip="Remove"
                                                Foreground="{DynamicResource Octadock.Brush.Danger}"
                                                Click="OnRemoveItemRow">
                                            <Button.Visibility>
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Border}" Converter="{StaticResource BoolToVisibility}" />
                                            </Button.Visibility>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Padding="12,11">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Octadock.Style.GlassRowDense}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ItemHost}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE8F4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   Opacity="0.75" />
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   Text="No items"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="8,6,8,8"
                    Style="{StaticResource Octadock.Style.GlassRail}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Octadock.Style.GlassFooterAction}"
                            Content="Add file"
                            Click="OnAddFile" />
                    <Button Grid.Column="2"
                            Style="{StaticResource Octadock.Style.GlassFooterAction}"
                            Content="Export"
                            Click="OnExport" />
                    <Button Grid.Column="3"
                            Margin="2,0,0,0"
                            Style="{StaticResource Octadock.Style.GlassFooterAction}"
                            Content="Delete"
                            Foreground="{DynamicResource Octadock.Brush.Danger}"
                            Click="OnDeletePackage" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="4"
                       Margin="11,0,11,9"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</Window>
