<Window x:Class="Octadock.App.Context.ContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="440"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource Octadock.Style.TextBox}" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: a distinct identity from the Capture Shelf. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="30" Height="30"
                    CornerRadius="{StaticResource Octadock.Corner}"
                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE8F4;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Title}" Text="Context" />
                <TextBlock Style="{StaticResource Octadock.Text.Muted}"
                           Text="Bundle captures and files to hand off. A separate surface from the Capture Shelf — nothing here is AI." />
            </StackPanel>
        </StackPanel>

        <!-- New package row -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="New package name" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="120"
                    Content="New package"
                    Style="{StaticResource Octadock.Style.AccentButton}"
                    Click="OnNewPackage" />
        </Grid>

        <!-- Packages | items -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Octadock.Style.Card}" Padding="6">
                <ListBox x:Name="PackageList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Packages}"
                         SelectedItem="{Binding SelectedPackage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Style="{StaticResource Octadock.Text.Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Octadock.Text.Muted}"
                                           Text="{Binding Items.Count, StringFormat='{}{0} item(s)'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Octadock.Style.Card}" Padding="6">
                    <ListView x:Name="ItemList"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                                <GridViewColumn Header="Ownership" Width="100" DisplayMemberBinding="{Binding Ownership}" />
                                <GridViewColumn Header="Derivatives" Width="90" DisplayMemberBinding="{Binding Derivatives.Count}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add file…" Style="{StaticResource Octadock.Style.ToolButton}" Click="OnAddFile" />
                    <Button Content="Remove item" Margin="6,0,0,0" Style="{StaticResource Octadock.Style.ToolButton}" Click="OnRemoveItem" />
                    <Button Content="Export…" Margin="6,0,0,0" Style="{StaticResource Octadock.Style.AccentButton}" Click="OnExport" />
                    <Button Content="Delete package" Margin="6,0,0,0" Style="{StaticResource Octadock.Style.DangerButton}" Click="OnDeletePackage" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Style="{StaticResource Octadock.Text.Muted}"
                   Text="{Binding StatusMessage}" />
    </Grid>
</Window>
