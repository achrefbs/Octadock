<Window x:Class="Octadock.App.Editing.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.Editing"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="{Binding Title}"
        Width="1080"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:ToolGlyphConverter x:Key="ToolGlyph" />
        <local:ToolLabelConverter x:Key="ToolLabel" />
        <local:ToolIsActiveConverter x:Key="ToolIsActive" />

        <!-- A toggle-style tool button. Highlights when it is the active tool. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
        </Style>

        <!-- Slim divider used between the island's groups. -->
        <Style x:Key="IslandSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===================== Canvas (fills the window) ===================== -->
        <Border Background="{DynamicResource Octadock.Brush.Surface}" ClipToBounds="True">
            <Grid x:Name="CanvasHost" Margin="16">
                <!-- EditorCanvas is added in code-behind so it can receive the base image. -->
            </Grid>
        </Border>

        <!-- ===================== Floating glass tool island =====================
             One compact island holds the whole flow: draw/circle/arrow/note with a
             small callout palette, undo/redo/clear, and save/copy/share. Rarely
             used document actions live in the trailing overflow menu. -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="6"
                CornerRadius="14"
                Background="{DynamicResource Octadock.Brush.GlassSurface}"
                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                BorderThickness="1"
                Effect="{StaticResource Octadock.Shadow.Floating}"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform Y="-6" />
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="{StaticResource Octadock.Motion.Duration.Fast}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                             From="-6" To="0" Duration="{StaticResource Octadock.Motion.Duration.Normal}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel Orientation="Horizontal">
                <!-- Tools -->
                <ItemsControl ItemsSource="{Binding Tools}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="1,0"
                                    ToolTip="{Binding Converter={StaticResource ToolLabel}}"
                                    AutomationProperties.Name="{Binding Converter={StaticResource ToolLabel}}"
                                    Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <icons:PackIconLucide Kind="{Binding Converter={StaticResource ToolGlyph}}"
                                                      Width="{StaticResource Octadock.Icon.Size.16}"
                                                      Height="{StaticResource Octadock.Icon.Size.16}" />
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                        <Style.Triggers>
                                            <!-- Strong contrast for the active tool. -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource ToolIsActive}">
                                                        <Binding Path="DataContext.ActiveTool" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource IslandSeparator}" />

                <!-- Callout palette -->
                <ItemsControl ItemsSource="{Binding CompactPalette}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="18" Height="18" Margin="2,0" Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding Hex}"
                                    AutomationProperties.Name="{Binding Hex, StringFormat=Choose color {0}}"
                                    Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource IslandSeparator}" />

                <!-- History -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding UndoCommand}"
                        ToolTip="Undo (Ctrl+Z)"
                        AutomationProperties.Name="Undo">
                    <icons:PackIconLucide Kind="Undo2" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding RedoCommand}"
                        ToolTip="Redo (Ctrl+Y)"
                        AutomationProperties.Name="Redo">
                    <icons:PackIconLucide Kind="Redo2" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding ClearAnnotationsCommand}"
                        ToolTip="Clear all annotations (undoable)"
                        AutomationProperties.Name="Clear all annotations">
                    <icons:PackIconLucide Kind="Trash2" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>

                <Border Style="{StaticResource IslandSeparator}" />

                <!-- Finish -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save project (Ctrl+S)"
                        AutomationProperties.Name="Save project">
                    <icons:PackIconLucide Kind="Save" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding CopyCommand}"
                        ToolTip="Copy image (Ctrl+C)"
                        AutomationProperties.Name="Copy image">
                    <icons:PackIconLucide Kind="Copy" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
                <Button x:Name="ShareButton"
                        Style="{StaticResource ToolButton}"
                        Click="OnShare"
                        ToolTip="Share — prepare a reviewed handoff with a local agent"
                        AutomationProperties.Name="Share; prepare a reviewed handoff with a local agent">
                    <icons:PackIconLucide Kind="Share2" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
                <Button x:Name="MoreButton"
                        Style="{StaticResource ToolButton}"
                        Click="OnMoreClick"
                        ToolTip="More — export, save as, AI mockup"
                        AutomationProperties.Name="More editor actions">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export image…" Command="{Binding ExportCommand}" />
                            <MenuItem Header="Save project as…" Command="{Binding SaveAsCommand}" />
                            <MenuItem Header="Create AI mockup from selected area…" Click="OnCreateMockup" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <icons:PackIconLucide Kind="Ellipsis" Width="{StaticResource Octadock.Icon.Size.16}" Height="{StaticResource Octadock.Icon.Size.16}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
