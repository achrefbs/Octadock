<Window x:Class="Octadock.App.Editing.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.Editing"
        Title="{Binding Title}"
        Width="1080"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.Surface}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:ToolGlyphConverter x:Key="ToolGlyph" />
        <local:ToolLabelConverter x:Key="ToolLabel" />
        <local:ToolIsActiveConverter x:Key="ToolIsActive" />

        <!-- A toggle-style tool button. Highlights when it is the active tool. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Toolbar ===================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel LastChildFill="False">

                <!-- Tools -->
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Tools}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="1,0"
                                    Content="{Binding Converter={StaticResource ToolGlyph}}"
                                    ToolTip="{Binding Converter={StaticResource ToolLabel}}"
                                    Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                        <Style.Triggers>
                                            <!-- Highlight the button whose tool is active. -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource ToolIsActive}">
                                                        <Binding Path="DataContext.ActiveTool" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Left" Margin="8,4" Width="1" Background="{DynamicResource Octadock.Brush.Border}" />

                <!-- Color swatches -->
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Palette}" VerticalAlignment="Center" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="22" Height="22" Margin="2,0" Cursor="Hand"
                                    ToolTip="{Binding Hex}"
                                    Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button DockPanel.Dock="Left" Style="{StaticResource Octadock.Style.ToolButton}"
                        Margin="4,0" Content="Color…" Click="OnPickStrokeColor"
                        ToolTip="Pick a custom stroke color" />
                <Button DockPanel.Dock="Left" Style="{StaticResource Octadock.Style.ToolButton}"
                        Margin="0,0" Content="Fill…" Click="OnPickFillColor"
                        ToolTip="Pick a custom fill color (or clear)" />

                <!-- Line width -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource Octadock.Text.Muted}" />
                    <Slider Width="90" Minimum="1" Maximum="40" VerticalAlignment="Center"
                            Value="{Binding LineWidth}" />
                </StackPanel>

                <!-- Font size -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource Octadock.Text.Muted}" />
                    <Slider Width="90" Minimum="8" Maximum="96" VerticalAlignment="Center"
                            Value="{Binding FontSize}" />
                </StackPanel>

                <!-- Right-aligned document actions -->
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.AccentButton}"
                        Margin="6,0,0,0" Content="Export…" Command="{Binding ExportCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="Save As…" Command="{Binding SaveAsCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="Save" Command="{Binding SaveCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="Copy" Command="{Binding CopyCommand}" />
                <Border DockPanel.Dock="Right" Margin="6,2,6,2" Padding="8,4" Cursor="SizeAll"
                        Background="{DynamicResource Octadock.Brush.Surface}"
                        BorderBrush="{DynamicResource Octadock.Brush.Border}"
                        BorderThickness="1" CornerRadius="4"
                        ToolTip="Drag out to another app"
                        MouseLeftButtonDown="OnDragHandleMouseDown">
                    <TextBlock Text="⇲ Drag" Style="{StaticResource Octadock.Text.Muted}" />
                </Border>
                <Border DockPanel.Dock="Right" Width="1" Margin="6,4" Background="{DynamicResource Octadock.Brush.Border}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="↷" FontSize="16" Command="{Binding RedoCommand}" ToolTip="Redo" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="↶" FontSize="16" Command="{Binding UndoCommand}" ToolTip="Undo" />
            </DockPanel>
        </Border>

        <!-- ===================== Canvas ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource Octadock.Brush.Surface}" ClipToBounds="True">
            <Grid x:Name="CanvasHost" Margin="16">
                <!-- EditorCanvas is added in code-behind so it can receive the base image. -->
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Octadock.Text.Muted}"
                           Text="{Binding ActiveTool, Converter={StaticResource ToolLabel}, StringFormat='Tool: {0}'}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Octadock.Text.Muted}"
                           Text="Del removes selection · Ctrl+Z undo · Ctrl+Y redo · Ctrl+S save" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
