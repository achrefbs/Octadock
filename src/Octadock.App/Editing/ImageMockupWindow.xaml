<Window x:Class="Octadock.App.Editing.ImageMockupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI image mockup"
        Width="900" Height="650" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Make a visual variant" Style="{StaticResource Octadock.Text.Title}" />
                <TextBlock x:Name="RegionText" Margin="0,4,0,0"
                           Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="10"
                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Octadock.Brush.Accent}" BorderThickness="1">
                <TextBlock x:Name="ProviderText" Style="{StaticResource Octadock.Text.Micro}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="12" Padding="8"
                    Background="{DynamicResource Octadock.Brush.Surface}"
                    BorderBrush="{DynamicResource Octadock.Brush.Border}" BorderThickness="1">
                <Grid>
                    <Image x:Name="BeforeImage" Stretch="Uniform" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="8,4"
                            CornerRadius="7" Background="{DynamicResource Octadock.Brush.MediaLabel}">
                        <TextBlock Text="ORIGINAL" Foreground="{DynamicResource Octadock.Brush.MediaLabelText}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="12" Padding="8"
                    Background="{DynamicResource Octadock.Brush.Surface}"
                    BorderBrush="{DynamicResource Octadock.Brush.Border}" BorderThickness="1">
                <Grid>
                    <Image x:Name="AfterImage" Stretch="Uniform" />
                    <TextBlock x:Name="EmptyPreviewText" Text="Your variant appears here"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="8,4"
                            CornerRadius="7" Background="{DynamicResource Octadock.Brush.MediaLabel}">
                        <TextBlock Text="VARIANT" Foreground="{DynamicResource Octadock.Brush.MediaLabelText}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="2,14,2,12">
            <TextBlock Text="Describe the exact change" Style="{StaticResource Octadock.Text.Subtitle}" />
            <TextBox x:Name="InstructionBox" MinHeight="68" MaxHeight="110" Margin="0,7,0,8"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Image mockup instruction" />
            <CheckBox x:Name="ConsentBox" Checked="OnInputChanged" Unchecked="OnInputChanged"
                      AutomationProperties.Name="Consent to send the source image to the selected provider"
                      Foreground="{DynamicResource Octadock.Brush.TextSecondary}">
                <TextBlock x:Name="ConsentText" TextWrapping="Wrap" />
            </CheckBox>
            <Border x:Name="ResultBadge" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,6"
                    CornerRadius="8" Background="{DynamicResource Octadock.Brush.AccentSoft}">
                <TextBlock x:Name="ResultText" Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
            </Border>
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Octadock.Brush.Danger}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center"
                       Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource Octadock.Style.Button}" />
                <Button x:Name="GenerateButton" Content="Generate variant" MinWidth="140" Margin="0,0,8,0"
                        Click="OnGenerate" Style="{StaticResource Octadock.Style.Button}" />
                <Button x:Name="ApproveButton" Content="Approve" MinWidth="108" IsEnabled="False"
                        Click="OnApprove" Style="{StaticResource Octadock.Style.AccentButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
