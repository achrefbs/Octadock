<Window x:Class="Octadock.App.FirstRun.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Welcome to Octadock"
        Width="760"
        Height="620"
        MinWidth="720"
        MinHeight="580"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="46"
                   Height="46"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico" />
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Title}"
                           Text="Turn anything on your screen into usable context." />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="Start with one capture on the Shelf. Copy, annotate, or drag it into the next app—without hunting folders."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="10,5"
                    CornerRadius="12"
                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Caption}" Text="Free · open source · local" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="2" Rows="2">
                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Octadock.Brush.AccentSoft}">
                                <iconPacks:PackIconLucide Kind="ScanLine" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Capture to Shelf" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="The Dock keeps Area, Window, and Full screen visible. More holds timer, scrolling (Beta), OCR, and recording (Beta). Captures land on the Shelf—hover for copy, annotate, or drag out."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="First move: Ctrl+Shift+4 (area) or the Dock Area button · Ctrl+Shift+3 full screen" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="6,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Octadock.Brush.AccentSoft}">
                                <iconPacks:PackIconLucide Kind="Mic" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Dictate at the cursor" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Speak naturally, watch live partials, then insert the transcript where you were typing."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Ctrl+Shift+2 to toggle · local after model import" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="0,6,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Octadock.Brush.AccentSoft}">
                                <iconPacks:PackIconLucide Kind="Layers" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Curate Context" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Bundle captures and files, choose exactly what is included, then export a safe folder or zip."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Snapshots survive source cleanup" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Octadock.Brush.CloudSoft}">
                                <iconPacks:PackIconLucide Kind="Sparkles" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Cloud}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Prepare a local export" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Collect captures, notes and files into a packet. Review and export it to a folder on this PC."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Preview, copy or save a bundle" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Margin="0,16,0,0"
                        Padding="14,12"
                        Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                        BorderBrush="{DynamicResource Octadock.Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="20" Height="20"
                                                   Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Everything runs on this PC" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                       Text="Captures, OCR, History, voice processing and Context stay on this PC. No account or connection is required. Import voice models from disk when you need dictation."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="{Binding CaptureExclusionNote}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="14,12"
                Background="{DynamicResource Octadock.Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="Keep a local history of what I copy (optional)"
                              Foreground="{DynamicResource Octadock.Brush.Text}"
                              IsChecked="{Binding ClipboardHistoryEnabled}" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Off until you choose this. If enabled, copied text and images are retained only on this PC, up to your saved limit. Pause monitoring in Settings and permanently clear saved clips from Clipboard History at any time."
                               TextWrapping="Wrap" />
                    <CheckBox Margin="0,10,0,0"
                              Content="Launch Octadock when I sign in to Windows"
                              Foreground="{DynamicResource Octadock.Brush.Text}"
                              IsChecked="{Binding LaunchAtLogin}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="On for new installs — uncheck to opt out. You can change this anytime in Settings."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Your captures stay on this PC. Every feature is free, with no account or activation."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start using Octadock"
                            MinWidth="158"
                            IsDefault="True"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            Command="{Binding FinishCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
