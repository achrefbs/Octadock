<Window x:Class="Octadock.App.FirstRun.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Welcome to Octadock"
        Width="820"
        Height="660"
        MinWidth="760"
        MinHeight="600"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="50"
                    Height="50"
                    Background="{DynamicResource Octadock.Brush.Surface.Raised}"
                    CornerRadius="{StaticResource Octadock.Corner.CardDense}">
                <Image Width="30"
                       Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Title}"
                           Text="Turn anything on your screen into usable context." />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="Capture, extract, dictate, curate, and transform—without breaking your flow."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="11,6"
                    CornerRadius="{StaticResource Octadock.Corner.Full}"
                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Octadock.Text.Caption}" Text="14-day trial · no account" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="2" Rows="2">
                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="0,0,7,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Octadock.Corner.Row}" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}">
                                <iconPacks:PackIconLucide Kind="ScanLine" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Capture to Shelf" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="The Dock keeps Area, Window, Full screen, Record, Dictate, and Shelf visible. Open the Shelf for All monitors, Previous area, self-timer, manual vertical scrolling (Beta), and OCR."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Ctrl+Shift+4 area · Ctrl+Shift+3 full screen — edit shortcuts in Settings" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="7,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Octadock.Corner.Row}" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}">
                                <iconPacks:PackIconLucide Kind="Mic" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Dictate at the cursor" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Speak naturally, watch live partials, then insert the transcript where you were typing."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Ctrl+Shift+2 to toggle · local after one-time model download" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="0,7,7,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Octadock.Corner.Row}" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}">
                                <iconPacks:PackIconLucide Kind="Layers" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Curate Context" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Bundle captures and files, choose exactly what is included, then export a safe folder or zip."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Snapshots survive source cleanup" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Octadock.Style.SectionCard}" Margin="7,7,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Octadock.Corner.Row}" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}">
                                <iconPacks:PackIconLucide Kind="Sparkles" Width="{StaticResource Octadock.Icon.Size.20}" Height="{StaticResource Octadock.Icon.Size.20}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Review a handoff with AI" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                           Text="Send a capture to a reviewed handoff: inspect the exact packet, then confirm your own Codex or Claude CLI. Nothing leaves this PC until you say so."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="Explicit confirmation · no stored keys" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Margin="0,16,0,0"
                        Padding="18,16"
                        Style="{StaticResource Octadock.Style.SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="20" Height="20"
                                                   Foreground="{DynamicResource Octadock.Brush.Accent}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource Octadock.Text.SectionHeader}" Text="Local first, with every network hop named" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Octadock.Text.Body}"
                                       Text="Captures, OCR, History, and Context stay on this PC. Cloud speech and AI are opt-in; Octadock shows the destination before anything is sent."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource Octadock.Text.Micro}" Text="{Binding CaptureExclusionNote}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="18,16"
                Style="{StaticResource Octadock.Style.SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="Keep a local history of what I copy (optional)"
                              Foreground="{DynamicResource Octadock.Brush.Text}"
                              IsChecked="{Binding ClipboardHistoryEnabled}" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Off until you choose this. If enabled, copied text and images are retained only on this PC, up to your saved limit. Pause monitoring in Settings and permanently clear saved clips from Clipboard History at any time."
                               TextWrapping="Wrap" />
                    <CheckBox Margin="0,10,0,0"
                              Content="Launch Octadock when I sign in to Windows"
                              Foreground="{DynamicResource Octadock.Brush.Text}"
                              IsChecked="{Binding LaunchAtLogin}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="On for new installs — uncheck to opt out. You can change this anytime in Settings."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Octadock.Text.Micro}"
                               Text="Everything you make stays accessible if the trial ends. A license is required only for new creation."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="I have a license key"
                            MinWidth="148"
                            Margin="0,0,8,0"
                            Style="{StaticResource Octadock.Style.Button}"
                            Command="{Binding EnterLicenseKeyCommand}" />
                    <Button Content="Start using Octadock"
                            MinWidth="158"
                            IsDefault="True"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            Command="{Binding FinishCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
