<Window x:Class="Octadock.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.History"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock History"
        Width="1100"
        Height="700"
        MinWidth="820"
        MinHeight="540"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.Canvas}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Octadock capture history">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="History.FilterItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource Octadock.Corner.Row}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Width="3" CornerRadius="2" Background="Transparent" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding Label}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="History.CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Width="168"
                                Background="{DynamicResource Octadock.Brush.GlassSurface}"
                                BorderBrush="{DynamicResource Octadock.Brush.GlassBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource Octadock.Corner.CardDense}"
                                Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                <RowDefinition Height="94" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource Octadock.Brush.InputBackground}"
                                        CornerRadius="{StaticResource Octadock.Corner.Well}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                                CornerRadius="{StaticResource Octadock.Corner.Chip}"
                                                Background="{DynamicResource Octadock.Brush.Accent}">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Octadock.Brush.AccentText}" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5"
                                                CornerRadius="{StaticResource Octadock.Corner.Chip}"
                                                Background="{DynamicResource Octadock.Brush.SurfaceOverlay}"
                                                Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}">
                                            <icons:PackIconLucide Kind="SquarePen" Width="13" Height="13"
                                                                   Foreground="{DynamicResource Octadock.Brush.Accent}" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2"
                                                CornerRadius="{StaticResource Octadock.Corner.Chip}"
                                                Background="{DynamicResource Octadock.Brush.DangerSoft}"
                                                BorderBrush="{DynamicResource Octadock.Brush.Danger}" BorderThickness="1"
                                                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Deleted" Style="{StaticResource Octadock.Text.Micro}"
                                                       Foreground="{DynamicResource Octadock.Brush.Danger}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Margin="2,6,2,0" Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                           Style="{StaticResource Octadock.Text.Body}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="2,2,2,0" Text="{Binding SourceLabel}"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource Octadock.Text.Caption}" />
                                <Grid Grid.Row="3" Margin="2,5,2,0">
                                    <TextBlock Text="{Binding SummaryLabel}" Style="{StaticResource Octadock.Text.Micro}" />
                                    <TextBlock Text="{Binding TimestampLabel}" HorizontalAlignment="Right"
                                               Style="{StaticResource Octadock.Text.Micro}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <icons:PackIconLucide Kind="History" Width="21" Height="21"
                                       Foreground="{DynamicResource Octadock.Brush.Accent}" VerticalAlignment="Center" />
                <StackPanel Margin="9,0,0,0">
                    <TextBlock Text="History" Style="{StaticResource Octadock.Text.Section}" />
                    <TextBlock Text="Everything captured on this PC"
                               Style="{StaticResource Octadock.Text.Micro}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" Width="350" Margin="18,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="38,9,12,9" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Search capture history">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <icons:PackIconLucide Kind="Search" Width="17" Height="17" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Octadock.Brush.TextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Margin="38,0,0,0" Text="Search captures, apps, OCR text…"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource Octadock.Style.DangerButton}"
                    Content="Clear history…" Click="OnClearHistory"
                    AutomationProperties.Name="Clear capture history" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Width" Value="8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Width" Value="280" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Octadock.Style.SectionCard}" Padding="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="4,0,4,8">
                            <TextBlock Text="FILTERS" Style="{StaticResource Octadock.Text.Micro}" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                                    Padding="4,2" Content="Reset" Command="{Binding ClearDateFiltersCommand}" />
                        </Grid>
                        <ListBox x:Name="FilterList" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                 ItemContainerStyle="{StaticResource History.FilterItem}" />

                        <Border Height="1" Background="{DynamicResource Octadock.Brush.Border}" Margin="4,14" />
                        <TextBlock Text="DATE" Style="{StaticResource Octadock.Text.Micro}" Margin="4,0,4,8" />
                        <TextBlock Text="From" Style="{StaticResource Octadock.Text.Caption}" Margin="4,0,4,3" />
                        <DatePicker SelectedDate="{Binding CreatedAfterDate, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Captured after date" />
                        <TextBlock Text="To" Style="{StaticResource Octadock.Text.Caption}" Margin="4,10,4,3" />
                        <DatePicker SelectedDate="{Binding CreatedBeforeDate, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Captured before date" />

                        <Border Height="1" Background="{DynamicResource Octadock.Brush.Border}" Margin="4,14" />
                        <CheckBox Content="Show deleted captures" IsChecked="{Binding ShowDeleted}"
                                  Foreground="{DynamicResource Octadock.Brush.Text}"
                                  AutomationProperties.Name="Show deleted captures" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Octadock.Style.SectionCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Captures" Style="{StaticResource Octadock.Text.Subtitle}" />
                            <Border Margin="9,0,0,0" Padding="7,2" Background="{DynamicResource Octadock.Brush.AccentSoft}"
                                    CornerRadius="{StaticResource Octadock.Corner.Full}">
                                <TextBlock Text="{Binding Items.Count}" Style="{StaticResource Octadock.Text.Micro}"
                                           Foreground="{DynamicResource Octadock.Brush.Accent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Octadock.Style.IconButton}" ToolTip="Refresh"
                                    AutomationProperties.Name="Refresh history" Command="{Binding RefreshCommand}">
                                <icons:PackIconLucide Kind="RefreshCw" Width="17" Height="17" />
                            </Button>
                            <Button Margin="5,0,0,0" Style="{StaticResource Octadock.Style.IconButton}" ToolTip="Grid view"
                                    AutomationProperties.Name="Grid view">
                                <icons:PackIconLucide Kind="LayoutGrid" Width="17" Height="17" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Background="{DynamicResource Octadock.Brush.Surface}">
                        <ListBox x:Name="Grid" Background="Transparent" BorderThickness="0" Padding="10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                 ItemContainerStyle="{StaticResource History.CardItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                    IsHitTestVisible="False">
                            <icons:PackIconLucide Kind="Images" Width="32" Height="32"
                                                   Foreground="{DynamicResource Octadock.Brush.TextDisabled}"
                                                   HorizontalAlignment="Center" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}"
                                       Style="{StaticResource Octadock.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Octadock.Style.SectionCard}" Padding="0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14">
                            <Border Height="144" Background="{DynamicResource Octadock.Brush.InputBackground}"
                                    CornerRadius="{StaticResource Octadock.Corner.Row}" ClipToBounds="True">
                                <Image Source="{Binding SelectedItem.Thumbnail}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding SelectedItem.FileName}" Margin="2,14,2,0"
                                       Style="{StaticResource Octadock.Text.Section}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedItem.SourceLabel}" Margin="2,2,2,0"
                                       Style="{StaticResource Octadock.Text.Caption}" TextTrimming="CharacterEllipsis" />

                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <Button Margin="0,0,4,4" Style="{StaticResource Octadock.Style.AccentButton}"
                                        Content="Open" Command="{Binding OpenCommand}" />
                                <Button Margin="4,0,0,4" Style="{StaticResource Octadock.Style.ToolButton}"
                                        Content="Copy" Command="{Binding CopyCommand}" />
                                <Button Margin="0,4,4,0" Style="{StaticResource Octadock.Style.ToolButton}"
                                        Content="Pin" Command="{Binding PinCommand}" />
                                <Button Margin="4,4,0,0" Style="{StaticResource Octadock.Style.ToolButton}"
                                        Content="Save…" Command="{Binding SaveCommand}" />
                            </UniformGrid>
                            <Button Margin="0,8,0,0" Style="{StaticResource Octadock.Style.ToolButton}"
                                    Content="Copy recognized text" Command="{Binding CopyExtractedTextCommand}"
                                    Visibility="{Binding SelectedItem.IsOcr, Converter={StaticResource BoolToVis}}" />
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="{StaticResource Octadock.Corner.Row}"
                                    Background="{DynamicResource Octadock.Brush.AccentSoft}"
                                    Visibility="{Binding SelectedItem.HasApprovedMockup, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Approved mockup" Style="{StaticResource Octadock.Text.Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="Verified local composite" Style="{StaticResource Octadock.Text.Micro}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="View" Margin="8,0,4,0"
                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                            Command="{Binding ViewApprovedMockupCommand}" />
                                    <Button Grid.Column="2" Content="Copy" Margin="4,0,0,0"
                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                            Command="{Binding CopyApprovedMockupCommand}" />
                                    <Button Grid.Column="3" Content="Copy spec" Margin="4,0,0,0"
                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                            Command="{Binding CopyApprovedMockupSpecCommand}" />
                                </Grid>
                            </Border>

                            <Border Height="1" Background="{DynamicResource Octadock.Brush.Border}" Margin="0,16" />
                            <TextBlock Text="DETAILS" Style="{StaticResource Octadock.Text.Micro}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource Octadock.Text.Caption}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.TypeLabel}" Style="{StaticResource Octadock.Text.Body}" />
                                <TextBlock Grid.Row="1" Text="Captured" Style="{StaticResource Octadock.Text.Caption}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.TimestampLabel}" Style="{StaticResource Octadock.Text.Body}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="2" Text="Dimensions" Style="{StaticResource Octadock.Text.Caption}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.DimensionsLabel}" Style="{StaticResource Octadock.Text.Body}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="3" Text="File" Style="{StaticResource Octadock.Text.Caption}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.AbsolutePath}"
                                           Style="{StaticResource Octadock.Text.Mono}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Octadock.Style.DangerButton}" Content="Delete"
                                        Command="{Binding DeleteCommand}" />
                                <Button Style="{StaticResource Octadock.Style.ToolButton}" Content="Restore"
                                        Command="{Binding RestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Octadock.Text.Caption}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource Octadock.Style.ToolButton}"
                    Content="Load more" Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
