<Window x:Class="Octadock.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.History"
        Title="Octadock History"
        Width="960"
        Height="680"
        MinWidth="640"
        MinHeight="440"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.Surface}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Toolbar: search + filters ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Padding="8,6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="Search by process or window title">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <CheckBox Content="Show deleted"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Octadock.Brush.Text}"
                          IsChecked="{Binding ShowDeleted}" />
                <Button Style="{StaticResource Octadock.Style.DangerButton}"
                        Margin="10,0,0,0"
                        Content="Clear history…"
                        Click="OnClearHistory" />
            </StackPanel>
        </Grid>

        <!-- Date filters -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"
                    VerticalAlignment="Center">
            <TextBlock Text="From"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Style="{StaticResource Octadock.Text.Muted}" />
            <DatePicker Width="140"
                        SelectedDate="{Binding CreatedAfterDate, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="To"
                       VerticalAlignment="Center"
                       Margin="12,0,6,0"
                       Style="{StaticResource Octadock.Text.Muted}" />
            <DatePicker Width="140"
                        SelectedDate="{Binding CreatedBeforeDate, UpdateSourceTrigger=PropertyChanged}" />
            <Button Style="{StaticResource Octadock.Style.ToolButton}"
                    Margin="10,0,0,0"
                    Content="Reset dates"
                    Command="{Binding ClearDateFiltersCommand}" />
        </StackPanel>

        <!-- Filter chips -->
        <ListBox Grid.Row="2"
                 x:Name="FilterList"
                 Margin="0,0,0,10"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chip"
                                        Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,5">
                                    <ContentPresenter Content="{Binding Label}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                        <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{DynamicResource Octadock.Brush.AccentText}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- ===================== Thumbnail grid ===================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ListBox x:Name="Grid"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card"
                                                Width="200"
                                                Background="{DynamicResource Octadock.Brush.Surface}"
                                                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6">
                                            <StackPanel>
                                                <Grid Height="120">
                                                    <Border Background="#22000000" CornerRadius="4" />
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <!-- Badges -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Margin="4"
                                                            Padding="5,1"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource Octadock.Brush.Accent}">
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Octadock.Brush.AccentText}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="4" Padding="5,1" CornerRadius="4"
                                                            Background="{DynamicResource Octadock.Brush.Accent}"
                                                            Visibility="{Binding IsAnnotated, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✎" FontSize="10"
                                                                   Foreground="{DynamicResource Octadock.Brush.AccentText}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="4" Padding="5,1" CornerRadius="4"
                                                            Background="{DynamicResource Octadock.Brush.Danger}"
                                                            Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Deleted" FontSize="10" Foreground="White" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding SourceLabel}"
                                                           Margin="2,6,2,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource Octadock.Text.Body}" />
                                                <TextBlock Margin="2,2,2,0"
                                                           Style="{StaticResource Octadock.Text.Muted}"
                                                           FontSize="11"
                                                           Text="{Binding TimestampLabel}" />
                                                <TextBlock Margin="2,0,2,0"
                                                           Style="{StaticResource Octadock.Text.Muted}"
                                                           FontSize="11"
                                                           Text="{Binding DimensionsLabel}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty-state overlay -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                           IsHitTestVisible="False"
                           Opacity="0.7" />
            </Grid>
        </Border>

        <!-- ===================== Action bar ===================== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource Octadock.Style.AccentButton}" Content="Open / Annotate"
                        Command="{Binding OpenCommand}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}" Margin="6,0,0,0" Content="Pin"
                        Command="{Binding PinCommand}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}" Content="Copy"
                        Command="{Binding CopyCommand}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}" Content="Copy Text"
                        Command="{Binding CopyExtractedTextCommand}"
                        ToolTip="Copy the text recognized by OCR"
                        Visibility="{Binding SelectedItem.IsOcr, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}" Content="Save…"
                        Command="{Binding SaveCommand}" />
                <Button Style="{StaticResource Octadock.Style.DangerButton}" Content="Delete"
                        Command="{Binding DeleteCommand}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}" Content="Restore"
                        Command="{Binding RestoreCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                           Style="{StaticResource Octadock.Text.Muted}"
                           Text="{Binding StatusMessage}" />
                <Button Style="{StaticResource Octadock.Style.ToolButton}"
                        Content="Load more"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
