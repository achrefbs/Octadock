<Window x:Class="Octadock.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.History"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock History" Width="1100" Height="740" MinWidth="480" MinHeight="360"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.Canvas}"
        Foreground="{DynamicResource Octadock.Brush.Text}"
        FontFamily="{DynamicResource Octadock.Font}" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown"
        AutomationProperties.Name="Octadock capture history">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="History.Action" TargetType="Button" BasedOn="{StaticResource Octadock.Style.IconButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="History.Category" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab" Padding="{TemplateBinding Padding}" CornerRadius="9"
                                BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <TextBlock Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Octadock.Brush.Surface.Raised}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border.Subtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The capture itself is the tile. Names, sources and dates live in Info. -->
        <Style x:Key="History.ImageItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{Binding ThumbnailWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HistoryWindow}}}" />
            <Setter Property="Height" Value="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType={x:Type local:HistoryWindow}}}" />
            <Setter Property="ToolTip" Value="{Binding AccessibleLabel}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Selection" CornerRadius="12" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent" Padding="2">
                            <Border x:Name="ImageWell" Background="Transparent">
                                <Grid>
                                    <icons:PackIconLucide Kind="Images" Width="28" Height="28"
                                                           Foreground="{DynamicResource Octadock.Brush.TextDisabled}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <icons:PackIconLucide.Style>
                                            <Style TargetType="icons:PackIconLucide">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </icons:PackIconLucide.Style>
                                    </icons:PackIconLucide>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="SelectedMark" Visibility="Collapsed" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="8" Padding="4" CornerRadius="10"
                                            Background="{DynamicResource Octadock.Brush.Accent}">
                                        <icons:PackIconLucide Kind="Check" Width="11" Height="11" Foreground="{DynamicResource Octadock.Brush.AccentText}" />
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="5"
                                            CornerRadius="7" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}"
                                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                        <icons:PackIconLucide Kind="Play" Width="13" Height="13" Foreground="{DynamicResource Octadock.Brush.Text}" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="5"
                                            CornerRadius="7" Background="{DynamicResource Octadock.Brush.SurfaceOverlay}"
                                            Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                                        <icons:PackIconLucide Kind="Trash2" Width="13" Height="13" Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter TargetName="ImageWell" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="24,20,24,14" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Margin="0,0,0,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Library" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Items.Count, StringFormat={}{0} captures on this PC}" Margin="1,3,0,0"
                           Style="{StaticResource Octadock.Text.Caption}" />
            </StackPanel>
            <Grid x:Name="SearchContainer" Grid.Column="1" Width="300" VerticalAlignment="Center" Margin="18,0,10,0">
                <TextBox x:Name="SearchBox" Padding="35,9,12,9" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Search capture history" />
                <icons:PackIconLucide Kind="Search" Width="15" Height="15" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Octadock.Brush.TextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Margin="35,0,0,0" Text="Search captures" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource History.Action}" VerticalAlignment="Center"
                    ToolTip="Library options" AutomationProperties.Name="Library options" Click="OnOpenMenu">
                <icons:PackIconLucide Kind="Ellipsis" Width="17" Height="17" />
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Refresh library" Command="{Binding RefreshCommand}" />
                        <Separator />
                        <MenuItem Header="Clear listed captures…" Click="OnClearHistory" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="FilterList" Style="{StaticResource Octadock.Style.ListBox}" Padding="0" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                     ItemContainerStyle="{StaticResource History.Category}" AutomationProperties.Name="Capture categories">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <ComboBox x:Name="CompactFilter" Width="180" HorizontalAlignment="Left" Visibility="Collapsed"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Capture category" />
            <Button x:Name="DateFilterButton" Grid.Column="1" Style="{StaticResource History.Action}" Margin="10,0,0,0"
                    Click="OnOpenFilters" ToolTip="Date and deleted filters" AutomationProperties.Name="Date and deleted filters">
                <icons:PackIconLucide Kind="SlidersHorizontal" Width="16" Height="16" />
            </Button>
            <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=DateFilterButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border Width="280" Padding="20" Margin="0,7,0,0" CornerRadius="14"
                        Background="{DynamicResource Octadock.Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Octadock.Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Filter by date" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Octadock.Brush.Text}" />
                        <TextBlock Text="From" Margin="0,17,0,5" Style="{StaticResource Octadock.Text.Caption}" />
                        <DatePicker x:Name="DateFrom" SelectedDate="{Binding CreatedAfterDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Captured after date" />
                        <TextBlock Text="To" Margin="0,13,0,5" Style="{StaticResource Octadock.Text.Caption}" />
                        <DatePicker SelectedDate="{Binding CreatedBeforeDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Captured before date" />
                        <CheckBox Content="Include deleted captures" IsChecked="{Binding ShowDeleted}" Margin="0,20,0,10" Foreground="{DynamicResource Octadock.Brush.Text}" />
                        <Button Content="Reset dates" Command="{Binding ClearDateFiltersCommand}"
                                Style="{StaticResource Octadock.Style.ToolButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>


        <Grid x:Name="HistoryBody" Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <Grid x:Name="CapturesPanel">
                <ListBox x:Name="CaptureGrid" Style="{StaticResource Octadock.Style.ListBox}" Padding="0" Margin="-4,0,0,0"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Capture library"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         ItemContainerStyle="{StaticResource History.ImageItem}" MouseDoubleClick="OnCaptureDoubleClick" SizeChanged="OnGallerySizeChanged">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="25"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                    <icons:PackIconLucide Kind="Images" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource Octadock.Brush.TextDisabled}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Octadock.Text.Caption}" />
                </StackPanel>
            </Grid>

            <Border x:Name="DetailsPanel" Grid.Column="1" Visibility="Collapsed" Padding="20,14,16,14"
                    BorderBrush="{DynamicResource Octadock.Brush.Border.Subtle}" BorderThickness="1,0,0,0" Background="{DynamicResource Octadock.Brush.Canvas}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Capture info" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="CloseDetailsButton" Style="{StaticResource History.Action}" HorizontalAlignment="Right"
                                Click="OnToggleDetails" ToolTip="Close info" AutomationProperties.Name="Close capture information">
                            <icons:PackIconLucide Kind="X" Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,64">
                        <StackPanel Margin="0,0,3,0">
                            <Image Source="{Binding SelectedItem.Thumbnail}" Height="152" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20" />
                            <TextBlock Text="{Binding SelectedItem.FileName}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding SelectedItem.SourceLabel}" TextWrapping="Wrap" Margin="0,5,0,22" Style="{StaticResource Octadock.Text.Caption}" />
                            <TextBlock Text="Captured" Style="{StaticResource Octadock.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.TimestampLabel}" Margin="0,4,0,16" />
                            <TextBlock Text="Format" Style="{StaticResource Octadock.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.SummaryLabel}" Margin="0,4,0,16" />
                            <TextBlock Text="Location" Style="{StaticResource Octadock.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.AbsolutePath}" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="11" Foreground="{DynamicResource Octadock.Brush.TextSecondary}" />
                            <Button Content="Show in Explorer" Command="{Binding ShowInFolderCommand}" HorizontalAlignment="Left" Style="{StaticResource Octadock.Style.ToolButton}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="SelectionToolbar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="12,12,12,10" Padding="8,5" CornerRadius="15" Panel.ZIndex="2"
                    Background="{DynamicResource Octadock.Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Octadock.Brush.Border.Subtle}" BorderThickness="1"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource History.Action}" Command="{Binding CopyCommand}" ToolTip="Copy capture · Ctrl+C" AutomationProperties.Name="Copy selected capture">
                        <icons:PackIconLucide Kind="Copy" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource History.Action}" Command="{Binding AnnotateCommand}" ToolTip="Annotate" AutomationProperties.Name="Annotate selected capture">
                        <icons:PackIconLucide Kind="SquarePen" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource History.Action}" Command="{Binding SaveCommand}" ToolTip="Save a copy · Ctrl+S" AutomationProperties.Name="Save selected capture">
                        <icons:PackIconLucide Kind="Download" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource Octadock.Brush.Border.Subtle}" Margin="8,0" />
                    <Button x:Name="InfoButton" Style="{StaticResource History.Action}" Click="OnToggleDetails" IsEnabled="{Binding HasSelection}"
                            ToolTip="Capture info · Ctrl+I" AutomationProperties.Name="Show capture information">
                        <icons:PackIconLucide Kind="Info" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource History.Action}" Click="OnOpenMenu" IsEnabled="{Binding HasSelection}" ToolTip="More actions" AutomationProperties.Name="More actions for selected capture">
                        <icons:PackIconLucide Kind="Ellipsis" Width="17" Height="17" />
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open in default app" InputGestureText="Enter" Command="{Binding OpenCommand}" />
                                <MenuItem Header="Local export…" Command="{Binding UseWithAiCommand}" />
                                <MenuItem Header="Copy recognized text" Command="{Binding CopyExtractedTextCommand}" Visibility="{Binding SelectedItem.IsOcr, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Copy file path" Command="{Binding CopyPathCommand}" />
                                <MenuItem Header="Show in Explorer" Command="{Binding ShowInFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Approved variant" Visibility="{Binding SelectedItem.HasApprovedMockup, Converter={StaticResource BoolToVis}}">
                                    <MenuItem Header="View" Command="{Binding ViewApprovedMockupCommand}" />
                                    <MenuItem Header="Copy image" Command="{Binding CopyApprovedMockupCommand}" />
                                    <MenuItem Header="Copy implementation spec" Command="{Binding CopyApprovedMockupSpecCommand}" />
                                </MenuItem>
                                <MenuItem Header="Move to deleted" Command="{Binding DeleteCommand}" Visibility="{Binding SelectedItem.IsDeleted, Converter={StaticResource InverseBoolToVis}}" />
                                <MenuItem Header="Restore capture" Command="{Binding RestoreCommand}" Visibility="{Binding SelectedItem.IsDeleted, Converter={StaticResource BoolToVis}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="3" Margin="4,10,0,0" MinHeight="22" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterMessage" Text="{Binding StatusMessage}" Style="{StaticResource Octadock.Text.Micro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <Button Grid.Column="1" Style="{StaticResource Octadock.Style.ToolButton}" Content="Load more" Command="{Binding LoadMoreCommand}" Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
