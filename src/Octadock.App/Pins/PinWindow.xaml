<windows:ToolWindowBase x:Class="Octadock.App.Pins.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Octadock.App.Windows"
        xmlns:local="clr-namespace:Octadock.App.Pins"
        MinWidth="48"
        MinHeight="48"
        SizeToContent="Manual"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Grid x:Name="Root" Background="Transparent">
        <!-- The pinned image. Stretches to fill the (resizable) window. -->
        <Border x:Name="ImageFrame"
                BorderBrush="{DynamicResource Octadock.Brush.Accent}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Image x:Name="PinImage"
                   Source="{Binding Image}"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- Always-hittable move/grab strip along the top; also the unlock affordance
             is the toolbar which sits above the image and is never click-through
             because click-through is only toggled on the whole HWND when locked. -->

        <!-- Hover toolbar -->
        <Border x:Name="Toolbar"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Padding="4"
                CornerRadius="6"
                Opacity="0"
                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource Octadock.Style.IconButton}" Content="&#xE8C8;"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="Copy" Command="{Binding CopyCommand}" />
                <Button Style="{DynamicResource Octadock.Style.IconButton}" Content="&#xE74E;"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="Save…" Command="{Binding SaveCommand}" />
                <Button Style="{DynamicResource Octadock.Style.IconButton}" Content="&#xE70F;"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="Annotate" Command="{Binding AnnotateCommand}" />
                <Button Style="{DynamicResource Octadock.Style.IconButton}"
                        Content="{Binding LockGlyph}"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="{Binding LockLabel}"
                        Command="{Binding ToggleLockCommand}" />
                <Slider x:Name="OpacitySlider"
                        Width="70"
                        VerticalAlignment="Center"
                        Margin="6,0"
                        Minimum="0.2"
                        Maximum="1.0"
                        Value="{Binding Opacity, Mode=TwoWay}"
                        ToolTip="Opacity" />
                <Button Style="{DynamicResource Octadock.Style.IconButton}" Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>

        <!-- Corner resize grips (bottom-right + bottom-left). -->
        <Thumb x:Name="ResizeBr"
               Width="14" Height="14"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Opacity="0"
               DragDelta="OnResizeBottomRight">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Octadock.Brush.Accent}" CornerRadius="3" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Thumb x:Name="ResizeBl"
               Width="14" Height="14"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Cursor="SizeNESW"
               Opacity="0"
               DragDelta="OnResizeBottomLeft">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Octadock.Brush.Accent}" CornerRadius="3" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Reveal toolbar and grips on hover. -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.MouseEnter" SourceName="Root">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Toolbar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="ResizeBr" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="ResizeBl" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Grid.MouseLeave" SourceName="Root">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Toolbar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        <DoubleAnimation Storyboard.TargetName="ResizeBr" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        <DoubleAnimation Storyboard.TargetName="ResizeBl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</windows:ToolWindowBase>
