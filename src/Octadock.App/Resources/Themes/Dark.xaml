<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Octadock dark palette — the "obsidian glass" identity and the product's
        default look. Deep blue-black surfaces, an electric teal→cyan accent,
        hairline glass borders. Same key set as Light.xaml so the app can swap
        the merged dictionary at runtime.
    -->

    <!-- Core colors -->
    <Color x:Key="Octadock.Color.Canvas">#FF070B14</Color>
    <Color x:Key="Octadock.Color.Surface">#FF0C1220</Color>
    <Color x:Key="Octadock.Color.SurfaceAlt">#FF141E32</Color>
    <Color x:Key="Octadock.Color.SurfaceOverlay">#FF1B2942</Color>
    <Color x:Key="Octadock.Color.Border">#FF25334E</Color>
    <Color x:Key="Octadock.Color.BorderStrong">#FF33455F</Color>
    <Color x:Key="Octadock.Color.Text">#FFF2F6FC</Color>
    <Color x:Key="Octadock.Color.TextMuted">#FF8DA0BC</Color>
    <Color x:Key="Octadock.Color.TextSecondaryStrong">#FFB6C2D4</Color>
    <Color x:Key="Octadock.Color.TextDisabled">#FF5B6B84</Color>
    <Color x:Key="Octadock.Color.Accent">#FF2DD4BF</Color>
    <Color x:Key="Octadock.Color.AccentText">#FF04201C</Color>
    <Color x:Key="Octadock.Color.Danger">#FFFB7185</Color>
    <Color x:Key="Octadock.Color.Hover">#14FFFFFF</Color>
    <Color x:Key="Octadock.Color.Pressed">#26FFFFFF</Color>

    <!-- Semantic tokens: focus visuals, input surfaces, selection, on-danger text -->
    <Color x:Key="Octadock.Color.FocusRing">#FF5EEAD4</Color>
    <Color x:Key="Octadock.Color.OnDanger">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.InputBackground">#FF0F182A</Color>
    <Color x:Key="Octadock.Color.SelectionSubtle">#2E2DD4BF</Color>
    <!-- Hairline white border echoing the dock capsule's 1px rgba-white edge. -->
    <Color x:Key="Octadock.Color.GlassBorder">#30FFFFFF</Color>

    <!-- Status tokens (overlay cards, badges, toasts) -->
    <Color x:Key="Octadock.Color.Success">#FF4ADE80</Color>
    <Color x:Key="Octadock.Color.Warning">#FFFBBF24</Color>
    <Color x:Key="Octadock.Color.Info">#FF38BDF8</Color>
    <Color x:Key="Octadock.Color.Cloud">#FFA78BFA</Color>
    <Color x:Key="Octadock.Color.SuccessSoft">#244ADE80</Color>
    <Color x:Key="Octadock.Color.WarningSoft">#24FBBF24</Color>
    <Color x:Key="Octadock.Color.DangerSoft">#24FB7185</Color>
    <Color x:Key="Octadock.Color.CloudSoft">#1FA78BFA</Color>
    <!-- Low-alpha accent wash for selected rows / soft highlights. -->
    <Color x:Key="Octadock.Color.AccentSoft">#1F2DD4BF</Color>

    <!-- Brushes (the documented reusable surface) -->
    <SolidColorBrush x:Key="Octadock.Brush.Canvas" Color="{StaticResource Octadock.Color.Canvas}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface" Color="{StaticResource Octadock.Color.Surface}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceAlt" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceRaised" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceOverlay" Color="{StaticResource Octadock.Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border" Color="{StaticResource Octadock.Color.Border}" />
    <SolidColorBrush x:Key="Octadock.Brush.BorderStrong" Color="{StaticResource Octadock.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text" Color="{StaticResource Octadock.Color.Text}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextMuted" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondary" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondaryStrong" Color="{StaticResource Octadock.Color.TextSecondaryStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextDisabled" Color="{StaticResource Octadock.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Octadock.Brush.Accent" Color="{StaticResource Octadock.Color.Accent}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentText" Color="{StaticResource Octadock.Color.AccentText}" />
    <SolidColorBrush x:Key="Octadock.Brush.Danger" Color="{StaticResource Octadock.Color.Danger}" />
    <SolidColorBrush x:Key="Octadock.Brush.Hover" Color="{StaticResource Octadock.Color.Hover}" />
    <SolidColorBrush x:Key="Octadock.Brush.Pressed" Color="{StaticResource Octadock.Color.Pressed}" />
    <SolidColorBrush x:Key="Octadock.Brush.FocusRing" Color="{StaticResource Octadock.Color.FocusRing}" />
    <SolidColorBrush x:Key="Octadock.Brush.OnDanger" Color="{StaticResource Octadock.Color.OnDanger}" />
    <SolidColorBrush x:Key="Octadock.Brush.InputBackground" Color="{StaticResource Octadock.Color.InputBackground}" />
    <SolidColorBrush x:Key="Octadock.Brush.SelectionSubtle" Color="{StaticResource Octadock.Color.SelectionSubtle}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorder" Color="{StaticResource Octadock.Color.GlassBorder}" />
    <SolidColorBrush x:Key="Octadock.Brush.Success" Color="{StaticResource Octadock.Color.Success}" />
    <SolidColorBrush x:Key="Octadock.Brush.Warning" Color="{StaticResource Octadock.Color.Warning}" />
    <SolidColorBrush x:Key="Octadock.Brush.Info" Color="{StaticResource Octadock.Color.Info}" />
    <SolidColorBrush x:Key="Octadock.Brush.Cloud" Color="{StaticResource Octadock.Color.Cloud}" />
    <SolidColorBrush x:Key="Octadock.Brush.SuccessSoft" Color="{StaticResource Octadock.Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.WarningSoft" Color="{StaticResource Octadock.Color.WarningSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.DangerSoft" Color="{StaticResource Octadock.Color.DangerSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.CloudSoft" Color="{StaticResource Octadock.Color.CloudSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.ByoKey" Color="{StaticResource Octadock.Color.TextSecondaryStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.Gated" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentSoft" Color="{StaticResource Octadock.Color.AccentSoft}" />

    <!-- Capture/media overlays remain legible over arbitrary desktop pixels. -->
    <SolidColorBrush x:Key="Octadock.Brush.CaptureDim" Color="#B0000000" />
    <SolidColorBrush x:Key="Octadock.Brush.CapturePickerDim" Color="#40000000" />
    <SolidColorBrush x:Key="Octadock.Brush.EditorCropDim" Color="#78000000" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHighlightFill" Color="#332DD4BF" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChip" Color="#E6151F2B" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipText" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipMuted" Color="#FF9AA7B4" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHandle" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderSubtle" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderStrong" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.PinAiWorkOverlay" Color="#3014B8A6" />
    <SolidColorBrush x:Key="Octadock.Brush.PinAiWorkBackdrop" Color="#16000000" />
    <LinearGradientBrush x:Key="Octadock.Brush.PinAiSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0014B8A6" />
        <GradientStop Offset="0.5" Color="#8814B8A6" />
        <GradientStop Offset="1" Color="#0014B8A6" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabel" Color="#CC0B1018" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabelText" Color="#FFFFFFFF" />

    <!-- The signature teal→cyan sweep used by primary buttons and hero accents. -->
    <LinearGradientBrush x:Key="Octadock.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2DD4BF" Offset="0" />
        <GradientStop Color="#FF38BDF8" Offset="1" />
    </LinearGradientBrush>

    <!-- Standard windows are opaque instrument canvases. Glass is reserved for
         the floating Dock, Shelf, HUD, Context and media surfaces. -->
    <SolidColorBrush x:Key="Octadock.Brush.WindowBackdrop" Color="{StaticResource Octadock.Color.Canvas}" />

    <!-- =====================================================================
         Glass layering (2026 redesign): the translucent, layered "obsidian
         glass" surfaces the floating tools are built from. Panels and rows
         stack lighter-on-darker; a hairline white top highlight and a soft
         accent wash give depth without heavy borders.
         ===================================================================== -->

    <!-- Primary panel / window glass: a near-opaque obsidian pane with a faint
         top-lit vertical wash. Used for the shelf, context stack and dock. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassSurface" Color="#D90C1220" />

    <!-- Translucent chrome bar that floats OVER media (pin top bar / metadata
         strip): dark enough to read white text, sheer enough to feel like glass. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassChrome" Color="#C40B1220" />

    <!-- A row/card sitting on a glass panel: a faint lighter pane. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassRow" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowHover" Color="#1AFFFFFF" />

    <!-- Dense floating rows/rails used when there is no opaque parent behind the
         glass, such as the context stack over the desktop. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassRail" Color="#A60E1524" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDense" Color="#A8162032" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDenseHover" Color="#C11E2A3D" />

    <!-- Soft inner top highlight line drawn just inside a glass edge. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassHighlight" Color="#24FFFFFF" />
    <!-- Stronger hairline for active / emphasized surfaces. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorderStrong" Color="#59FFFFFF" />

    <!-- Left→right teal wash behind the active row's action rail. -->
    <LinearGradientBrush x:Key="Octadock.Brush.AccentRailWash" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002DD4BF" Offset="0" />
        <GradientStop Color="#282DD4BF" Offset="1" />
    </LinearGradientBrush>

    <!-- Soft accent fill for pills / badges (the green "Pinned" chip). -->
    <SolidColorBrush x:Key="Octadock.Brush.AccentPill" Color="#242DD4BF" />

    <!-- Left→right fade to the panel dark, so a row's text disappears cleanly
         beneath the hover action rail that floats over its right edge. -->
    <LinearGradientBrush x:Key="Octadock.Brush.RailFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000C1220" Offset="0" />
        <GradientStop Color="#F20C1220" Offset="0.26" />
        <GradientStop Color="#F20C1220" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
