<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accessibility overlay. It is merged after the selected light/dark
         palette whenever Windows High Contrast is active, so every semantic
         brush resolves to colors owned by the OS. -->
    <Thickness x:Key="Octadock.Border.Thickness.Inline">1</Thickness>
    <SolidColorBrush x:Key="Octadock.Brush.Canvas" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceAlt" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceRaised" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceOverlay" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.WindowBackdrop" Color="{x:Static SystemColors.WindowColor}" />

    <SolidColorBrush x:Key="Octadock.Brush.Border" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.BorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassHighlight" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Octadock.Brush.Text" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextMuted" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondaryStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextDisabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Gated" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.ByoKey" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Octadock.Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.FocusRing" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.SelectionSubtle" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentSoft" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentGradient" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentPill" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentRailWash" Color="Transparent" />

    <SolidColorBrush x:Key="Octadock.Brush.Danger" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.OnDanger" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Success" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Warning" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Info" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Cloud" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.SuccessSoft" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.WarningSoft" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.DangerSoft" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.CloudSoft" Color="Transparent" />

    <SolidColorBrush x:Key="Octadock.Brush.CaptureDim" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.CapturePickerDim" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.EditorCropDim" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHighlightFill" Color="Transparent" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChip" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipMuted" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHandle" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderSubtle" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabel" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabelText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Octadock.Brush.InputBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaBackdrop" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Pressed" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="Octadock.Brush.GlassSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassChrome" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRow" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowHover" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRail" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDense" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDenseHover" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.RailFade" Color="{x:Static SystemColors.WindowColor}" />

    <!-- Semantic aliases (2026 design-system pass): same keys as Dark/Light,
         resolved to the same OS-owned colors as the legacy keys they mirror. -->
    <SolidColorBrush x:Key="Octadock.Brush.Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Base" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Raised" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Overlay" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border.Subtle" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border.Strong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Pressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Focus" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Selected" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
