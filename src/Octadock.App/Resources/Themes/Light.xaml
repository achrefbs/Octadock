<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Octadock light palette. Original teal-on-slate identity (not a clone of any
        existing product). Consumed via DynamicResource so switching the merged
        dictionary at runtime re-themes live windows.
    -->

    <!-- Core colors -->
    <Color x:Key="Octadock.Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.SurfaceAlt">#FFF4F6F9</Color>
    <Color x:Key="Octadock.Color.Border">#FFDCE1E8</Color>
    <Color x:Key="Octadock.Color.Text">#FF0F172A</Color>
    <Color x:Key="Octadock.Color.TextMuted">#FF5A6472</Color>
    <!-- Accent teal-700: white text on it clears WCAG AA (~5.5:1) for button labels. -->
    <Color x:Key="Octadock.Color.Accent">#FF0F766E</Color>
    <Color x:Key="Octadock.Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.Danger">#FFDC2626</Color>
    <Color x:Key="Octadock.Color.Hover">#1A000000</Color>
    <Color x:Key="Octadock.Color.Pressed">#2E000000</Color>

    <!-- Semantic tokens: focus visuals, input surfaces, selection, on-danger text -->
    <Color x:Key="Octadock.Color.FocusRing">#FF0F766E</Color>
    <Color x:Key="Octadock.Color.OnDanger">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.InputBackground">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.SelectionSubtle">#260F766E</Color>
    <!-- Hairline border; on light surfaces a faint slate reads better than white. -->
    <Color x:Key="Octadock.Color.GlassBorder">#14000000</Color>

    <!-- Brushes (the documented reusable surface) -->
    <SolidColorBrush x:Key="Octadock.Brush.Surface" Color="{StaticResource Octadock.Color.Surface}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceAlt" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border" Color="{StaticResource Octadock.Color.Border}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text" Color="{StaticResource Octadock.Color.Text}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextMuted" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.Accent" Color="{StaticResource Octadock.Color.Accent}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentText" Color="{StaticResource Octadock.Color.AccentText}" />
    <SolidColorBrush x:Key="Octadock.Brush.Danger" Color="{StaticResource Octadock.Color.Danger}" />
    <SolidColorBrush x:Key="Octadock.Brush.Hover" Color="{StaticResource Octadock.Color.Hover}" />
    <SolidColorBrush x:Key="Octadock.Brush.Pressed" Color="{StaticResource Octadock.Color.Pressed}" />
    <SolidColorBrush x:Key="Octadock.Brush.FocusRing" Color="{StaticResource Octadock.Color.FocusRing}" />
    <SolidColorBrush x:Key="Octadock.Brush.OnDanger" Color="{StaticResource Octadock.Color.OnDanger}" />
    <SolidColorBrush x:Key="Octadock.Brush.InputBackground" Color="{StaticResource Octadock.Color.InputBackground}" />
    <SolidColorBrush x:Key="Octadock.Brush.SelectionSubtle" Color="{StaticResource Octadock.Color.SelectionSubtle}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorder" Color="{StaticResource Octadock.Color.GlassBorder}" />

</ResourceDictionary>
