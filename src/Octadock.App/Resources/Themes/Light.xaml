<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Octadock light palette: warm-neutral canvas, clean white elevation,
        restrained teal, and low-contrast separators.
    -->

    <!-- Core colors -->
    <Color x:Key="Octadock.Color.Canvas">#FFF5F5F7</Color>
    <Color x:Key="Octadock.Color.Surface">#FFF5F5F7</Color>
    <Color x:Key="Octadock.Color.SurfaceAlt">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.SurfaceOverlay">#FFF0F0F2</Color>
    <Color x:Key="Octadock.Color.Border">#1A000000</Color>
    <Color x:Key="Octadock.Color.BorderStrong">#33000000</Color>
    <Color x:Key="Octadock.Color.Text">#FF1D1D1F</Color>
    <Color x:Key="Octadock.Color.TextMuted">#FF6E6E73</Color>
    <Color x:Key="Octadock.Color.TextSecondaryStrong">#FF3A3A3C</Color>
    <Color x:Key="Octadock.Color.TextDisabled">#FF9A9A9F</Color>
    <Color x:Key="Octadock.Color.Accent">#FF0B766D</Color>
    <Color x:Key="Octadock.Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.Danger">#FFDC2626</Color>
    <Color x:Key="Octadock.Color.Hover">#0D000000</Color>
    <Color x:Key="Octadock.Color.Pressed">#18000000</Color>

    <!-- Semantic tokens: focus visuals, input surfaces, selection, on-danger text -->
    <Color x:Key="Octadock.Color.FocusRing">#FF0B8F83</Color>
    <Color x:Key="Octadock.Color.OnDanger">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.InputBackground">#FFF0F0F2</Color>
    <Color x:Key="Octadock.Color.MediaBackdrop">#FF111113</Color>
    <Color x:Key="Octadock.Color.SelectionSubtle">#180B766D</Color>
    <Color x:Key="Octadock.Color.GlassBorder">#1F000000</Color>

    <!-- Status tokens (overlay cards, badges, toasts) -->
    <Color x:Key="Octadock.Color.Success">#FF16A34A</Color>
    <Color x:Key="Octadock.Color.Warning">#FFD97706</Color>
    <Color x:Key="Octadock.Color.Info">#FF0284C7</Color>
    <Color x:Key="Octadock.Color.Cloud">#FF7C3AED</Color>
    <Color x:Key="Octadock.Color.SuccessSoft">#1A16A34A</Color>
    <Color x:Key="Octadock.Color.WarningSoft">#1AD97706</Color>
    <Color x:Key="Octadock.Color.DangerSoft">#1ADC2626</Color>
    <Color x:Key="Octadock.Color.CloudSoft">#147C3AED</Color>
    <Color x:Key="Octadock.Color.AccentSoft">#160B766D</Color>

    <!-- Brushes (the documented reusable surface) -->
    <SolidColorBrush x:Key="Octadock.Brush.Canvas" Color="{StaticResource Octadock.Color.Canvas}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface" Color="{StaticResource Octadock.Color.Surface}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceAlt" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceRaised" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceOverlay" Color="{StaticResource Octadock.Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border" Color="{StaticResource Octadock.Color.Border}" />
    <SolidColorBrush x:Key="Octadock.Brush.BorderStrong" Color="{StaticResource Octadock.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text" Color="{StaticResource Octadock.Color.Text}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextMuted" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondary" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextSecondaryStrong" Color="{StaticResource Octadock.Color.TextSecondaryStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextDisabled" Color="{StaticResource Octadock.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Octadock.Brush.Accent" Color="{StaticResource Octadock.Color.Accent}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentText" Color="{StaticResource Octadock.Color.AccentText}" />
    <SolidColorBrush x:Key="Octadock.Brush.Danger" Color="{StaticResource Octadock.Color.Danger}" />
    <SolidColorBrush x:Key="Octadock.Brush.Hover" Color="{StaticResource Octadock.Color.Hover}" />
    <SolidColorBrush x:Key="Octadock.Brush.Pressed" Color="{StaticResource Octadock.Color.Pressed}" />
    <SolidColorBrush x:Key="Octadock.Brush.FocusRing" Color="{StaticResource Octadock.Color.FocusRing}" />
    <SolidColorBrush x:Key="Octadock.Brush.OnDanger" Color="{StaticResource Octadock.Color.OnDanger}" />
    <SolidColorBrush x:Key="Octadock.Brush.InputBackground" Color="{StaticResource Octadock.Color.InputBackground}" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaBackdrop" Color="{StaticResource Octadock.Color.MediaBackdrop}" />
    <SolidColorBrush x:Key="Octadock.Brush.SelectionSubtle" Color="{StaticResource Octadock.Color.SelectionSubtle}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorder" Color="{StaticResource Octadock.Color.GlassBorder}" />
    <SolidColorBrush x:Key="Octadock.Brush.Success" Color="{StaticResource Octadock.Color.Success}" />
    <SolidColorBrush x:Key="Octadock.Brush.Warning" Color="{StaticResource Octadock.Color.Warning}" />
    <SolidColorBrush x:Key="Octadock.Brush.Info" Color="{StaticResource Octadock.Color.Info}" />
    <SolidColorBrush x:Key="Octadock.Brush.Cloud" Color="{StaticResource Octadock.Color.Cloud}" />
    <SolidColorBrush x:Key="Octadock.Brush.SuccessSoft" Color="{StaticResource Octadock.Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.WarningSoft" Color="{StaticResource Octadock.Color.WarningSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.DangerSoft" Color="{StaticResource Octadock.Color.DangerSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.CloudSoft" Color="{StaticResource Octadock.Color.CloudSoft}" />
    <SolidColorBrush x:Key="Octadock.Brush.ByoKey" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.Gated" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentSoft" Color="{StaticResource Octadock.Color.AccentSoft}" />

    <!-- Semantic aliases (2026 design-system pass): the canonical names for new
         code. They forward to the core ramp above; the legacy keys stay valid. -->
    <SolidColorBrush x:Key="Octadock.Brush.Text.Primary" Color="{StaticResource Octadock.Color.Text}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text.Secondary" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text.Disabled" Color="{StaticResource Octadock.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Base" Color="{StaticResource Octadock.Color.Surface}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Raised" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.Surface.Overlay" Color="{StaticResource Octadock.Color.SurfaceOverlay}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border.Subtle" Color="{StaticResource Octadock.Color.Border}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border.Strong" Color="{StaticResource Octadock.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Hover" Color="{StaticResource Octadock.Color.Hover}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Pressed" Color="{StaticResource Octadock.Color.Pressed}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Focus" Color="{StaticResource Octadock.Color.FocusRing}" />
    <SolidColorBrush x:Key="Octadock.Brush.State.Selected" Color="{StaticResource Octadock.Color.SelectionSubtle}" />

    <!-- Capture/media overlays remain legible over arbitrary desktop pixels. -->
    <SolidColorBrush x:Key="Octadock.Brush.CaptureDim" Color="#B0000000" />
    <SolidColorBrush x:Key="Octadock.Brush.CapturePickerDim" Color="#40000000" />
    <SolidColorBrush x:Key="Octadock.Brush.EditorCropDim" Color="#78000000" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHighlightFill" Color="#330B766D" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChip" Color="#E6151F2B" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipText" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureChipMuted" Color="#FFB9C6D9" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureHandle" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderSubtle" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.CaptureBorderStrong" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabel" Color="#CC0B1018" />
    <SolidColorBrush x:Key="Octadock.Brush.MediaLabelText" Color="#FFFFFFFF" />

    <!-- A single accent keeps primary actions calm and predictable. -->
    <LinearGradientBrush x:Key="Octadock.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0B766D" Offset="0" />
        <GradientStop Color="#FF0B766D" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Octadock.Brush.WindowBackdrop" Color="{StaticResource Octadock.Color.Canvas}" />

    <!-- Floating light surfaces: one frosted shell and tonal rows. -->
    <SolidColorBrush x:Key="Octadock.Brush.GlassSurface" Color="#F8FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassChrome" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRow" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRail" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDense" Color="#F4FFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassRowDenseHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassHighlight" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorderStrong" Color="#29000000" />
    <LinearGradientBrush x:Key="Octadock.Brush.AccentRailWash" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000B766D" Offset="0" />
        <GradientStop Color="#140B766D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Octadock.Brush.AccentPill" Color="#180B766D" />
    <LinearGradientBrush x:Key="Octadock.Brush.RailFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#F8FFFFFF" Offset="0.26" />
        <GradientStop Color="#F8FFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
