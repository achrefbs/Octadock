<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Octadock light palette: white cards floating on a cool tinted canvas,
        deep-teal accent (WCAG AA on white). Same key set as Dark.xaml so the
        app can swap the merged dictionary at runtime.
    -->

    <!-- Core colors -->
    <Color x:Key="Octadock.Color.Surface">#FFF3F6FB</Color>
    <Color x:Key="Octadock.Color.SurfaceAlt">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.Border">#FFDAE2EE</Color>
    <Color x:Key="Octadock.Color.Text">#FF0D1526</Color>
    <Color x:Key="Octadock.Color.TextMuted">#FF5B6B84</Color>
    <Color x:Key="Octadock.Color.Accent">#FF0F766E</Color>
    <Color x:Key="Octadock.Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.Danger">#FFDC2626</Color>
    <Color x:Key="Octadock.Color.Hover">#12000000</Color>
    <Color x:Key="Octadock.Color.Pressed">#22000000</Color>

    <!-- Semantic tokens: focus visuals, input surfaces, selection, on-danger text -->
    <Color x:Key="Octadock.Color.FocusRing">#FF14B8A6</Color>
    <Color x:Key="Octadock.Color.OnDanger">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.InputBackground">#FFFFFFFF</Color>
    <Color x:Key="Octadock.Color.SelectionSubtle">#240F766E</Color>
    <Color x:Key="Octadock.Color.GlassBorder">#16000000</Color>

    <!-- Status tokens (overlay cards, badges, toasts) -->
    <Color x:Key="Octadock.Color.Success">#FF16A34A</Color>
    <Color x:Key="Octadock.Color.Warning">#FFD97706</Color>
    <Color x:Key="Octadock.Color.AccentSoft">#1A0F766E</Color>

    <!-- Brushes (the documented reusable surface) -->
    <SolidColorBrush x:Key="Octadock.Brush.Surface" Color="{StaticResource Octadock.Color.Surface}" />
    <SolidColorBrush x:Key="Octadock.Brush.SurfaceAlt" Color="{StaticResource Octadock.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Octadock.Brush.Border" Color="{StaticResource Octadock.Color.Border}" />
    <SolidColorBrush x:Key="Octadock.Brush.Text" Color="{StaticResource Octadock.Color.Text}" />
    <SolidColorBrush x:Key="Octadock.Brush.TextMuted" Color="{StaticResource Octadock.Color.TextMuted}" />
    <SolidColorBrush x:Key="Octadock.Brush.Accent" Color="{StaticResource Octadock.Color.Accent}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentText" Color="{StaticResource Octadock.Color.AccentText}" />
    <SolidColorBrush x:Key="Octadock.Brush.Danger" Color="{StaticResource Octadock.Color.Danger}" />
    <SolidColorBrush x:Key="Octadock.Brush.Hover" Color="{StaticResource Octadock.Color.Hover}" />
    <SolidColorBrush x:Key="Octadock.Brush.Pressed" Color="{StaticResource Octadock.Color.Pressed}" />
    <SolidColorBrush x:Key="Octadock.Brush.FocusRing" Color="{StaticResource Octadock.Color.FocusRing}" />
    <SolidColorBrush x:Key="Octadock.Brush.OnDanger" Color="{StaticResource Octadock.Color.OnDanger}" />
    <SolidColorBrush x:Key="Octadock.Brush.InputBackground" Color="{StaticResource Octadock.Color.InputBackground}" />
    <SolidColorBrush x:Key="Octadock.Brush.SelectionSubtle" Color="{StaticResource Octadock.Color.SelectionSubtle}" />
    <SolidColorBrush x:Key="Octadock.Brush.GlassBorder" Color="{StaticResource Octadock.Color.GlassBorder}" />
    <SolidColorBrush x:Key="Octadock.Brush.Success" Color="{StaticResource Octadock.Color.Success}" />
    <SolidColorBrush x:Key="Octadock.Brush.Warning" Color="{StaticResource Octadock.Color.Warning}" />
    <SolidColorBrush x:Key="Octadock.Brush.AccentSoft" Color="{StaticResource Octadock.Color.AccentSoft}" />

    <!-- The signature teal→cyan sweep used by primary buttons and hero accents. -->
    <LinearGradientBrush x:Key="Octadock.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0F766E" Offset="0" />
        <GradientStop Color="#FF0369A1" Offset="1" />
    </LinearGradientBrush>

    <!-- Soft vertical wash for window backgrounds (barely-there depth). -->
    <LinearGradientBrush x:Key="Octadock.Brush.WindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF5F8FC" Offset="0" />
        <GradientStop Color="#FFEFF3F9" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
