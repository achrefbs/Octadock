<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib">

    <!--
        ================================================================
        OCTADOCK DESIGN SYSTEM - shared resources (theme-independent)
        ================================================================
        Token pipeline: Octadock.Color.* (palette: Dark/Light/HighContrast.xaml)
        -> Octadock.Brush.* (semantic aliases) -> the styles in this file.
        Every color on a surface MUST map to an Octadock.Brush.* token.

        TOKEN GROUPS (prefer the semantic alias in new code; the legacy keys
        in parentheses stay valid and forward to the same values):
          Text     Octadock.Brush.Text.Primary | .Secondary | .Disabled
                   (= Text | TextMuted | TextDisabled; + TextSecondaryStrong)
          Surface  Octadock.Brush.Surface.Base | .Raised | .Overlay
                   (= Surface | SurfaceAlt/Raised | SurfaceOverlay; + Canvas,
                   WindowBackdrop, InputBackground for fields)
          Border   Octadock.Brush.Border.Subtle | .Strong (= Border | BorderStrong);
                   thickness Octadock.Border.Thickness = 1 (hairline, the default)
          State    Octadock.Brush.State.Hover | .Pressed | .Focus | .Selected
                   (= Hover | Pressed | FocusRing | SelectionSubtle)
          Accent   Octadock.Brush.Accent, AccentGradient (primary actions ONLY),
                   AccentSoft (selected wash), AccentPill, AccentText (on-accent)
          Status   Octadock.Brush.Success | Warning | Danger | Info | Cloud
                   (+ *Soft fill variants, OnDanger text)
          Glass    floating surfaces only: GlassSurface, GlassChrome,
                   GlassRow(+Hover), GlassRail, GlassRowDense(+Hover),
                   GlassBorder(+Strong), GlassHighlight, AccentRailWash, RailFade
          Capture  capture/media overlays only: Capture*, EditorCropDim,
                   MediaLabel*, PinAi* (tuned to read over arbitrary pixels)

        METRICS
          Corners  Octadock.Corner.Chip 4 | Corner 6 (controls) | .Pill/.Row 8 |
                   .CardDense 10 | .Large/.Window 12 | .Tile 16 | .Well 6 |
                   .Full capsule
          Spacing  Octadock.Space.05-.12 = 2/4/6/8/12/16/20/24/32/40/48
                   (+ Pad.Card, Pad.FloatingShell/Header, Pad.CompactRail,
                   Pad.DenseRow)
          Type     Octadock.FontSize.Display 28 | Title 20 | Section 16 |
                   Subtitle 14 | Body 13 | Caption 12 | Micro 11; styles
                   Octadock.Text.Display / Title / Section / SectionHeader /
                   Subtitle / Label / Body / Muted / Caption / Micro / Mono
          Icons    Lucide (PackIconLucide); sizes Octadock.Icon.Size.12/14/16/
                   20/24: 12 compact inline, 14 default in-row, 16 prominent,
                   20 hero, 24 empty states. Converge legacy 11/13/15/17/19/21
                   onto this ramp.
          Elevation Octadock.Shadow.Floating (floating windows/shells/pills) |
                   .Media (media frames) | .Popup (menus/tooltips/popovers).
                   Inline cards: hairline border only, NO shadow.
          Motion   Octadock.Motion.Duration.Fast 120ms | .Normal 200ms |
                   .Slow 320ms, easing Octadock.Motion.Easing.Standard.
                   Honor reduced motion: bool app flag Octadock.Motion.Enabled
                   (set by ThemeManager from Windows settings) gates animation.
          Glass    reduced transparency: ThemeManager swaps Glass* brushes to
                   opaque Surface* automatically; flag Octadock.Glass.Enabled.

        STYLES
          Buttons  Octadock.Style.Button (default, bordered) | .ToolButton
                   (subtle, flat) | .AccentButton (primary gradient) |
                   .DangerButton (quiet destructive) | .DangerButton.Filled
                   (confirm destructive)
          Icon btn Octadock.Style.IconButton (32px) | .HoverActionButton
                   (.Compact) (glass glyph rails) | .GlassChromeButton
                   (icon+label on glass) | .GlassFooterAction
          Inputs   TextBox / CheckBox / ComboBox(+Item) / DatePicker route
                   implicitly; RadioButton / Slider / ProgressBar / ToolTip /
                   ScrollBar implicit; Octadock.Style.ListBox + .ListBoxItem
                   are opt-in (replace per-window one-off item templates)
          Surfaces Octadock.Style.Card / .SectionCard (standard windows) |
                   .GlassSurface / .FloatingGlassShell / .MediaGlassFrame /
                   .GlassRow / .GlassRowDense / .GlassRail / .GlassChrome
                   (floating) | .ThumbnailWell / .ImageOnlyTile (media)
          Pills    Octadock.Style.CountPill (badges/counts) | .StatusPill
                   (transient floating status: recording/dictation/scrolling)
          Chrome   ContextMenu / MenuItem / Separator implicit | .DialogFooter
                   (standard-window footer bar) | .SettingsTabControl +
                   .SettingsTabItem (pill nav rail)

        TWO VISUAL FAMILIES - pick one per surface, never mix:
          Standard windows (Settings, History, Clipboard, Text Tools, editor,
          dialogs): opaque WindowBackdrop, native chrome themed by
          WindowChromeStyler, Card/SectionCard sections, Surface.* tokens,
          Button family, DialogFooter. No glass.
          Floating surfaces (dock, shelf, context stack, preview shell, status
          pills, capture overlays): borderless topmost glass - Glass* tokens,
          FloatingGlassShell, StatusPill, HoverActionButton rails. The glass
          family is dark-tuned; Light.xaml carries the frosted-white parallels.
    -->

    <!-- ===================== Metrics ===================== -->
    <CornerRadius x:Key="Octadock.Corner.Chip">4</CornerRadius>
    <CornerRadius x:Key="Octadock.Corner">8</CornerRadius>
    <CornerRadius x:Key="Octadock.Corner.Large">12</CornerRadius>
    <!-- Capsule radius echoing the dock pill's rounded chrome (nav rail items). -->
    <CornerRadius x:Key="Octadock.Corner.Pill">8</CornerRadius>
    <!-- Floating-window / panel radius (shelf, context stack, preview shell). -->
    <CornerRadius x:Key="Octadock.Corner.CardDense">10</CornerRadius>
    <CornerRadius x:Key="Octadock.Corner.Tile">16</CornerRadius>
    <CornerRadius x:Key="Octadock.Corner.Full">999</CornerRadius>
    <CornerRadius x:Key="Octadock.Corner.Window">14</CornerRadius>
    <!-- Compact glass row (shelf / context / clip). -->
    <CornerRadius x:Key="Octadock.Corner.Row">8</CornerRadius>
    <!-- Thumbnail well inside a row. -->
    <CornerRadius x:Key="Octadock.Corner.Well">6</CornerRadius>
    <Thickness x:Key="Octadock.Space.05">2</Thickness>
    <Thickness x:Key="Octadock.Space.1">4</Thickness>
    <Thickness x:Key="Octadock.Space.15">6</Thickness>
    <Thickness x:Key="Octadock.Space.2">8</Thickness>
    <Thickness x:Key="Octadock.Space.3">12</Thickness>
    <Thickness x:Key="Octadock.Space.4">16</Thickness>
    <Thickness x:Key="Octadock.Space.5">20</Thickness>
    <Thickness x:Key="Octadock.Space.6">24</Thickness>
    <Thickness x:Key="Octadock.Space.8">32</Thickness>
    <Thickness x:Key="Octadock.Space.10">40</Thickness>
    <Thickness x:Key="Octadock.Space.12">48</Thickness>
    <Thickness x:Key="Octadock.Pad.Card">12</Thickness>
    <Thickness x:Key="Octadock.Pad.FloatingShell">0</Thickness>
    <Thickness x:Key="Octadock.Pad.FloatingHeader">10,8,8,6</Thickness>
    <Thickness x:Key="Octadock.Pad.CompactRail">4</Thickness>
    <Thickness x:Key="Octadock.Pad.DenseRow">8,7</Thickness>

    <!-- Border thickness: hairline is the default everywhere; Strong is reserved
         for emphasis (active drag targets, destructive confirmations). -->
    <Thickness x:Key="Octadock.Border.Thickness">1</Thickness>
    <Thickness x:Key="Octadock.Border.Thickness.Strong">2</Thickness>

    <!-- ===================== Elevation =====================
         Floating surfaces cast a soft downward shadow; inline cards use a
         hairline border only (no shadow). Share these — never inline a new
         DropShadowEffect. -->
    <Color x:Key="Octadock.Color.Shadow">#FF03050A</Color>
    <DropShadowEffect x:Key="Octadock.Shadow.Floating" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.18" Color="{StaticResource Octadock.Color.Shadow}" />
    <DropShadowEffect x:Key="Octadock.Shadow.Media" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.2" Color="{StaticResource Octadock.Color.Shadow}" />
    <DropShadowEffect x:Key="Octadock.Shadow.Popup" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.16" Color="{StaticResource Octadock.Color.Shadow}" />

    <!-- ===================== Motion =====================
         Restrained durations for state changes. Honor reduced motion: the bool
         app resource Octadock.Motion.Enabled (set by ThemeManager from Windows
         settings) must gate every animation. -->
    <Duration x:Key="Octadock.Motion.Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Octadock.Motion.Duration.Normal">0:0:0.2</Duration>
    <Duration x:Key="Octadock.Motion.Duration.Slow">0:0:0.32</Duration>
    <CubicEase x:Key="Octadock.Motion.Easing.Standard" EasingMode="EaseOut" />

    <!-- ===================== Type sizes =====================
         Scalar companions of the Octadock.Text.* styles, for code-built text. -->
    <sys:Double x:Key="Octadock.FontSize.Display">28</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Section">16</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Subtitle">14</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="Octadock.FontSize.Micro">11</sys:Double>

    <!-- ===================== Icon sizes =====================
         Lucide (PackIconLucide) Width/Height ramp: 12 compact inline, 14 default
         in-row, 16 prominent, 20 hero, 24 empty states. Converge legacy one-off
         sizes (11/13/15/17/19/21) onto this ramp. -->
    <sys:Double x:Key="Octadock.Icon.Size.12">12</sys:Double>
    <sys:Double x:Key="Octadock.Icon.Size.14">14</sys:Double>
    <sys:Double x:Key="Octadock.Icon.Size.16">16</sys:Double>
    <sys:Double x:Key="Octadock.Icon.Size.20">20</sys:Double>
    <sys:Double x:Key="Octadock.Icon.Size.24">24</sys:Double>

    <!-- ===================== Typography ===================== -->
    <FontFamily x:Key="Octadock.Font">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="Octadock.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Octadock.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Title}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Display}" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <Style x:Key="Octadock.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Title}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Section}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="Octadock.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Octadock.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Octadock.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Octadock.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Caption}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="Octadock.Text.Micro" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Micro}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="14" />
    </Style>

    <!-- Form/control label: small, semibold, secondary-strong — sits above inputs. -->
    <Style x:Key="Octadock.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondaryStrong}" />
    </Style>

    <Style x:Key="Octadock.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Body}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Caption}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- ===================== Card container ===================== -->
    <Style x:Key="Octadock.Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Large}" />
        <Setter Property="Padding" Value="{StaticResource Octadock.Pad.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Tool button ======================
         A flat, quiet button for shelf/editor tool strips. Text or short label. -->
    <Style x:Key="Octadock.Style.ToolButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            SnapsToDevicePixels="True">
                        <!-- StateLayer sits ON TOP of the background so hover/pressed
                             overlay the accent fill instead of replacing it (which is
                             what made accent buttons vanish on hover). -->
                        <Grid>
                            <Border x:Name="StateLayer"
                                    CornerRadius="{StaticResource Octadock.Corner}"
                                    Background="{DynamicResource Octadock.Brush.Hover}"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent (primary) variant of the tool button: a restrained solid accent. -->
    <Style x:Key="Octadock.Style.AccentButton" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.AccentGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.AccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Destructive variant: quiet until hovered, always signals danger. -->
    <!-- Default (neutral) button: bordered, raised surface — the standard action
         in dialogs and window footers. ToolButton is the subtle/flat variant. -->
    <Style x:Key="Octadock.Style.Button" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <!-- Filled destructive variant: solid danger for confirm-delete actions in
         dialogs. DangerButton (below) stays the quiet inline destructive. -->
    <Style x:Key="Octadock.Style.DangerButton.Filled" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.OnDanger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="Octadock.Style.DangerButton" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Danger}" />
    </Style>

    <!-- ===================== Icon button ======================
         Square, compact button for a single glyph (Path/TextBlock content). -->
    <Style x:Key="Octadock.Style.IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="StateLayer"
                                    CornerRadius="{StaticResource Octadock.Corner}"
                                    Background="{DynamicResource Octadock.Brush.Hover}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Glass surfaces & rails (2026 redesign)

         The floating tools (shelf, context stack, preview shell, dock) are all
         built from a small kit of translucent, layered pieces so they read as
         one system: a GlassSurface panel, GlassChrome bars over media, compact
         GlassRow cards, an icon HoverActionButton rail, and small count pills.
         ===================================================================== -->

    <!-- Panel / window glass: near-opaque obsidian pane, hairline edge, big radius. -->
    <Style x:Key="Octadock.Style.GlassSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Window}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Octadock.Style.SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.CardDense}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Floating shell used by compact always-on-top utility windows. This is the
         pinned-image/context-stack grammar: one object, no detached subpanels. -->
    <Style x:Key="Octadock.Style.FloatingGlassShell" TargetType="Border" BasedOn="{StaticResource Octadock.Style.GlassSurface}">
        <Setter Property="Padding" Value="{StaticResource Octadock.Pad.FloatingShell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorderStrong}" />
        <Setter Property="Effect" Value="{StaticResource Octadock.Shadow.Floating}" />
    </Style>

    <!-- Media preview frame: same radius/shadow language as the pinned-image
         window, but leaves Background to the consumer so an ImageBrush can clip
         directly inside the rounded frame. -->
    <Style x:Key="Octadock.Style.MediaGlassFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Window}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource Octadock.Shadow.Media}" />
    </Style>

    <!-- Translucent chrome bar floating over media (preview top bar / metadata strip). -->
    <Style x:Key="Octadock.Style.GlassChrome" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassChrome}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A compact glass row: faint lighter pane on a panel, hairline edge, brighten
         on hover. Consumers drop content inside and (optionally) drive IsActive via
         an outer trigger. -->
    <Style x:Key="Octadock.Style.GlassRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Row}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassHighlight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact rail/header/footer: denser and more readable than a normal row
         when it floats over the desktop instead of sitting inside an app page. -->
    <Style x:Key="Octadock.Style.GlassRail" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRail}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Row}" />
        <Setter Property="Padding" Value="{StaticResource Octadock.Pad.CompactRail}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Dense row for file/context lists. It is intentionally stronger than the
         airy shelf row token so filenames stay readable over any wallpaper. -->
    <Style x:Key="Octadock.Style.GlassRowDense" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowDense}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="{StaticResource Octadock.Pad.DenseRow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowDenseHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorderStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thumbnail well: rounded, clipped image holder with a checker-dark base. -->
    <Style x:Key="Octadock.Style.ThumbnailWell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Well}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Image-only shelf tile. The resting state is just the screenshot; chrome
         appears inside the tile on hover. -->
    <Style x:Key="Octadock.Style.ImageOnlyTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Well}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassRowHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassHighlight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon rail button: quiet square glyph that brightens + gains a soft state
         layer on hover. Set Content to a Segoe MDL2 glyph. Override Foreground
         (e.g. Danger) as a local value to keep a tinted glyph through hover. -->
    <Style x:Key="Octadock.Style.HoverActionButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Octadock.Corner.Pill}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="StateLayer"
                                    CornerRadius="{StaticResource Octadock.Corner.Pill}"
                                    Background="{DynamicResource Octadock.Brush.Hover}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Smaller hover glyph used inside compact floating stacks. -->
    <Style x:Key="Octadock.Style.HoverActionButton.Compact" TargetType="Button" BasedOn="{StaticResource Octadock.Style.HoverActionButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Compact text action for floating stack footers. -->
    <Style x:Key="Octadock.Style.GlassFooterAction" TargetType="Button" BasedOn="{StaticResource Octadock.Style.ToolButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Chrome text/icon action for glass top bars (Copy / Save / Annotate …):
         icon + label content, no border, soft state layer on hover, pill radius. -->
    <Style x:Key="Octadock.Style.GlassChromeButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Octadock.Corner.Pill}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="StateLayer"
                                    CornerRadius="{StaticResource Octadock.Corner.Pill}"
                                    Background="{DynamicResource Octadock.Brush.Hover}"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Octadock.Brush.Pressed}" />
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded count / status pill (e.g. the shelf item count, "Pinned"). -->
    <!-- Transient floating status pill (recording / dictation / scrolling /
         countdown / read-aloud): rounded rectangular glass, strong hairline,
         floating elevation. Dot and
         label inside use Octadock.Brush.Danger / .Accent / .Text.Primary. -->
    <Style x:Key="Octadock.Style.StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.GlassSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.GlassBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Pill}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource Octadock.Shadow.Floating}" />
    </Style>

    <!-- Standard-window footer bar (dialogs, settings): raised strip with a top
         hairline; action buttons (Button / AccentButton / DangerButton.Filled)
         sit inside, right-aligned. -->
    <Style x:Key="Octadock.Style.DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource Octadock.Space.4}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Octadock.Style.CountPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.AccentPill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Section header ====================
         16px semibold heading used at the top of each settings card. -->
    <Style x:Key="Octadock.Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================== TextBox ===========================
         Themed input surface with a rounded border and an accent focus ring. -->
    <Style x:Key="Octadock.Style.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ==========================
         Custom rounded box with an accent tick when checked. -->
    <Style x:Key="Octadock.Style.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,5,0,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Width="11"
                                  Height="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Octadock.Brush.AccentText}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M2,6 L5,9 L10,2"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.TextMuted}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ==========================
         Themed toggle + popup. The ToggleButton template below is referenced by
         name from the ComboBox template, so the two styles ship together. -->
    <Style x:Key="Octadock.Style.ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Octadock.Brush.InputBackground}"
                            BorderBrush="{DynamicResource Octadock.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource Octadock.Brush.TextMuted}"
                                  Data="M0,0 L8,0 L4,4 Z" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.TextMuted}" />
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Octadock.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Octadock.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown row: transparent by default, accent-subtle when highlighted. -->
    <Style x:Key="Octadock.Style.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Octadock.Style.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Octadock.Style.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource Octadock.Style.ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Octadock.Corner}"
                                    Padding="3"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Settings tab rail =================
         TabControl reskinned as a left vertical rail of pill nav items with an
         accent-tinted selected pill; content sits in a padded panel to the right. -->
    <!-- ===================== ListBox ==========================
         Opt-in base list + item: transparent host, rounded items with hover /
         selected / focus states. Replaces per-window one-off item templates;
         filter chips and cards can still restyle on top via BasedOn. -->
    <Style x:Key="Octadock.Style.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.State.Selected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.State.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Octadock.Style.ListBox" TargetType="ListBox">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Octadock.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Octadock.Style.ListBoxItem}" />
    </Style>

    <Style x:Key="Octadock.Style.SettingsTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Octadock.Corner.Pill}"
                            Margin="0,1"
                            Padding="12,8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Selected-tab accent bar: the nav's one strong signal. -->
                            <Rectangle x:Name="Indicator"
                                       Grid.Column="0"
                                       Width="3"
                                       Margin="0,1,9,1"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{DynamicResource Octadock.Brush.AccentGradient}"
                                       Visibility="Hidden" />
                            <ContentPresenter x:Name="Header"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ScrollBar =========================
         Slim, flat scrollbar: transparent track, rounded muted thumb that
         brightens on hover. Applied implicitly app-wide. -->
    <Style x:Key="Octadock.Style.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Octadock.Style.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody"
                            Background="{DynamicResource Octadock.Brush.TextMuted}"
                            CornerRadius="4"
                            Opacity="0.45"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="0.95" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Octadock.Style.ScrollPageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Octadock.Style.ScrollPageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Octadock.Style.ScrollBarThumb}" Margin="2,1" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Octadock.Style.ScrollPageButton}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Octadock.Style.ScrollPageButton}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Octadock.Style.ScrollBarThumb}" Margin="1,2" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ToolTip ===========================
         Themed tooltip card. Applied implicitly app-wide. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Octadock.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Padding="9,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextBlock.FontSize="12"
                                          TextElement.Foreground="{DynamicResource Octadock.Brush.Text}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Context menu ======================
         Themed menu surface + rows. Applied implicitly app-wide so every
         right-click menu matches the theme instead of the Win32 default. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Octadock.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            Padding="10,6"
                            Margin="0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckMark"
                                       Grid.Column="0"
                                       Margin="0,0,7,0"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Octadock.Brush.Accent}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                       Text="{TemplateBinding InputGestureText}" />
                            <Path x:Name="SubArrow"
                                  Grid.Column="3"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="M0,0 L4,4 L0,8 Z"
                                  Fill="{DynamicResource Octadock.Brush.TextMuted}"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   Grid.Column="0"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Octadock.Corner}"
                                        Padding="4"
                                        Margin="2,0,0,0"
                                        SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu separators: a hairline rule. -->
    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="8,4"
                            Background="{DynamicResource Octadock.Brush.Border}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RadioButton ======================= -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Ring"
                                 Grid.Column="0"
                                 Width="18"
                                 Height="18"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Octadock.Brush.InputBackground}"
                                 Stroke="{DynamicResource Octadock.Brush.Border}"
                                 StrokeThickness="1" />
                        <Ellipse x:Name="Dot"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Fill="{DynamicResource Octadock.Brush.Accent}"
                                 Opacity="0" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Octadock.Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Octadock.Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider (horizontal) =============== -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Accent}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent" MinHeight="22">
                        <Border x:Name="TrackLine"
                                Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource Octadock.Brush.Border}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent" Height="22">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Octadock.Brush.Accent}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" Height="22" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob"
                                                     Fill="{DynamicResource Octadock.Brush.Accent}"
                                                     Stroke="{DynamicResource Octadock.Brush.Surface}"
                                                     StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="StrokeThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ProgressBar ======================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource Octadock.Brush.Border}"
                                CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Octadock.Brush.Accent}"
                                CornerRadius="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.35" To="1" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Implicit control themes ============
         Route the bare control types through the Octadock styles so windows
         that forget an explicit style still match the theme. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Octadock.Style.TextBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource Octadock.Style.CheckBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Octadock.Style.ComboBox}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Octadock.Style.ComboBoxItem}" />

    <!-- ===================== DatePicker =========================
         The collapsed date field (the always-visible control in the History
         filter row) is retemplated to the obsidian input look: a rounded dark
         field with a muted calendar glyph and an accent focus ring, replacing
         the Win32-default chrome that was the worst-themed control in the app.
         (The calendar popup keeps the framework default for now.) -->
    <Style x:Key="Octadock.Style.DatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Octadock.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Octadock.Brush.SelectionSubtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        <TextBlock x:Name="PART_Watermark"
                                   Text="Any date"
                                   Foreground="{DynamicResource Octadock.Brush.TextMuted}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Octadock.Style.DatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource Octadock.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Octadock.Corner}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource Octadock.Style.DatePickerTextBox}"
                                               VerticalAlignment="Center"
                                               Margin="9,0,0,0" />
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="30"
                                    Height="28"
                                    Focusable="False"
                                    Style="{StaticResource Octadock.Style.IconButton}">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Octadock.Brush.TextMuted}" />
                            </Button>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Bd}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource Octadock.Style.DatePicker}" />
    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource Octadock.Style.DatePickerTextBox}" />

    <Style x:Key="Octadock.Style.SettingsTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Octadock.Style.SettingsTabItem}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Left rail: pill nav items on a subtle raised surface. -->
                        <Border Grid.Column="0"
                                Width="176"
                                Background="{DynamicResource Octadock.Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Octadock.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Octadock.Corner.Large}"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </ScrollViewer>
                        </Border>
                        <!-- Content pane. -->
                        <Border Grid.Column="1"
                                Margin="14,0,0,0"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
