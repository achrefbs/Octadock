                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ===================== System ===================== -->
            <TabItem Header="_System"
                     Tag="section-system"
                     ToolTip="System · General"
                     AutomationProperties.Name="System and general settings">
                <TabControl Style="{StaticResource SecondaryTabControlStyle}"
                            AutomationProperties.Name="System sections">
                    <TabItem Header="_General"
                             Tag="general"
                             AutomationProperties.Name="General settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Control startup, desktop presence, diagnostics, and appearance." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Desktop presence" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Choose how Octadock starts and which Windows surfaces it occupies." />
                                            <CheckBox Content="Launch Octadock at login"
                                                      IsChecked="{Binding LaunchAtLogin}"
                                                      AutomationProperties.Name="Launch Octadock at login" />
                                            <CheckBox Content="Show the tray icon"
                                                      IsChecked="{Binding ShowTrayIcon}"
                                                      AutomationProperties.Name="Show the tray icon" />
                                            <CheckBox Content="Show the taskbar icon"
                                                      IsChecked="{Binding ShowTaskbarIcon}"
                                                      AutomationProperties.Name="Show the taskbar icon" />
                                            <CheckBox Content="Show the Octadock dock"
                                                      IsChecked="{Binding ShowDock}"
                                                      AutomationProperties.Name="Show the Octadock dock" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Diagnostics" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Crash reports are saved locally only when you opt in; Octadock never uploads them automatically." />
                                            <CheckBox Content="Save local crash reports"
                                                      IsChecked="{Binding CrashReportingEnabled}"
                                                      AutomationProperties.Name="Save local crash reports" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Follow Windows or choose a consistent light or dark theme." />
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Theme" />
                                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                          SelectedItem="{Binding Theme}"
                                                          AutomationProperties.Name="Application theme" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Shortcuts"
                             Tag="shortcuts"
                             AutomationProperties.Name="Keyboard shortcut settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Keyboard shortcuts" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Focus a shortcut box and press a key combination. Press Esc to clear it; conflicts are announced beside the affected rows." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Global shortcuts" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Shortcuts work while Octadock is running, even when another app has focus." />
                                            <ItemsControl ItemsSource="{Binding Shortcuts}"
                                                          AutomationProperties.Name="Global shortcuts">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource Octadock.Text.Body}"
                                                                       Text="{Binding Label}" />
                                                            <local:HotkeyRecorderBox Grid.Column="1"
                                                                                     HorizontalAlignment="Left"
                                                                                     Gesture="{Binding Gesture, Mode=TwoWay}"
                                                                                     GestureCaptured="OnGestureCaptured"
                                                                                     Tag="{Binding}"
                                                                                     AutomationProperties.Name="{Binding Label}"
                                                                                     AutomationProperties.HelpText="Press a key combination. Press Escape to clear." />
                                                            <TextBlock Grid.Column="2"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource Octadock.Brush.Danger}"
                                                                       Text="Conflict"
                                                                       Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisibility}}"
                                                                       AutomationProperties.LiveSetting="Polite" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Automation"
                             Tag="automation"
                             AutomationProperties.Name="Automation settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Automation" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Connect Octadock to scripts and trusted local tools through explicit opt-in entry points." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Entry points" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Enable only the automation surfaces you intend to use." />
                                            <CheckBox Content="Register the octadock:// URL protocol"
                                                      IsChecked="{Binding ProtocolEnabled}"
                                                      AutomationProperties.Name="Register the Octadock URL protocol" />
                                            <CheckBox Content="Enable the octadock.exe command-line interface"
                                                      IsChecked="{Binding CliEnabled}"
                                                      AutomationProperties.Name="Enable the Octadock command-line interface" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Example commands" />
                                            <ItemsControl ItemsSource="{Binding AutomationExamples}"
                                                          Margin="0,8,0,0"
                                                          AutomationProperties.Name="Automation command examples">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource Octadock.Brush.TextSecondary}"
                                                                 FontFamily="Cascadia Mono, Cascadia Code, Consolas"
                                                                 FontSize="12"
                                                                 Margin="0,2"
                                                                 AutomationProperties.Name="Example automation command" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Ad_vanced"
                             Tag="advanced"
                             AutomationProperties.Name="Advanced system settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Advanced" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Storage locations and a full settings reset." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Local storage" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Logs are stored under %LOCALAPPDATA%\Octadock\Logs. Captures, thumbnails, and the SQLite database stay under %LOCALAPPDATA%\Octadock." />
                                            <Button Content="_Restore all defaults"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource Octadock.Style.DangerButton}"
                                                    Command="{Binding ResetToDefaultsCommand}"
                                                    AutomationProperties.Name="Restore all settings to defaults" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ===================== Account ===================== -->
            <TabItem Header="_Account"
                     Tag="account"
                     ToolTip="Account"
                     AutomationProperties.Name="Account and billing settings">
                <TabControl Style="{StaticResource SecondaryTabControlStyle}"
                            AutomationProperties.Name="Account sections">
                    <TabItem Header="_License"
                             Tag="license"
                             AutomationProperties.Name="License settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Account &amp; Billing" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Your Octadock license lives on this PC. The 14-day trial needs no account and no card." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="License status" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,7">
                                                <Border Background="{DynamicResource Octadock.Brush.AccentSoft}"
                                                        BorderThickness="0"
                                                        CornerRadius="{StaticResource Octadock.Corner.Chip}"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="License status">
                                                    <TextBlock Text="{Binding LicenseChipLabel}"
                                                               Style="{StaticResource Octadock.Text.Micro}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding LicenseHeadline}"
                                                           Style="{StaticResource Octadock.Text.Subtitle}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LicenseDetail}"
                                                       Style="{StaticResource Octadock.Text.Muted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,18"
                                                       AutomationProperties.LiveSetting="Polite" />

                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="License key" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="License key"
                                                             FontFamily="Cascadia Mono, Cascadia Code, Consolas" />
                                                    <Button Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            MinWidth="112"
                                                            Content="_Activate"
                                                            Style="{StaticResource Octadock.Style.AccentButton}"
                                                            Command="{Binding ActivateCommand}"
                                                            IsEnabled="{Binding CanActivate}"
                                                            AutomationProperties.Name="Activate license key" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="Paste OCTA-XXXXX-XXXXX-XXXXX-XXXXX from your purchase email. Spaces and letter case do not matter." />
                                                <TextBlock Text="{Binding ActivationMessage}"
                                                           Style="{StaticResource Octadock.Text.Body}"
                                                           Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           AutomationProperties.Name="License activation result"
                                                           AutomationProperties.LiveSetting="Assertive" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Need a license?" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Octadock is a one-time $49 local license for 3 devices, including 12 months of updates. The installed version keeps working after updates end." />
                                            <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                       Text="Buy at octadock.com and your key arrives by email." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Sticky footer: status remains visible while page content scrolls. -->
        <Border Grid.Row="1"
                Margin="184,0,0,0"
                Padding="24,12"
                Style="{StaticResource Octadock.Style.DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Octadock.Text.Body}"
                           Foreground="{DynamicResource Octadock.Brush.TextSecondary}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Settings status"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="_Close"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Style="{StaticResource Octadock.Style.ToolButton}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="Close settings without saving" />
                    <Button Content="_Save"
                            MinWidth="112"
                            IsDefault="True"
                            Style="{StaticResource Octadock.Style.AccentButton}"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.Name="Save settings" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
