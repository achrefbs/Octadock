            </TabItem>

            <!-- ===================== Voice ===================== -->
            <TabItem Header="_Voice"
                     Tag="speech"
                     ToolTip="Voice"
                     AutomationProperties.Name="Voice settings">
                <TabControl Style="{StaticResource SecondaryTabControlStyle}"
                            AutomationProperties.Name="Voice sections">
                    <TabItem Header="_Dictation"
                             Tag="dictation"
                             AutomationProperties.Name="Dictation settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Dictation" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Turn speech into text in any app. Local engines are the default; cloud transcription is always an explicit choice." />

                                    <Border Style="{StaticResource LocalNotice}"
                                            AutomationProperties.Name="Local dictation privacy">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Octadock.Brush.Accent}"
                                                    CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Style="{StaticResource Octadock.Text.Subtitle}" Text="Local by default" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                           Margin="0,3,0,0"
                                                           Text="Parakeet and Whisper run on this PC after a one-time model download. Your microphone audio and transcript stay on this device." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource CloudNotice}"
                                            AutomationProperties.Name="Optional cloud dictation privacy">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Octadock.Brush.Cloud}"
                                                    CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Style="{StaticResource Octadock.Text.Subtitle}" Text="Cloud is optional" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                           Margin="0,3,0,0"
                                                           Text="OpenAI is used only when you select it and provide your own scoped key. That choice sends microphone audio to OpenAI for transcription." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Language coverage" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Leave language blank for automatic detection. Parakeet covers 25 European languages; Whisper covers 99 languages." />
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Language code" />
                                                <TextBox Width="180"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding SpeechLanguage}"
                                                         AutomationProperties.Name="Dictation language code"
                                                         AutomationProperties.HelpText="Leave blank to detect the language automatically." />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           Text="Examples: en, es, de, pt-BR. Unsupported explicit languages route to the broader local engine when available." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Microphone" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Choose the input device dictation listens to. Windows privacy settings must also allow desktop apps to use the microphone." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Input device" />
                                                <ComboBox ItemsSource="{Binding SpeechMicrophoneOptions}"
                                                          DisplayMemberPath="FriendlyName"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding SpeechMicrophoneDeviceId}"
                                                          AutomationProperties.Name="Dictation microphone" />
                                            </StackPanel>
                                            <Button Content="Open microphone privacy settings"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                                    Command="{Binding OpenMicrophonePrivacySettingsCommand}"
                                                    AutomationProperties.Name="Open Windows microphone privacy settings" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Insertion" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Paste at the cursor for a seamless workflow, leave the result on the clipboard when an app blocks synthetic input, or review and edit the transcript before it is inserted." />
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Insert transcript" />
                                                <ComboBox ItemsSource="{Binding SpeechInsertionModeOptions}"
                                                          SelectedItem="{Binding SpeechInsertionMode}"
                                                          AutomationProperties.Name="Transcript insertion mode" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           Text="paste — insert at the cursor · clipboard — leave on the clipboard · review — edit on the dictation pill, then Insert or Discard." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Shortcut" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Press the Dictation shortcut once to start and again to stop. Set or change it under System → Shortcuts; push-to-talk and combined activation are under Voice → Advanced." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Read aloud"
                             Tag="read-aloud"
                             AutomationProperties.Name="Read aloud settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Read aloud" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Listen to selected text with a Windows voice, or explicitly opt into an external voice provider." />

                                    <Border Style="{StaticResource LocalNotice}"
                                            AutomationProperties.Name="Local read aloud privacy">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Octadock.Brush.Accent}"
                                                    CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Style="{StaticResource Octadock.Text.Subtitle}" Text="Windows voices stay local" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                           Margin="0,3,0,0"
                                                           Text="The default Windows voice reads selected text on this PC without sending it to a speech provider." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource CloudNotice}"
                                            AutomationProperties.Name="Optional cloud read aloud privacy">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Octadock.Brush.Cloud}"
                                                    CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Style="{StaticResource Octadock.Text.Subtitle}" Text="External voices are explicit" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                           Margin="0,3,0,0"
                                                           Text="Choosing ElevenLabs sends the selected text to that provider. Windows voices stay completely local." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Voice and pace" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Select the engine, an optional voice name or ID, and a comfortable speaking rate." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Voice provider" />
                                                <ComboBox ItemsSource="{Binding ReadTtsProviderOptions}"
                                                          SelectedItem="{Binding ReadTtsProvider}"
                                                          AutomationProperties.Name="Read aloud voice provider" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Voice" />
                                                <TextBox Width="260"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding ReadVoice}"
                                                         AutomationProperties.Name="Voice name or provider voice ID"
                                                         AutomationProperties.HelpText="Leave blank to use the provider default." />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Speaking rate" />
                                                <ComboBox Width="140"
                                                          MinWidth="140"
                                                          HorizontalAlignment="Left"
                                                          ItemsSource="{Binding ReadRateOptions}"
                                                          SelectedItem="{Binding ReadRate}"
                                                          AutomationProperties.Name="Speaking rate" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Advanced"
                             Tag="speech-advanced"
                             AutomationProperties.Name="Advanced voice settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Advanced voice" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Recognition model, voice-activity behavior, activation gestures, model storage, and transcript replacement rules." />

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Recognition model" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Most people can keep the local default. Choose a provider or exact model only when you need different coverage or deployment behavior." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Speech provider" />
                                                <ComboBox ItemsSource="{Binding SpeechProviderOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding SpeechProvider}"
                                                          AutomationProperties.Name="Speech-to-text provider" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Whisper model" />
                                                <ComboBox ItemsSource="{Binding SpeechWhisperModelOptions}"
                                                          SelectedItem="{Binding SpeechWhisperModel}"
                                                          AutomationProperties.Name="Whisper model" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="OpenAI model" />
                                                <ComboBox ItemsSource="{Binding SpeechOpenAiModelOptions}"
                                                          SelectedItem="{Binding SpeechOpenAiModel}"
                                                          AutomationProperties.Name="OpenAI transcription model" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Voice activity" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Live previews and auto-stop use the local voice-activity detector with a streaming-capable engine; without them dictation simply records, then transcribes." />
                                            <CheckBox IsChecked="{Binding SpeechLivePartials}"
                                                      Content="Show the live transcript while speaking"
                                                      AutomationProperties.Name="Show the live transcript while speaking" />
                                            <CheckBox IsChecked="{Binding SpeechAutoStopOnSilence}"
                                                      Content="Stop and insert after about 2 seconds of silence"
                                                      AutomationProperties.Name="Stop and insert automatically after silence" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Activation mode" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Toggle is the simplest default. Hold enables push-to-talk; both keeps both gestures active." />
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Activation" />
                                                <ComboBox ItemsSource="{Binding SpeechActivationModeOptions}"
                                                          SelectedItem="{Binding SpeechActivationMode}"
                                                          AutomationProperties.Name="Dictation activation mode"
                                                          AutomationProperties.HelpText="Toggle, hold for push-to-talk, or both." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Model storage and management" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Local model downloads resume if interrupted and are verified before use." />
                                            <ItemsControl ItemsSource="{Binding SpeechModels}"
                                                          AutomationProperties.Name="Local speech models">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Octadock.Text.Body}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}" />
                                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                                           Text="{Binding StatusText}"
                                                                           AutomationProperties.LiveSetting="Polite" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="_Download"
                                                                    MinWidth="92"
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                                                    Command="{Binding DownloadCommand}"
                                                                    IsEnabled="{Binding CanDownload}"
                                                                    AutomationProperties.Name="Download speech model" />
                                                            <Button Grid.Column="2"
                                                                    Content="_Cancel"
                                                                    MinWidth="76"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource Octadock.Style.ToolButton}"
                                                                    Command="{Binding CancelDownloadCommand}"
                                                                    IsEnabled="{Binding CanCancel}"
                                                                    AutomationProperties.Name="Cancel speech model download" />
                                                            <Button Grid.Column="3"
                                                                    Content="D_elete"
                                                                    MinWidth="76"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource Octadock.Style.DangerButton}"
                                                                    Command="{Binding DeleteCommand}"
                                                                    IsEnabled="{Binding CanDelete}"
                                                                    AutomationProperties.Name="Delete speech model" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,10,0,0"
                                                       Style="{StaticResource Octadock.Text.Caption}"
                                                       Text="{Binding SpeechModelStorageText}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Speech model storage location" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Style="{StaticResource Octadock.Text.Caption}"
                                                       Text="{Binding SpeechAvailabilityText}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Speech provider availability"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="User dictionary" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Replace spoken technical terms after transcription." />
                                            <TextBox MinHeight="116"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding SpeechCustomDictionary, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="User dictionary replacement rules"
                                                     AutomationProperties.HelpText="Enter one spoken form and replacement per line, separated by an arrow." />
                                            <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                       Margin="0,6,0,0"
                                                       Text="One rule per line: spoken form =&gt; replacement. Lines starting with # are comments." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ===================== Library ===================== -->
            <TabItem Header="_Library"
                     Tag="section-library"
                     ToolTip="Library"
                     AutomationProperties.Name="Library settings">
                <TabControl Style="{StaticResource SecondaryTabControlStyle}"
                            AutomationProperties.Name="Library sections">
                    <TabItem Header="_Shelf"
                             Tag="shelf"
                             AutomationProperties.Name="Capture shelf settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Capture shelf" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                                Text="A compact, connected home for recent captures and secondary capture modes." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance and position" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Every capture uses the same 16:9 card canvas inside one unified Shelf shell." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Anchor corner" />
                                                <ComboBox ItemsSource="{Binding ShelfAnchorOptions}"
                                                          SelectedItem="{Binding ShelfAnchor}"
                                                          AutomationProperties.Name="Shelf anchor corner" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Item size" />
                                                <ComboBox ItemsSource="{Binding ShelfSizeOptions}"
                                                          SelectedItem="{Binding ShelfSize}"
                                                          AutomationProperties.Name="Shelf item size" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Edge margin" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding ShelfMarginDip}"
                                                         AutomationProperties.Name="Shelf edge margin in device-independent pixels" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Maximum stacked items" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding ShelfMaxItems}"
                                                         AutomationProperties.Name="Maximum stacked shelf items" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0,14,0,0">
                                                <TextBlock Style="{StaticResource Label}" Text="Edge tab" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           TextWrapping="Wrap"
                                                           Text="The small tab stays fixed at the selected corner. Click it to collapse or restore the Shelf; the Shelf follows the active screen while idle." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Lifecycle" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Choose when the shelf closes and whether its most recently closed item can be restored." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Auto-close" />
                                                <ComboBox ItemsSource="{Binding ShelfAutoCloseOptions}"
                                                          SelectedItem="{Binding ShelfAutoClose}"
                                                          AutomationProperties.Name="Shelf auto-close timing" />
                                            </StackPanel>
                                            <CheckBox Content="Allow restoring the most recently closed item"
                                                      IsChecked="{Binding ShelfRestoreEnabled}"
                                                      AutomationProperties.Name="Allow restoring the most recently closed shelf item" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_History"
                             Tag="history"
                             AutomationProperties.Name="Capture history settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Capture history" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Keep a local record of captures and decide how long Octadock retains it." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Retention" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="History stays on this PC and remains available independently of the shelf." />
                                            <CheckBox Content="Keep a local history of captures"
                                                      IsChecked="{Binding HistoryEnabled}"
                                                      AutomationProperties.Name="Keep a local history of captures" />
                                            <StackPanel Style="{StaticResource Field}" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource Label}" Text="Keep captures for" />
                                                <ComboBox ItemsSource="{Binding RetentionOptions}"
                                                          SelectedItem="{Binding HistoryRetention}"
                                                          AutomationProperties.Name="Capture history retention period" />
                                            </StackPanel>
                                            <Button Content="_Clear history…"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,12,0,0"
                                                    Style="{StaticResource Octadock.Style.DangerButton}"
                                                    Click="OnClearHistory"
                                                    AutomationProperties.Name="Clear capture history" />
                                            <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                       Margin="0,6,0,0"
                                                       Text="Clearing moves captures to soft-deleted. Files are purged later by the retention pass." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Clipboard"
                             Tag="clipboard"
                             AutomationProperties.Name="Clipboard history settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Clipboard history" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Clipboard history is off until you turn it on. When enabled, copied text and images are retained only on this PC; content marked private by password managers is never recorded." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Local clipboard monitor" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Saved clips remain until you clear them or automatic trimming removes the oldest non-favorites." />
                                            <CheckBox Content="Watch the clipboard and keep a local history"
                                                      IsChecked="{Binding ClipboardMonitorEnabled}"
                                                      AutomationProperties.Name="Watch the clipboard and keep a local history" />
                                            <CheckBox Content="Also keep copied images"
                                                      IsChecked="{Binding ClipboardIncludeImages}"
                                                      AutomationProperties.Name="Also keep copied images" />
                                            <StackPanel Style="{StaticResource Field}" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource Label}" Text="Maximum clips" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding ClipboardMaxItems, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Maximum clipboard history items" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                       Margin="0,6,0,0"
                                                       Text="Turn this off to pause without deleting saved clips. Use Clear in Clipboard History to permanently remove them. Favorites do not count against automatic trimming." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

