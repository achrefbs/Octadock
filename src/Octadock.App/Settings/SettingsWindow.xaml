<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide" xmlns:local="clr-namespace:Octadock.App.Settings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Octadock.App.Settings.SettingsWindow" Title="Octadock Settings" Width="900" Height="680" MinWidth="480" MinHeight="420" Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource Octadock.Brush.WindowBackdrop}" FontFamily="{DynamicResource Octadock.Font}" Foreground="{DynamicResource Octadock.Brush.Text}" UseLayoutRounding="True" SnapsToDevicePixels="True" FocusManager.FocusedElement="{Binding ElementName=Tabs}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" AutomationProperties.Name="Octadock settings">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="local:HotkeyRecorderBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:HotkeyRecorderBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Octadock.Corner}" Padding="10,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding DisplayText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Label}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,16,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Label}">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionDescription" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Title}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,18" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="SettingsPageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>
        <Style x:Key="PageCanvas" TargetType="Grid">
            <Setter Property="MaxWidth" Value="680" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="28,28,28,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="22,20,22,14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreferenceTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <icons:PackIconLucide x:Name="Icon" Kind="Settings2" Width="16" Height="16" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="capture">
                                <Setter TargetName="Icon" Property="Kind" Value="Camera" />
                            </Trigger>
                            <Trigger Property="Tag" Value="recording">
                                <Setter TargetName="Icon" Property="Kind" Value="Video" />
                            </Trigger>
                            <Trigger Property="Tag" Value="shelf">
                                <Setter TargetName="Icon" Property="Kind" Value="Layers" />
                            </Trigger>
                            <Trigger Property="Tag" Value="history">
                                <Setter TargetName="Icon" Property="Kind" Value="Clock" />
                            </Trigger>
                            <Trigger Property="Tag" Value="clipboard">
                                <Setter TargetName="Icon" Property="Kind" Value="Clipboard" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ocr">
                                <Setter TargetName="Icon" Property="Kind" Value="ScanText" />
                            </Trigger>
                            <Trigger Property="Tag" Value="dictation">
                                <Setter TargetName="Icon" Property="Kind" Value="Mic" />
                            </Trigger>
                            <Trigger Property="Tag" Value="read-aloud">
                                <Setter TargetName="Icon" Property="Kind" Value="Volume2" />
                            </Trigger>
                            <Trigger Property="Tag" Value="speech-advanced">
                                <Setter TargetName="Icon" Property="Kind" Value="HardDrive" />
                            </Trigger>
                            <Trigger Property="Tag" Value="shortcuts">
                                <Setter TargetName="Icon" Property="Kind" Value="Keyboard" />
                            </Trigger>
                            <Trigger Property="Tag" Value="automation">
                                <Setter TargetName="Icon" Property="Kind" Value="Terminal" />
                            </Trigger>
                            <Trigger Property="Tag" Value="advanced">
                                <Setter TargetName="Icon" Property="Kind" Value="Folder" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreferenceTabs" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PreferenceTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SidebarWidth" Width="184" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Sidebar" Background="{DynamicResource Octadock.Brush.GlassRail}" BorderBrush="{DynamicResource Octadock.Brush.Border}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="20,24,18,20">
                                        <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Octadock.Brush.Text}" />
                                        <TextBlock Text="Octadock" FontSize="12" Foreground="{DynamicResource Octadock.Brush.TextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,0,12">
                                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="CompactNavigation" Visibility="Collapsed" Background="{DynamicResource Octadock.Brush.GlassRail}" BorderBrush="{DynamicResource Octadock.Brush.Border}" BorderThickness="0,0,0,1" Padding="22,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="208" MinWidth="0" ItemsSource="{Binding NavigationItems, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="Settings page" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" SnapsToDevicePixels="True" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="SidebarWidth" Property="Width" Value="0" />
                                <Setter TargetName="Sidebar" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CompactNavigation" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding Content}" Margin="0,0,22,0" VerticalAlignment="Center">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Octadock.Brush.Text}" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                                <Border x:Name="Track" Grid.Column="1" Width="36" Height="22" CornerRadius="11" Background="{DynamicResource Octadock.Brush.BorderStrong}" VerticalAlignment="Center" Padding="3">
                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Octadock.Brush.Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusSurface" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Octadock.Style.ComboBox}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Octadock.Style.TextBox}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{DynamicResource Octadock.Brush.WindowBackdrop}" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Grid.Row="0" Style="{StaticResource PreferenceTabs}" SelectedValuePath="Tag" KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="Settings categories" SelectionChanged="OnPageSelectionChanged">
            <TabItem Header="General" Tag="general" AutomationProperties.Name="General settings" ToolTip="General">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                    <Grid Style="{StaticResource PageCanvas}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="On this desktop" />
                                    <CheckBox Content="Launch Octadock at login" IsChecked="{Binding LaunchAtLogin}" AutomationProperties.Name="Launch Octadock at login" />
                                    <CheckBox Content="Show the tray icon" IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="Show the tray icon" />
                                    <CheckBox Content="Show the taskbar icon" IsChecked="{Binding ShowTaskbarIcon}" AutomationProperties.Name="Show the taskbar icon" />
                                    <CheckBox Content="Show the dock" IsChecked="{Binding ShowDock}" AutomationProperties.Name="Show the Octadock dock" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Diagnostics" />
                                    <CheckBox Content="Keep local crash reports" IsChecked="{Binding CrashReportingEnabled}" AutomationProperties.Name="Save local crash reports" AutomationProperties.HelpText="Saves crash details on this PC without uploading them." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Theme" Grid.Column="0" />
                                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Application theme" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Screenshots" Tag="capture" AutomationProperties.Name="Screenshot settings" ToolTip="Screenshots">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                    <Grid Style="{StaticResource PageCanvas}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Screenshots" />
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Output" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="After capture" Grid.Column="0" />
                                        <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding DefaultAction}" AutomationProperties.Name="Default post-capture action" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Save folder" Grid.Column="0" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SaveDirectory}" AutomationProperties.Name="Save folder" AutomationProperties.HelpText="Leave blank to choose a folder each time." />
                                            <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="_Browse…" Style="{StaticResource Octadock.Style.ToolButton}" Click="OnBrowseSaveDirectory" AutomationProperties.Name="Browse for save folder" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Octadock.Text.Caption}" Margin="0,5,0,2" Text="Leave empty to choose each time." Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Image" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Format" Grid.Column="0" />
                                        <ComboBox ItemsSource="{Binding ImageFormatOptions}" SelectedItem="{Binding ImageFormat}" AutomationProperties.Name="Image format" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <CheckBox Content="Include the mouse cursor" IsChecked="{Binding IncludeCursor}" AutomationProperties.Name="Include the mouse cursor in screenshots" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Selection" />
                                    <CheckBox Content="Freeze during selection" IsChecked="{Binding FreezeScreen}" AutomationProperties.Name="Freeze the screen while selecting" AutomationProperties.HelpText="Captures a still frame of the desktop up front so moving content does not shift under the selection." />
                                    <CheckBox Content="Show dimensions and magnifier" IsChecked="{Binding PrecisionAids}" AutomationProperties.Name="Show precision aids while selecting" AutomationProperties.HelpText="Shows the live selection dimensions and the magnifier loupe during area selection." />
                                </StackPanel>
                            </Border>
                            <Expander Header="More capture options" Margin="0,0,0,16" AutomationProperties.Name="More capture options">
                                <StackPanel Margin="0,18,0,0">
                                    <Border Style="{StaticResource SettingsSection}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Naming and compression" />
                                            <Grid Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Filename template" Grid.Column="0" />
                                                <TextBox Text="{Binding FilenameTemplate}" AutomationProperties.Name="Filename template" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}" Margin="0,5,0,2" Text="Tokens: {yyyy} {MM} {dd} {HH} {mm} {ss} {process} {window} {type} {counter}" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" FontSize="11" />
                                            </Grid>
                                            <Grid Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="JPEG quality" Grid.Column="0" />
                                                <TextBox HorizontalAlignment="Stretch" Text="{Binding JpegQuality}" AutomationProperties.Name="JPEG quality from 1 to 100" Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsSection}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Capture behavior" />
                                            <Grid Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Fullscreen capture" Grid.Column="0" />
                                                <ComboBox ItemsSource="{Binding MultiMonitorOptions}" SelectedItem="{Binding MultiMonitorMode}" AutomationProperties.Name="Multi-monitor fullscreen mode" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                            </Grid>
                                            <Grid Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Self-timer" Grid.Column="0" />
                                                <TextBox HorizontalAlignment="Stretch" Text="{Binding SelfTimerSeconds}" AutomationProperties.Name="Self-timer seconds" Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                            <CheckBox Content="Include shadow and frame" IsChecked="{Binding WindowShadow}" AutomationProperties.Name="Include the window shadow and frame" />
                                            <CheckBox Content="Include Octadock overlays" IsChecked="{Binding IncludeOctadockInScreenshotsAndRecordings}" AutomationProperties.Name="Include Octadock overlays in screen captures and desktop recordings" AutomationProperties.HelpText="When enabled, the Dock, Shelf, and status pills remain visible in area or full-screen captures and supported desktop recordings. Window-only captures still contain only the selected app." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsSection}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Size and ratio" />
                                            <CheckBox Content="Use a fixed selection size" IsChecked="{Binding FixedSizeEnabled}" AutomationProperties.Name="Use a fixed selection size" AutomationProperties.HelpText="Area selection places a rectangle of exactly this size; click to position it, Enter to capture." />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBox Width="90" Text="{Binding FixedWidth}" AutomationProperties.Name="Fixed selection width in pixels" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}" Margin="8,0" VerticalAlignment="Center" Text="×" TextWrapping="Wrap" />
                                                <TextBox Width="90" Text="{Binding FixedHeight}" AutomationProperties.Name="Fixed selection height in pixels" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="pixels" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Content="Lock the selection aspect ratio" Margin="0,10,0,0" IsChecked="{Binding LockAspectRatio}" AutomationProperties.Name="Lock the selection aspect ratio" AutomationProperties.HelpText="New area selections keep the width-to-height ratio of the previous selection." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsSection}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Scrolling capture (Beta)" />
                                            <TextBlock Style="{StaticResource SectionDescription}" Text="Scroll the selected viewport, then choose Finish. Manual vertical capture only." />
                                            <TextBlock Style="{StaticResource Octadock.Text.Caption}" TextWrapping="Wrap" Text="After you select the viewport, scroll the page; the session pill shows the stitched height and its Finish button completes the capture." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
