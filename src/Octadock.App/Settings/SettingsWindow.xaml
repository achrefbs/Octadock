                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Octadock.Text.Body}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,14,0" />
                                                    <local:HotkeyRecorderBox Grid.Column="1" HorizontalAlignment="Stretch" Gesture="{Binding Gesture, Mode=TwoWay}" GestureCaptured="OnGestureCaptured" Tag="{Binding}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="Press a key combination. Press Escape to clear." />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource Octadock.Brush.Danger}" Text="Conflict" Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" Grid.Row="1" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Automation" Tag="automation" AutomationProperties.Name="Automation settings" ToolTip="Automation">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                    <Grid Style="{StaticResource PageCanvas}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Automation" />
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Entry points" />
                                    <CheckBox Content="Enable capture links" IsChecked="{Binding ProtocolEnabled}" AutomationProperties.Name="Register the Octadock URL protocol" AutomationProperties.HelpText="Allows octadock capture links to open local capture flows. Other commands are blocked." />
                                    <CheckBox Content="Enable command-line access" IsChecked="{Binding CliEnabled}" AutomationProperties.Name="Enable the Octadock command-line interface" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Example commands" />
                                    <ItemsControl ItemsSource="{Binding AutomationExamples}" Margin="0,8,0,0" AutomationProperties.Name="Automation command examples">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Octadock.Brush.TextSecondary}" FontFamily="Cascadia Mono, Cascadia Code, Consolas" FontSize="12" Margin="0,2" AutomationProperties.Name="Example automation command" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Storage &amp; reset" Tag="advanced" AutomationProperties.Name="Advanced system settings" ToolTip="Storage &amp; reset">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                    <Grid Style="{StaticResource PageCanvas}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Storage &amp; reset" />
                            <Border Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Local storage" />
                                    <TextBlock Style="{StaticResource SectionDescription}" Text="Captures, models and settings stay in %LOCALAPPDATA%\Octadock. Logs are in its Logs folder." />
                                    <Button Content="_Restore all defaults" HorizontalAlignment="Left" Style="{StaticResource Octadock.Style.DangerButton}" Command="{Binding ResetToDefaultsCommand}" AutomationProperties.Name="Restore all settings to defaults" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Margin="0" Padding="22,12" Style="{StaticResource Octadock.Style.DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Octadock.Text.Body}" Foreground="{DynamicResource Octadock.Brush.TextSecondary}" Text="{Binding StatusMessage, TargetNullValue=Changes apply when you save.}" TextWrapping="Wrap" AutomationProperties.Name="Settings status" AutomationProperties.LiveSetting="Polite" FontSize="12" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_Cancel" MinWidth="82" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource Octadock.Style.ToolButton}" Click="OnCloseClick" AutomationProperties.Name="Close settings without saving" />
                    <Button Content="_Save changes" MinWidth="116" IsDefault="True" Style="{StaticResource Octadock.Style.AccentButton}" Command="{Binding SaveCommand}" AutomationProperties.Name="Save settings" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
