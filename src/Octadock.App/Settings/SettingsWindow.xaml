                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Recognition" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Choose the engine, output behavior, and an optional preferred language." />
