<Window x:Class="Octadock.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Octadock.App.Settings"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Octadock Settings"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        Foreground="{DynamicResource Octadock.Brush.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=Tabs}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="Octadock settings">

    <Window.Resources>
        <!-- A keyboard-first recorder surface with a visible tokenized focus ring. -->
        <Style TargetType="local:HotkeyRecorderBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Octadock.Brush.Border}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:HotkeyRecorderBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Octadock.Corner}"
                                Padding="10,0">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding DisplayText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Label}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.SectionHeader}" />

        <Style x:Key="SectionDescription" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
            <Setter Property="Margin" Value="0,4,0,18" />
            <Setter Property="MaxWidth" Value="680" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Title}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="MaxWidth" Value="680" />
        </Style>

        <!-- Quiet, borderless groups keep dense settings scannable without looking boxed-in. -->
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Octadock.Style.SectionCard}">
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.Surface.Raised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.CardDense}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="LocalNotice" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Pill}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CloudNotice" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.CloudSoft}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Octadock.Corner.Pill}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,28" />
        </Style>

        <Style x:Key="SettingsPageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <Style x:Key="PageCanvas" TargetType="Grid">
            <Setter Property="MaxWidth" Value="700" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="32,26,32,30" />
        </Style>

        <!-- A calm, labeled navigation rail makes every category visible without tooltip hunting. -->
        <Style x:Key="PrimaryTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="164" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Octadock.Corner.Row}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3" Height="20"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Background="{DynamicResource Octadock.Brush.Accent}"
                                        Visibility="Hidden" />
                                <icons:PackIconLucide x:Name="Icon"
                                                     Kind="Camera"
                                                     Width="{StaticResource Octadock.Icon.Size.20}"
                                                     Height="{StaticResource Octadock.Icon.Size.20}"
                                                     HorizontalAlignment="Left"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Margin="46,0,12,0"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="section-capture">
                                <Setter TargetName="Icon" Property="Kind" Value="Camera" />
                            </Trigger>
                            <Trigger Property="Tag" Value="speech">
                                <Setter TargetName="Icon" Property="Kind" Value="Mic" />
                            </Trigger>
                            <Trigger Property="Tag" Value="section-library">
                                <Setter TargetName="Icon" Property="Kind" Value="LibraryBig" />
                            </Trigger>
                            <Trigger Property="Tag" Value="section-system">
                                <Setter TargetName="Icon" Property="Kind" Value="Settings2" />
                            </Trigger>
                            <Trigger Property="Tag" Value="account">
                                <Setter TargetName="Icon" Property="Kind" Value="KeyRound" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.AccentSoft}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryTabControlStyle" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.WindowBackdrop}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PrimaryTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{DynamicResource Octadock.Brush.WindowBackdrop}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="184" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Octadock.Brush.GlassRail}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="76" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="18,0,14,0"
                                                VerticalAlignment="Center">
                                        <Border Width="38" Height="38"
                                                Background="{DynamicResource Octadock.Brush.Surface.Raised}"
                                                CornerRadius="{StaticResource Octadock.Corner.CardDense}">
                                            <Image Width="23" Height="23"
                                                   Source="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Octadock"
                                                       Style="{StaticResource Octadock.Text.Subtitle}" />
                                            <TextBlock Text="Settings"
                                                       Style="{StaticResource Octadock.Text.Micro}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <TabPanel x:Name="HeaderPanel"
                                                  IsItemsHost="True"
                                                  KeyboardNavigation.TabNavigation="Cycle"
                                                  KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A short horizontal subnav; there is no second sidebar. -->
        <Style x:Key="SecondaryTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Octadock.Corner.Row}"
                                Padding="12,5">
                            <Grid>
                                <ContentPresenter
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Octadock.Brush.Surface.Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Octadock.Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Octadock.Brush.FocusRing}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryTabControlStyle" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource Octadock.Brush.WindowBackdrop}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SecondaryTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{DynamicResource Octadock.Brush.WindowBackdrop}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
                                    BorderThickness="0">
                                    <ScrollViewer Margin="22,9"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Focusable="False">
                                        <TabPanel x:Name="HeaderPanel"
                                                  IsItemsHost="True"
                                                  KeyboardNavigation.TabNavigation="Cycle"
                                                  KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource Octadock.Style.CheckBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource Octadock.Style.ComboBox}">
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Octadock.Style.TextBox}" />
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs"
                    Grid.Row="0"
                    Style="{StaticResource PrimaryTabControlStyle}"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="Settings categories">

            <!-- ===================== Capture ===================== -->
            <TabItem Header="_Capture"
                     Tag="section-capture"
                     ToolTip="Capture"
                     AutomationProperties.Name="Capture settings">
                <TabControl Style="{StaticResource SecondaryTabControlStyle}"
                            AutomationProperties.Name="Capture sections">
                    <TabItem Header="_Screenshots"
                             Tag="capture"
                             AutomationProperties.Name="Screenshot settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Screenshots" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Everyday capture options live under Basic; naming, sizing, and stitching controls live under Advanced." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Basic" />
                                    <TextBlock Style="{StaticResource SectionDescription}"
                                               Text="Where captures go, the image format, and what selection feels like." />

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Output" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Decide what happens immediately after a capture and where saved files land." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Default post-capture action" />
                                                <ComboBox ItemsSource="{Binding ActionOptions}"
                                                          SelectedItem="{Binding DefaultAction}"
                                                          AutomationProperties.Name="Default post-capture action" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="Save folder" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding SaveDirectory}"
                                                             AutomationProperties.Name="Save folder"
                                                             AutomationProperties.HelpText="Leave blank to choose a folder each time." />
                                                    <Button Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            MinWidth="88"
                                                            Content="_Browse…"
                                                            Style="{StaticResource Octadock.Style.ToolButton}"
                                                            Click="OnBrowseSaveDirectory"
                                                            AutomationProperties.Name="Browse for save folder" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           Text="Leave blank to choose a folder each time." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Image" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Set the file type for saved screenshots and whether the cursor is captured." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Format" />
                                                <ComboBox ItemsSource="{Binding ImageFormatOptions}"
                                                          SelectedItem="{Binding ImageFormat}"
                                                          AutomationProperties.Name="Image format" />
                                            </StackPanel>
                                            <CheckBox Content="Include the mouse cursor"
                                                      IsChecked="{Binding IncludeCursor}"
                                                      AutomationProperties.Name="Include the mouse cursor in screenshots" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Selection" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Control what the area-selection overlay shows while you drag." />
                                            <CheckBox Content="Freeze the screen while selecting"
                                                      IsChecked="{Binding FreezeScreen}"
                                                      AutomationProperties.Name="Freeze the screen while selecting"
                                                      AutomationProperties.HelpText="Captures a still frame of the desktop up front so moving content does not shift under the selection." />
                                            <CheckBox Content="Show precision aids while selecting"
                                                      IsChecked="{Binding PrecisionAids}"
                                                      AutomationProperties.Name="Show precision aids while selecting"
                                                      AutomationProperties.HelpText="Shows the live selection dimensions and the magnifier loupe during area selection." />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Advanced" />
                                    <TextBlock Style="{StaticResource SectionDescription}"
                                               Text="Naming, compression, monitor, sizing, and stitching controls for experienced users." />

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Naming and compression" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Name saved files and tune JPEG compression." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Filename template" />
                                                <TextBox Text="{Binding FilenameTemplate}"
                                                         AutomationProperties.Name="Filename template" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           Text="Tokens: {yyyy} {MM} {dd} {HH} {mm} {ss} {process} {window} {type} {counter}" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}" Margin="0">
                                                <TextBlock Style="{StaticResource Label}" Text="JPEG quality" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding JpegQuality}"
                                                         AutomationProperties.Name="JPEG quality from 1 to 100" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Capture behavior" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Fine-tune monitor, timer, and window-chrome behavior." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Multi-monitor fullscreen" />
                                                <ComboBox ItemsSource="{Binding MultiMonitorOptions}"
                                                          SelectedItem="{Binding MultiMonitorMode}"
                                                          AutomationProperties.Name="Multi-monitor fullscreen mode" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Self-timer" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding SelfTimerSeconds}"
                                                         AutomationProperties.Name="Self-timer seconds" />
                                            </StackPanel>
                                            <CheckBox Content="Include the window shadow and frame"
                                                      IsChecked="{Binding WindowShadow}"
                                                      AutomationProperties.Name="Include the window shadow and frame" />
                                            <CheckBox Content="Include Octadock overlays in screen captures and desktop recordings"
                                                      IsChecked="{Binding IncludeOctadockInScreenshotsAndRecordings}"
                                                      AutomationProperties.Name="Include Octadock overlays in screen captures and desktop recordings"
                                                      AutomationProperties.HelpText="When enabled, the Dock, Shelf, and status pills remain visible in area or full-screen captures and supported desktop recordings. Window-only captures still contain only the selected app." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Size and ratio" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Constrain area selection to an exact size or a repeated shape." />
                                            <CheckBox Content="Use a fixed selection size"
                                                      IsChecked="{Binding FixedSizeEnabled}"
                                                      AutomationProperties.Name="Use a fixed selection size"
                                                      AutomationProperties.HelpText="Area selection places a rectangle of exactly this size; click to position it, Enter to capture." />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBox Width="90"
                                                         Text="{Binding FixedWidth}"
                                                         AutomationProperties.Name="Fixed selection width in pixels" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center"
                                                           Text="×" />
                                                <TextBox Width="90"
                                                         Text="{Binding FixedHeight}"
                                                         AutomationProperties.Name="Fixed selection height in pixels" />
                                                <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="pixels" />
                                            </StackPanel>
                                            <CheckBox Content="Lock the selection aspect ratio"
                                                      Margin="0,10,0,0"
                                                      IsChecked="{Binding LockAspectRatio}"
                                                      AutomationProperties.Name="Lock the selection aspect ratio"
                                                      AutomationProperties.HelpText="New area selections keep the width-to-height ratio of the previous selection." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Scrolling capture (Beta)" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Scrolling capture stitches one tall image while you scroll the target yourself. Beta: manual vertical scrolling only — no automatic scrolling and no horizontal mode yet." />
                                            <TextBlock Style="{StaticResource Octadock.Text.Caption}"
                                                       TextWrapping="Wrap"
                                                       Text="After you select the viewport, scroll the page; the session pill shows the stitched height and its Finish button completes the capture." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Recording"
                             Tag="recording"
                             AutomationProperties.Name="Recording settings">
                        <ScrollViewer Style="{StaticResource SettingsPageScroll}">
                            <Grid Style="{StaticResource PageCanvas}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Recording" />
                                    <TextBlock Style="{StaticResource PageIntro}"
                                               Text="Configure MP4 screen recording quality and capture behavior." />
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="Screen recording" />
                                            <TextBlock Style="{StaticResource SectionDescription}"
                                                       Text="Frame rate and quality apply to new recordings." />
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Frames per second" />
                                                <TextBox Width="120"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding RecordingFps}"
                                                         AutomationProperties.Name="Recording frames per second" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Field}">
                                                <TextBlock Style="{StaticResource Label}" Text="Quality" />
                                                <ComboBox ItemsSource="{Binding RecordingQualityOptions}"
                                                          SelectedItem="{Binding RecordingQuality}"
                                                          AutomationProperties.Name="Recording quality" />
                                            </StackPanel>
                                            <CheckBox Content="Include the mouse cursor"
                                                      IsChecked="{Binding RecordingIncludeCursor}"
                                                      AutomationProperties.Name="Include the mouse cursor in recordings" />
                                            <CheckBox Content="Microphone audio (Beta)"
                                                      IsChecked="{Binding RecordingIncludeMicrophone}"
                                                      AutomationProperties.Name="Include microphone audio in recordings (Beta)"
                                                      AutomationProperties.HelpText="Adds a microphone track to new MP4 recordings. Requires microphone access for desktop apps in Windows privacy settings." />
                                            <CheckBox Content="System audio (Beta)"
                                                      IsChecked="{Binding RecordingIncludeSystemAudio}"
                                                      AutomationProperties.Name="Include system audio in recordings (Beta)"
