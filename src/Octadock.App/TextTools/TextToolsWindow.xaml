<Window x:Class="Octadock.App.TextTools.TextToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Octadock Text Tools"
        Width="860"
        Height="620"
        MinWidth="620"
        MinHeight="420"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <CollectionViewSource x:Key="GroupedTransforms" Source="{Binding Transforms}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Transform picker ============ -->
        <Border Grid.Column="0"
                Padding="0"
                Margin="0,0,12,0"
                Style="{StaticResource Octadock.Style.SectionCard}">

            <ListBox Style="{StaticResource Octadock.Style.ListBox}"
                     AutomationProperties.Name="Text transformations"
                     Padding="6"
                     ItemsSource="{Binding Source={StaticResource GroupedTransforms}}"
                     SelectedItem="{Binding SelectedTransform}">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource Octadock.Text.Muted}"
                                           FontSize="{StaticResource Octadock.FontSize.Micro}"
                                           FontWeight="SemiBold"
                                           Margin="6,10,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource Octadock.Text.Body}"
                                   ToolTip="{Binding Description}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

        <!-- ============ Input / output panes ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedTransform.Name}"
                               Style="{StaticResource Octadock.Text.Subtitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedTransform.Description}"
                               Style="{StaticResource Octadock.Text.Muted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Octadock.Style.ToolButton}"
                            Content="Paste input"
                            Command="{Binding PasteInputCommand}" />
                    <Button Style="{StaticResource Octadock.Style.ToolButton}"
                            Content="Clear"
                            Margin="6,0,0,0"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>

            <!-- Input -->
            <TextBox Grid.Row="1"
                     AutomationProperties.Name="Input text"
                     Style="{StaticResource Octadock.Style.TextBox}"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="{StaticResource Octadock.FontSize.Caption}"
                     VerticalContentAlignment="Top" />

            <!-- Middle bar -->
            <Grid Grid.Row="2" Margin="0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Result"
                               Style="{StaticResource Octadock.Text.Muted}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{DynamicResource Octadock.Brush.Danger}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Octadock.Style.ToolButton}"
                            Content="Use as input ↑"
                            Command="{Binding UseOutputAsInputCommand}" />
                    <Button Style="{StaticResource Octadock.Style.AccentButton}"
                            Content="Copy result"
                            Margin="6,0,0,0"
                            Command="{Binding CopyOutputCommand}" />
                </StackPanel>
            </Grid>

            <!-- Output -->
            <Grid Grid.Row="3">
                <TextBox
                     AutomationProperties.Name="Transformed output"
                     Style="{StaticResource Octadock.Style.TextBox}"
                     Text="{Binding OutputText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="{StaticResource Octadock.FontSize.Caption}"
                     VerticalContentAlignment="Top" />
            <TextBlock Margin="14,10,14,0"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Text="The result appears here as you type">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Octadock.Text.Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OutputText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OutputText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
