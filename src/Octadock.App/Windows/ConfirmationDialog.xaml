<Window x:Class="Octadock.App.Windows.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Confirm action"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ShowActivated="True"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Octadock confirmation"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <!-- Shared explicit-choice surface. The safe answer is always focused/default;
         primary and destructive actions always use concrete verbs. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,24,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ToneBadge"
                    Grid.Row="0"
                    Width="40"
                    Height="40"
                    CornerRadius="{StaticResource Octadock.Corner.CardDense}"
                    Background="{DynamicResource Octadock.Brush.AccentPill}">
                <icons:PackIconLucide x:Name="ToneIcon"
                                      Kind="CircleQuestionMark"
                                      Width="{StaticResource Octadock.Icon.Size.20}"
                                      Height="{StaticResource Octadock.Icon.Size.20}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Octadock.Brush.Accent}" />
            </Border>
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Octadock.Text.Section}" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="14,10,0,0"
                       Style="{StaticResource Octadock.Text.Body}"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="1"
                Padding="26,14"
                Style="{StaticResource Octadock.Style.DialogFooter}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource Octadock.Style.Button}"
                        AutomationProperties.Name="Cancel"
                        Content="Cancel" />
                <Button x:Name="SecondaryButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Style="{StaticResource Octadock.Style.DangerButton}"
                        AutomationProperties.Name="Discard"
                        Content="Discard"
                        Click="OnSecondaryClick" />
                <Button x:Name="PrimaryButton"
                        MinWidth="112"
                        Style="{StaticResource Octadock.Style.AccentButton}"
                        AutomationProperties.Name="Confirm"
                        Content="Confirm"
                        Click="OnPrimaryClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
