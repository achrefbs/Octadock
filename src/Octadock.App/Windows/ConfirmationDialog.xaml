<Window x:Class="Octadock.App.Windows.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="Confirm action"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Octadock;component/Resources/Icons/octadock.ico"
        Background="{DynamicResource Octadock.Brush.WindowBackdrop}"
        FontFamily="{DynamicResource Octadock.Font}"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <!-- The one themed destructive-action confirmation: standard-window family,
         safe answer focused by default, explicit verb on the danger button. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Width="36"
                    Height="36"
                    CornerRadius="{StaticResource Octadock.Corner.CardDense}"
                    Background="{DynamicResource Octadock.Brush.DangerSoft}">
                <icons:PackIconLucide Kind="TriangleAlert"
                                      Width="{StaticResource Octadock.Icon.Size.20}"
                                      Height="{StaticResource Octadock.Icon.Size.20}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Octadock.Brush.Danger}" />
            </Border>
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Octadock.Text.Section}" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="12,10,0,0"
                       Style="{StaticResource Octadock.Text.Muted}"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Octadock.Style.DialogFooter}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource Octadock.Style.Button}"
                        Content="Cancel" />
                <Button x:Name="ConfirmButton"
                        MinWidth="112"
                        Style="{StaticResource Octadock.Style.DangerButton.Filled}"
                        Content="Confirm"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
