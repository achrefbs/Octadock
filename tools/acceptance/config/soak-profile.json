{
  "schemaVersion": 1,
  "gate": "C-07",
  "profile": "phase1-core",
  "completionBlockers": [],
  "requiredIsolation": "separate_windows_profile",
  "workflows": [
    {
      "id": "capture",
      "iterations": 50,
      "artifactKind": "image",
      "requiresProbe": true
    },
    {
      "id": "scrolling",
      "iterations": 10,
      "artifactKind": "image",
      "requiresProbe": true
    },
    {
      "id": "dictation",
      "iterations": 1,
      "artifactKind": "text",
      "requiresProbe": true
    }
  ],
  "provisionalResourceGuardrails": {
    "privateBytesGrowth": 268435456,
    "workingSetBytesGrowth": 268435456,
    "handleGrowth": 100,
    "gdiObjectGrowth": 50,
    "userObjectGrowth": 50
  },
  "manualChecks": [
    {
      "id": "artifact-integrity-review",
      "procedure": "Review sampled capture/scroll images, dictation transcript correlation, probe logs, resource trends, and database integrity output; reference hashes or report paths in the evidence document."
    }
  ]
}
