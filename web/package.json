{
  "name": "octadock-website-validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "npm run validate:syntax && npm run validate:contracts && npm run validate:browser",
    "validate:syntax": "node tests/check-javascript.mjs",
    "validate:contracts": "node --test tests/static-contracts.test.mjs",
    "validate:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "parse5": "8.0.1"
  }
}
